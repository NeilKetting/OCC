<infra:ListViewBase x:Class="OCC.WpfClient.Features.SubContractorHub.Views.SnagListView"
                IsDrawerOpen="{Binding IsOverlayActive}"
                OverlayContent="{Binding OverlayViewModel}"
                DrawerWidth="550"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:vm="clr-namespace:OCC.WpfClient.Features.SubContractorHub.ViewModels"
              xmlns:local="clr-namespace:OCC.WpfClient.Features.SubContractorHub.Views"
              xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
              xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
              xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
              mc:Ignorable="d" 
              d:DesignHeight="800" d:DesignWidth="1200"
              d:DataContext="{d:DesignInstance Type=vm:SnagListViewModel}">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:SnagDetailViewModel}">
            <local:SnagDetailView />
        </DataTemplate>
        <conv:StatusToColorConverter x:Key="StatusToColorConverter" />
        <conv:VisibilityConverter x:Key="VisibilityConverter" />
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </UserControl.Resources>

    <Grid Margin="0" Background="{StaticResource AppBackground}">
        <!-- Main Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header -->
                <RowDefinition Height="Auto" /> <!-- Filters -->
                <RowDefinition Height="*" />    <!-- List -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="20,10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Snag Management" FontSize="28" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                    <TextBlock Text="Track and resolve post-completion quality issues." Style="{StaticResource FormLabelText}"/>
                </StackPanel>
            </Grid>

            <!-- Filters Bar -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="20,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══════════════════ QUICKBOOKS TOOLBAR ══════════════════ -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding LoadDataCommand}" ToolTip="Refresh Data">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Refresh" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Record Snag Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding AddSnagCommand}" ToolTip="Record Snag">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Record Snag" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Print Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding PrintCommand}" ToolTip="Print Report">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SecondaryGold}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Print" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Columns Button -->
                            <Button x:Name="ColumnsButton" Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding ToggleColumnPickerCommand}" ToolTip="Show/Hide Columns">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE136;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Columns" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Column Picker Popup -->
                            <Popup IsOpen="{Binding IsColumnPickerOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=ColumnsButton}" HorizontalOffset="-60" VerticalOffset="5">
                                <Border Background="{StaticResource BackgroundDark}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="Toggle Columns" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <CheckBox Content="Status" IsChecked="{Binding IsStatusVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Partner" IsChecked="{Binding IsPartnerVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Project" IsChecked="{Binding IsProjectVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Due Date" IsChecked="{Binding IsDueDateVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <!-- Search & Filter Controls -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" Width="200" ap:WatermarkProperties.Watermark="Search snags..."/>
                        </StackPanel>

                        <!-- Filters -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
                            <ComboBox ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedFilterProject}" DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBox}" MinWidth="120" Height="30"/>
                            <ComboBox ItemsSource="{Binding SubContractors}" SelectedItem="{Binding SelectedFilterSubContractor}" DisplayMemberPath="Name"
                                      Style="{StaticResource ModernComboBox}" MinWidth="120" Height="30" Margin="10,0"/>
                            <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding SelectedStatus}" 
                                      Style="{StaticResource ModernComboBox}" MinWidth="120" Height="30"/>
                        </StackPanel>

                        <!-- Stats -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#20FFFFFF" CornerRadius="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TOTAL: " FontSize="10" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- List View -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="20,0,20,20" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SNAG TITLE" Binding="{Binding Title}" Width="*" FontWeight="SemiBold"/>
                        <DataGridTemplateColumn Header="PARTNER" Width="180" Visibility="{Binding Data.IsPartnerVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{Binding SubContractor.ColorTheme}" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding SubContractor.Name}" Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="PROJECT" Binding="{Binding Project.Name}" Width="150" Foreground="{StaticResource TextSub}" Visibility="{Binding Data.IsProjectVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <DataGridTemplateColumn Header="STATUS" Width="120" Visibility="{Binding Data.IsStatusVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}, ConverterParameter=0.1}" 
                                            BorderBrush="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                            BorderThickness="1" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" Margin="5">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource FriendlyEnumConverter}}" Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="DUE DATE" Binding="{Binding DueDate, StringFormat=d}" Width="100" Visibility="{Binding Data.IsDueDateVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ToolbarIconButton}" Margin="5" Command="{Binding DataContext.EditSnagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Edit">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="ap:CommandProperties.DoubleClickCommand" Value="{Binding DataContext.EditSnagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Loading Overlay -->
            <ContentControl Grid.Row="2" Style="{StaticResource StandardLoadingOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}"/>
        </Grid>
    </Grid>
</infra:ListViewBase>




<UserControl x:Class="OCC.WpfClient.Features.SubContractorHub.Views.SubContractorDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.SubContractorHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="550"
             d:DataContext="{d:DesignInstance Type=vm:SubContractorDetailViewModel}">

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderText}" FontSize="20"/>
                        <TextBlock Text="Manage partner profile and specialties" Style="{StaticResource LabelText}" Opacity="0.7"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource WindowCloseButton}" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0" Padding="0">
                <StackPanel Margin="0,0,20,0">
                    <!-- Section: Partner Info -->
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="&#xE8D7;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Partner Information" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource AccentBlue}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Company Name" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Enter company name..."/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email Address" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="contact@contractor.com"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Phone Number" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="+27 11 . ."/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Branch" Style="{StaticResource FormLabelText}"/>
                                <ComboBox SelectedValue="{Binding Branch}" SelectedValuePath="Content" Style="{StaticResource ModernComboBox}" Height="36">
                                    <ComboBoxItem Content="Johannesburg"/>
                                    <ComboBoxItem Content="Cape Town"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Color" Style="{StaticResource FormLabelText}"/>
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="ColorToggle" Style="{StaticResource ToolbarToggleButton}" Padding="0">
                                        <Border Width="36" Height="36" CornerRadius="4" Background="{Binding ColorTheme}" BorderThickness="1" BorderBrush="#33FFFFFF">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="10" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,2,2" Opacity="0.5"/>
                                        </Border>
                                    </ToggleButton>

                                    <Popup IsOpen="{Binding IsChecked, ElementName=ColorToggle}" PlacementTarget="{Binding ElementName=ColorToggle}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{StaticResource BackgroundDarker}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,5,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Select Palette" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSub}" Margin="0,0,0,10"/>
                                                <ListBox ItemsSource="{Binding PredefinedColors}" SelectedItem="{Binding ColorTheme}" Background="Transparent" BorderThickness="0">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Width="160"/>
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Width="30" Height="30" CornerRadius="4" Background="{Binding}" Margin="4" Cursor="Hand" ToolTip="{Binding}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="BorderThickness" Value="2"/>
                                                                                <Setter Property="BorderBrush" Value="White"/>
                                                                            </Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <ContentPresenter/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                                
                                                <Border BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0" Margin="0,10,0,10"/>
                                                
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Text="{Binding ColorTheme, UpdateSourceTrigger=PropertyChanged}" Width="100" Style="{StaticResource ModernInput}" FontSize="11" Height="28"/>
                                                    <Border Width="28" Height="28" Background="{Binding ColorTheme}" CornerRadius="4" Margin="10,0,0,0" BorderThickness="1" BorderBrush="#33FFFFFF"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        
                        <StackPanel Margin="0,12,0,0">
                             <TextBlock Text="Headquarters Address" Style="{StaticResource FormLabelText}"/>
                             <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" MinHeight="80" Height="Auto" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" ap:WatermarkProperties.Watermark="Business address..."/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Mobile Portal Access -->
                    <Border Background="#106180FF" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="0,0,0,25">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="16" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MOBILE PORTAL ACCESS" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                            </StackPanel>
                            
                            <CheckBox Content="Enable Mobile Access" IsChecked="{Binding HasPortalAccess}" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                            
                            <StackPanel Visibility="{Binding HasPortalAccess, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="LINKED ACCOUNT" Style="{StaticResource FormLabelText}" Opacity="0.7"/>
                                <TextBlock Text="{Binding LinkedUserName}" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,15"/>
                                
                                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="TEMPORARY PASSWORD" Style="{StaticResource FormLabelText}"/>
                                    <TextBox Text="{Binding PortalPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Temporary password..."/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Specialties -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Construction Specialties" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource SuccessGreen}"/>
                        </StackPanel>

                        <Border Background="#05FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="8" Padding="10">
                            <ItemsControl ItemsSource="{Binding SpecialtyOptions}" BorderThickness="0" Background="Transparent">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsChecked}" Content="{Binding Name}" Foreground="White" Margin="0,4" Style="{StaticResource ModernCheckBox}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Validation Summary -->
                    <Border Margin="0,0,0,15" Background="#1AEE4444" BorderBrush="{StaticResource ErrorRed}" 
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasErrors, Converter={StaticResource VisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorRed}" FontSize="12" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="0,0,8,0"/>
                        <Button Content="Save Partner" Style="{StaticResource ActionButtonPrimary}" Command="{Binding SaveCommand}" Width="140" Height="40"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#CC000000" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

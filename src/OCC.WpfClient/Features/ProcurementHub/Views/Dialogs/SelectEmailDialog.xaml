<UserControl x:Class="OCC.WpfClient.Features.ProcurementHub.Views.Dialogs.SelectEmailDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dialogVm="clr-namespace:OCC.WpfClient.Features.ProcurementHub.ViewModels.Dialogs"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="380" d:DesignWidth="450">
    <UserControl.Resources>
        <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
    </UserControl.Resources>

    <Grid Background="#CC0F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Style="{StaticResource GlassCard}" Width="450" Padding="24" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
            <StackPanel>
                <!-- Title Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE715;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SecondaryGold}" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="SELECT RECIPIENT EMAIL" Style="{StaticResource HeaderText}" FontSize="16" FontFamily="{StaticResource MichromaFont}" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding SupplierName, StringFormat='Supplier: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,12"/>
                <TextBlock Text="Multiple email addresses were found. Please select which address(es) to send the Purchase Order to:" 
                           FontSize="12" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- List of Emails with Checkboxes -->
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <ItemsControl ItemsSource="{Binding EmailOptions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type dialogVm:EmailOptionItemViewModel}">
                                <Border Background="#10FFFFFF" CornerRadius="6" Padding="10,8" Margin="0,0,0,6" BorderBrush="#20FFFFFF" BorderThickness="1">
                                    <CheckBox Content="{Binding Email}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Foreground="White" FontSize="13"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Additional / Custom Email field -->
                <TextBlock Text="Additional Email (Optional):" Style="{StaticResource CompactLabel}" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding CustomEmail, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="custom@supplier.com" Margin="0,0,0,20"/>

                <!-- Action Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Send Email" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Width="120"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.ProcurementHub.Views.PurchaseOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProcurementHub.ViewModels"
             xmlns:view="clr-namespace:OCC.WpfClient.Features.ProcurementHub.Views"
             xmlns:dialogs="clr-namespace:OCC.WpfClient.Features.ProcurementHub.Views.Dialogs"
             xmlns:dialogVm="clr-namespace:OCC.WpfClient.Features.ProcurementHub.ViewModels.Dialogs"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseOrderDetailViewModel}">
    
    <UserControl.Resources>
        <!-- Icons -->
        <Geometry x:Key="IconChevronLeft">M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z</Geometry>
        <Geometry x:Key="IconChevronRight">M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z</Geometry>
        <Geometry x:Key="IconEnvelope">M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6A2,2 0 0,0 20,4M20,18H4V8L12,13L20,8V18M20,6L12,11L4,6V6H20V6Z</Geometry>
        <Geometry x:Key="IconTrash">M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19V4M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z</Geometry>
        <Geometry x:Key="IconSearch">M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z</Geometry>
        <Geometry x:Key="IconLiveView">M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z</Geometry>
        <Geometry x:Key="IconPrint">M18,3H6V7H18M19,12A1,1 0 0,1 18,11A1,1 0 0,1 19,10A1,1 0 0,1 20,11A1,1 0 0,1 19,12M16,19H8V14H16M19,8H5A3,3 0 0,0 2,11V17H6V21H18V17H22V11A3,3 0 0,0 19,8Z</Geometry>
        <Geometry x:Key="IconClose">M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z</Geometry>

        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        
        <!-- QuickBooks style: Invisible when empty, shows on hover/focus -->
        <Style x:Key="QuickBooksComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource CompactComboBox}">
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="4,0,0,0"/>
            <Setter Property="ap:CommandProperties.HideArrow" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ArrowColumn" Width="0" />
                            </Grid.ColumnDefinitions>
                            
                            <ToggleButton x:Name="toggleButton"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Background="{TemplateBinding Background}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="templateRoot"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="0">
                                            <Grid x:Name="splitBorder">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition x:Name="ArrowCol" Width="0" />
                                                </Grid.ColumnDefinitions>
                                                <Path x:Name="Arrow"
                                                      Grid.Column="1"
                                                      Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="{StaticResource TextSub}"
                                                      StrokeThickness="2"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                    <Condition Binding="{Binding Path=(ap:CommandProperties.HideArrow), RelativeSource={RelativeSource AncestorType=ComboBox}}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ArrowCol" Property="Width" Value="25" />
                                            </MultiDataTrigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ArrowCol" Property="Width" Value="25" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            
                            <ContentPresenter x:Name="contentPresenter"
                                              Grid.Column="0"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              IsHitTestVisible="False" />

                            <TextBox x:Name="PART_EditableTextBox"
                                     Grid.Column="0"
                                     Style="{x:Null}"
                                     Margin="{TemplateBinding Padding}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Collapsed"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="White"
                                     CaretBrush="White">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border" Background="Transparent">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <Popup x:Name="PART_Popup"
                                   Grid.ColumnSpan="2"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border x:Name="DropDownBorder"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource GlassBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="contentPresenter" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ArrowColumn" Property="Width" Value="25" />
                                <Setter Property="ap:CommandProperties.HideArrow" Value="False"/>
                                <Setter Property="Background" Value="{StaticResource InputBackground}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ArrowColumn" Property="Width" Value="25" />
                                <Setter Property="ap:CommandProperties.HideArrow" Value="False"/>
                                <Setter Property="Background" Value="{StaticResource InputBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- QuickBooks Toolbar Button Style (Vertical Layout) -->
        <Style x:Key="QuickBooksToolbarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <Grid VerticalAlignment="Center">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,0,2">
                                        <Path x:Name="iconPath" 
                                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" 
                                              Stretch="Uniform"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Fill="{TemplateBinding Foreground}"/>
                                    </Viewbox>
                                    <TextBlock x:Name="textBlock" 
                                               Text="{TemplateBinding Content}" 
                                               FontSize="9" 
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               Opacity="0.8"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1AFFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#33FFFFFF"/>
                                <Setter TargetName="textBlock" Property="Opacity" Value="1"/>
                                <Setter TargetName="iconPath" Property="Fill" Value="{StaticResource AccentBlue}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#33FFFFFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- QuickBooks Bottom Action Button Style -->
        <Style x:Key="QuickBooksActionButtonStyle" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#F8F9FA" Offset="0"/>
                        <GradientStop Color="#E9ECEF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#33475B"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#FFFFFF" Offset="0"/>
                                <GradientStop Color="#F1F3F5" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="BorderBrush" Value="#ADB5BD"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#DEE2E6"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QuickBooksPrimaryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource QuickBooksActionButtonStyle}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#49A8FF" Offset="0"/>
                        <GradientStop Color="#2E9DFF" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1E80D6"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                <GradientStop Color="#5FB8FF" Offset="0"/>
                                <GradientStop Color="#49AEFF" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1E80D6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Compact Add Line Button Style -->
        <Style x:Key="CompactAddLineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A2E9DFF"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#332E9DFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlueHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4D2E9DFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dialog Templates -->
        <DataTemplate DataType="{x:Type dialogVm:ItemNotFoundViewModel}">
            <dialogs:ItemNotFoundDialog />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dialogVm:NewItemViewModel}">
            <dialogs:NewItemDialog />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dialogVm:FindOrderViewModel}">
            <dialogs:FindOrderDialog />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dialogVm:SelectEmailViewModel}">
            <dialogs:SelectEmailDialog />
        </DataTemplate>
        <DataTemplate DataType="{x:Type dialogVm:AddSupplierContactViewModel}">
            <dialogs:AddSupplierContactDialog />
        </DataTemplate>
    </UserControl.Resources>
    
    <Grid Background="{StaticResource BackgroundDark}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Top Toolbar -->
                <RowDefinition Height="Auto"/> <!-- Compact Header -->
                <RowDefinition Height="*"/>    <!-- Items Grid -->
                <RowDefinition Height="Auto"/> <!-- Add Line Button -->
                <RowDefinition Height="Auto"/> <!-- Footer: Totals & Save -->
            </Grid.RowDefinitions>

            <!-- 1. Top Toolbar (QuickBooks Style) -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="5,2" Margin="0,0,0,5" CornerRadius="10,10,0,0" BorderThickness="1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <!-- Navigation Group -->
                        <Button Content="BACK" Command="{Binding PreviousOrderCommand}" 
                                Style="{StaticResource QuickBooksToolbarButtonStyle}" Tag="{StaticResource IconChevronLeft}" />
                        <Button Content="NEXT" Command="{Binding NextOrderCommand}" 
                                Style="{StaticResource QuickBooksToolbarButtonStyle}" Tag="{StaticResource IconChevronRight}"/>
                        <Button Content="FIND" Command="{Binding FindOrderCommand}" 
                                Style="{StaticResource QuickBooksToolbarButtonStyle}" Tag="{StaticResource IconSearch}"/>

                        <!-- Actions Group -->
                        <Button Content="PREVIEW" Command="{Binding PreviewOrderCommand}"
                                Style="{StaticResource QuickBooksToolbarButtonStyle}" Tag="{StaticResource IconLiveView}"/>
                        <Button Content="PRINT" Command="{Binding PrintOrderCommand}"
                                Style="{StaticResource QuickBooksToolbarButtonStyle}" Tag="{StaticResource IconPrint}"/>
                        <Button Content="EMAIL" Command="{Binding EmailOrderCommand}"
                                Style="{StaticResource QuickBooksToolbarButtonStyle}" Tag="{StaticResource IconEnvelope}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="DELETE" Command="{Binding DeleteOrderCommand}" 
                                Style="{StaticResource QuickBooksToolbarButtonStyle}" Tag="{StaticResource IconTrash}" Foreground="{StaticResource ErrorRed}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Compact Header -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" CornerRadius="10,10,0,0" BorderThickness="1" Padding="12" Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Col 1: Supplier & Project -->
                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                        <TextBlock Text="SUPPLIER" Style="{StaticResource CompactLabel}" Foreground="{StaticResource AccentBlue}"/>
                        <ComboBox x:Name="SupplierComboBox"
                                  ItemsSource="{Binding Suppliers}" 
                                  SelectedItem="{Binding SelectedSupplier}"
                                  Text="{Binding CurrentOrder.SupplierName, UpdateSourceTrigger=PropertyChanged}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource CompactComboBox}"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  ap:CommandProperties.IsFiltered="True"
                                  ap:WatermarkProperties.Watermark="Select Supplier..."/>
                        
                        <!-- Fade-in Popup for Supplier Information on Hover -->
                        <Popup x:Name="SupplierInfoPopup"
                               PlacementTarget="{Binding ElementName=SupplierComboBox}"
                               Placement="Right"
                               AllowsTransparency="True"
                               PopupAnimation="Fade"
                               HorizontalOffset="-2"
                               VerticalOffset="0">
                            <Popup.Style>
                                <Style TargetType="Popup">
                                    <Setter Property="IsOpen" Value="False"/>
                                     <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=SupplierComboBox, Path=IsMouseOver}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=SupplierComboBox, Path=IsDropDownOpen}" Value="False"/>
                                                <Condition Binding="{Binding SelectedSupplier, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsOpen" Value="True"/>
                                        </MultiDataTrigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding ElementName=PopupBorder, Path=IsMouseOver}" Value="True"/>
                                                <Condition Binding="{Binding ElementName=SupplierComboBox, Path=IsDropDownOpen}" Value="False"/>
                                                <Condition Binding="{Binding SelectedSupplier, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}" Value="Visible"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="IsOpen" Value="True"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Popup.Style>
                            
                            <Border x:Name="PopupBorder"
                                    Background="{StaticResource GlassBackgroundVibrant}"
                                    BorderBrush="{StaticResource GlassBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Width="320"
                                    Padding="14"
                                    Margin="5">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="4" Direction="270" Opacity="0.6" Color="Black"/>
                                </Border.Effect>
                                <StackPanel>
                                    <!-- Header: Title and Icon -->
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Path Fill="{StaticResource AccentBlue}" Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M12,6A3,3 0 0,1 15,9A3,3 0 0,1 12,12A3,3 0 0,1 9,9A3,3 0 0,1 12,6M18,18H6V17C6,15 10,13.9 12,13.9C14,13.9 18,15 18,17V18Z"/>
                                        </Viewbox>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedSupplier.Name}" FontWeight="Bold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                    
                                    <Separator Background="#22FFFFFF" Margin="0,0,0,10"/>
                                    
                                    <!-- Contact details -->
                                    <StackPanel Margin="0,0,0,8" Visibility="{Binding SelectedSupplier.ContactPerson, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="CONTACT PERSON" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedSupplier.ContactPerson}" FontSize="11.5" Foreground="White"/>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0" Visibility="{Binding SelectedSupplier.Phone, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="PHONE" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedSupplier.Phone}" FontSize="11.5" Foreground="White"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" Visibility="{Binding SelectedSupplier.Email, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="EMAIL" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedSupplier.Email}" FontSize="11.5" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Address Details -->
                                    <StackPanel Margin="0,0,0,8" Visibility="{Binding SelectedSupplier.Address, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="ADDRESS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedSupplier.Address}" FontSize="11.5" Foreground="White" TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                            <TextBlock Text="{Binding SelectedSupplier.City}" FontSize="11.5" Foreground="White"/>
                                            <TextBlock Text=" " FontSize="11.5" Foreground="White" Visibility="{Binding SelectedSupplier.City, Converter={StaticResource StringToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding SelectedSupplier.PostalCode}" FontSize="11.5" Foreground="White"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Financial details -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,5,0" Visibility="{Binding SelectedSupplier.VatNumber, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="VAT NUMBER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedSupplier.VatNumber}" FontSize="11.5" Foreground="White"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Margin="5,0,0,0" Visibility="{Binding SelectedSupplier.SupplierAccountNumber, Converter={StaticResource StringToVisibilityConverter}}">
                                            <TextBlock Text="ACC NUMBER" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,2"/>
                                            <TextBlock Text="{Binding SelectedSupplier.SupplierAccountNumber}" FontSize="11.5" Foreground="White"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Banking details -->
                                    <StackPanel Margin="0,4,0,0" Visibility="{Binding SelectedSupplier.BankName, Converter={StaticResource StringToVisibilityConverter}}">
                                        <TextBlock Text="BANKING DETAILS" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,4"/>
                                        <Border Background="#10FFFFFF" CornerRadius="4" Padding="8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Bank:" FontSize="11" Foreground="{StaticResource TextSub}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSupplier.BankName}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,3" Visibility="{Binding SelectedSupplier.BankAccountNumber, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Account No:" FontSize="11" Foreground="{StaticResource TextSub}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSupplier.BankAccountNumber}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Visibility="{Binding SelectedSupplier.BranchCode, Converter={StaticResource StringToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="75"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Branch Code:" FontSize="11" Foreground="{StaticResource TextSub}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding SelectedSupplier.BranchCode}" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                        
                        <TextBlock Text="PROJECT" Style="{StaticResource CompactLabel}" Margin="0,8,0,2" Foreground="{StaticResource AccentBlue}"/>
                        <ComboBox ItemsSource="{Binding Projects}" 
                                  SelectedItem="{Binding SelectedProject}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource CompactComboBox}"
                                  ap:WatermarkProperties.Watermark="Link Project..."/>
                        <Grid Visibility="{Binding IsOtherProjectSelected, Converter={StaticResource VisibilityConverter}}" Margin="0,4,0,0">
                            <TextBox x:Name="CustomProjectInputBox"
                                     Text="{Binding CurrentOrder.ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernInput}"
                                     FontSize="12"
                                     ap:WatermarkProperties.Watermark="Enter custom project name..."
                                     GotFocus="CustomProjectInputBox_GotFocus"
                                     LostFocus="CustomProjectInputBox_LostFocus"
                                     TextChanged="CustomProjectInputBox_TextChanged"/>

                            <Popup x:Name="CustomProjectPopup"
                                   IsOpen="{Binding IsCustomProjectSuggestionsOpen, Mode=TwoWay}"
                                   PlacementTarget="{Binding ElementName=CustomProjectInputBox}"
                                   Placement="Bottom"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Slide">
                                <Border Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource GlassBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{Binding ElementName=CustomProjectInputBox, Path=ActualWidth}"
                                        MaxHeight="180"
                                        Margin="0,2,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding CustomProjectSuggestions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="Transparent" Padding="8,6" CornerRadius="4">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#2A3B5C"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid HorizontalAlignment="Stretch">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" 
                                                                       Text="{Binding}" 
                                                                       VerticalAlignment="Center" 
                                                                       Foreground="White" 
                                                                       FontSize="11" 
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Cursor="Hand"
                                                                       PreviewMouseLeftButtonDown="CustomProjectItem_PreviewMouseLeftButtonDown"/>
                                                            <Button Grid.Column="1"
                                                                    Command="{Binding DataContext.RemoveCustomProjectSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="Remove from history"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="4,2"
                                                                    Margin="6,0,0,0"
                                                                    Cursor="Hand"
                                                                    Focusable="False">
                                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#EF4444" FontSize="10" Opacity="0.8"/>
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <!-- Col 2: Delivery Address & SOW -->
                    <StackPanel Grid.Column="1" Margin="0,0,15,0">
                        <Grid>
                            <TextBlock Text="DELIVERY ADDRESS" Style="{StaticResource CompactLabel}" Foreground="{StaticResource AccentBlue}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton Content="Office" IsChecked="{Binding CurrentOrder.IsOfficeSelected}" Foreground="White" FontSize="10" Margin="0,0,10,0"/>
                                <RadioButton Content="Site" IsChecked="{Binding CurrentOrder.IsSiteSelected}" Foreground="White" FontSize="10" Margin="0,0,10,0"/>
                                <RadioButton Content="Other" IsChecked="{Binding CurrentOrder.IsOtherSelected}" Foreground="White" FontSize="10"/>
                            </StackPanel>
                        </Grid>
                        <ComboBox ItemsSource="{Binding Projects}" 
                                  SelectedItem="{Binding SelectedProject}"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource CompactComboBox}"
                                  ap:WatermarkProperties.Watermark="Link Project..."
                                  Visibility="{Binding CurrentOrder.IsSiteSelected, Converter={StaticResource VisibilityConverter}}"/>
                        <TextBox Style="{StaticResource CompactTextBox}" IsEnabled="False" Text="N/A (Office / Stock)" 
                                 Visibility="{Binding CurrentOrder.IsOfficeSelected, Converter={StaticResource VisibilityConverter}}"/>
                        <Grid Visibility="{Binding CurrentOrder.IsOtherSelected, Converter={StaticResource VisibilityConverter}}">
                            <TextBox x:Name="ManualAddressBox" 
                                     Text="{Binding CurrentOrder.DeliveryAddress, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource CompactTextBox}" 
                                     ap:WatermarkProperties.Watermark="Enter manual delivery address..."
                                     ap:FocusProperties.IsFocused="{Binding IsAddressFocused, Mode=TwoWay}"/>
                            <Popup IsOpen="{Binding AddressSuggestions.Count, Converter={StaticResource CollectionToBooleanConverter}, Mode=OneWay}" 
                                   PlacementTarget="{Binding ElementName=ManualAddressBox}" 
                                   StaysOpen="False" 
                                   AllowsTransparency="True">
                                <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="4" Width="300" MaxHeight="200">
                                    <ListBox ItemsSource="{Binding AddressSuggestions}" SelectedItem="{Binding SelectedAddressSuggestion}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" Foreground="White" Padding="8,6" FontSize="11" TextWrapping="Wrap"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>

                        <TextBlock Text="SCOPE OF WORK (SOW)" Style="{StaticResource CompactLabel}" Margin="0,8,0,2"/>
                        <TextBox Text="{Binding CurrentOrder.ScopeOfWork}" Style="{StaticResource CompactTextBox}" ap:WatermarkProperties.Watermark="Brief description..."/>
                    </StackPanel>

                    <!-- Col 3: Dates -->
                    <StackPanel Grid.Column="2" Margin="0,0,15,0">
                        <TextBlock Text="ORDER DATE" Style="{StaticResource CompactLabel}"/>
                        <DatePicker SelectedDate="{Binding CurrentOrder.OrderDate}" Style="{StaticResource CompactDatePicker}"/>

                        <TextBlock Text="EXPECTED DELIVERY" Style="{StaticResource CompactLabel}" Margin="0,8,0,2"/>
                        <DatePicker SelectedDate="{Binding CurrentOrder.ExpectedDeliveryDate}" Style="{StaticResource CompactDatePicker}"/>
                    </StackPanel>

                    <!-- Col 4: PO No & Attention -->
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="P.O. NUMBER" Style="{StaticResource CompactLabel}"/>
                        <TextBox Text="{Binding CurrentOrder.OrderNumber}" 
                                 Style="{StaticResource CompactTextBox}" 
                                 IsReadOnly="{Binding IsNewOrder, Converter={StaticResource InverseBooleanConverter}}" 
                                 FontWeight="Bold" 
                                 Foreground="{StaticResource AccentBlue}"/>
                        
                        <TextBlock Text="ATTENTION / CONTACT" Style="{StaticResource CompactLabel}" Margin="0,8,0,2"/>
                        <TextBox Text="{Binding CurrentOrder.Attention}" Style="{StaticResource CompactTextBox}" ap:WatermarkProperties.Watermark="Recipient name..."/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Items Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="1" BorderThickness="1" CornerRadius="0" Margin="0">
                <DataGrid x:Name="LinesDataGrid"
                          ItemsSource="{Binding CurrentOrder.Lines}" 
                          PreviewKeyDown="DataGrid_PreviewKeyDown"
                          AutoGenerateColumns="False" 
                          Background="Transparent" BorderThickness="0" 
                          CanUserAddRows="False"
                          RowHeaderWidth="0"
                          MinRowHeight="32"
                          GridLinesVisibility="All"
                          HorizontalGridLinesBrush="#33FFFFFF"
                          VerticalGridLinesBrush="#33FFFFFF"
                          AlternatingRowBackground="#0AFFFFFF">
                    <DataGrid.Resources>
                        <Style x:Key="DataGridEditingTextBoxStyle" TargetType="TextBox">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="CaretBrush" Value="White"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <EventSetter Event="GotKeyboardFocus" Handler="TextBox_GotKeyboardFocus"/>
                            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TextBox_PreviewMouseLeftButtonDown"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Border x:Name="border" Background="Transparent">
                                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Background="Transparent" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="ITEM" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.InventoryItems, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Text="{Binding ItemCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsEditable="True"
                                              IsTextSearchEnabled="True"
                                              StaysOpenOnEdit="True"
                                              ap:CommandProperties.IsFiltered="True"
                                              MaxDropDownHeight="300"
                                              Style="{StaticResource QuickBooksComboBoxStyle}"
                                              TextSearch.TextPath="Sku"
                                              SelectedValuePath="Sku"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              HorizontalAlignment="Stretch"
                                              Margin="0"
                                              ap:CommandProperties.LostFocusCommand="{Binding DataContext.ValidateLineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ap:CommandProperties.SelectionChangedCommand="{Binding DataContext.UpdateLineItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              ap:CommandProperties.CommandParameter="{Binding}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="5">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Sku}" FontWeight="SemiBold" Foreground="White" Grid.Column="0"/>
                                                    <TextBlock Text="{Binding Type}" Foreground="{StaticResource TextSub}" Margin="10,0" Grid.Column="1"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSub}" Grid.Column="2" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="DESCRIPTION" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Description}" 
                                               TextWrapping="Wrap" 
                                               VerticalAlignment="Center" 
                                               Foreground="{StaticResource TextSub}"
                                               Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" 
                                             TextWrapping="Wrap" 
                                             AcceptsReturn="True"
                                             VerticalAlignment="Center" 
                                             Foreground="White" 
                                             Background="Transparent" 
                                             BorderThickness="0"
                                             Padding="4,2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="Auto" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}"/>
                        <DataGridTextColumn Header="QTY" Width="60" Binding="{Binding QuantityOrdered, UpdateSourceTrigger=LostFocus}" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItemValid}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="UNIT" Width="Auto" Binding="{Binding UnitOfMeasure}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItemValid}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="UNIT PRICE" Width="Auto" Binding="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat='#,##0.00'}" EditingElementStyle="{StaticResource DataGridEditingTextBoxStyle}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItemValid}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="AMOUNT" Width="Auto" Binding="{Binding LineTotal, StringFormat='N2'}" IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsItemValid}" Value="False">
                                            <Setter Property="Visibility" Value="Hidden"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        
                        <DataGridTemplateColumn Header="DEL" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="×" Background="Transparent" BorderThickness="0" Foreground="#66FFFFFF"
                                            FontSize="16"  Padding="0" FontWeight="Bold"
                                            Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding ItemCode, Converter={StaticResource VisibilityConverter}}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. Add Line Button -->
            <Button Grid.Row="3" Content="+ Add Line" Style="{StaticResource CompactAddLineButtonStyle}" 
                    HorizontalAlignment="Left" Margin="0,6,0,6" Command="{Binding AddLineCommand}"/>

            <!-- 5. Footer: Totals & Actions (Precision Layout) -->
            <Grid Grid.Row="4" Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                    <!-- Left -->
                    <ColumnDefinition Width="*"/>
                    <!-- Right -->
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Memo & Delivery Instructions Section (Left side) -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,30,0">
                    <TextBlock Text="MEMO / INTERNAL REFERENCE" Style="{StaticResource CompactLabel}"/>
                    <TextBox Text="{Binding CurrentOrder.ReferenceNo}" Style="{StaticResource CompactTextBox}" Width="450" HorizontalAlignment="Left" ap:WatermarkProperties.Watermark="Add a note..." Margin="0,0,0,10"/>
                    
                    <TextBlock Text="DELIVERY INSTRUCTIONS" Style="{StaticResource CompactLabel}"/>
                    <TextBox Text="{Binding CurrentOrder.DeliveryInstructions}" 
                             Style="{StaticResource CompactTextBox}" 
                             Width="450" 
                             Height="60"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalAlignment="Left" 
                             ap:WatermarkProperties.Watermark="Special instructions for delivery..."/>
                </StackPanel>

                <!-- Right Side: Totals + Buttons (Vertical Stack) -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                    
                    <!-- Totals Block -->
                    <StackPanel Margin="0,0,0,15">
                        <Grid Width="250" Margin="0,3">
                            <TextBlock Text="SUBTOTAL (EXCL. VAT)" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentOrder.SubTotal, StringFormat='R {0:N2}'}" HorizontalAlignment="Right" Foreground="White" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Width="250" Margin="0,3">
                            <TextBlock Text="VAT (15%)" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentOrder.VatTotal, StringFormat='R {0:N2}'}" HorizontalAlignment="Right" Foreground="White" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Width="250" Margin="0,3">
                            <TextBlock Text="PAYMENTS APPLIED" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                            <TextBlock Text="R 0,00" HorizontalAlignment="Right" Foreground="White"/>
                        </Grid>
                        <Separator Background="#33FFFFFF" Margin="0,8"/>
                        <Grid Width="250">
                            <TextBlock Text="TOTAL (INCL. VAT)" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentOrder.TotalAmount, StringFormat='R {0:N2}'}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>

                    <!-- Buttons Block (Directly below Balance Due) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Save &amp; Receive" Command="{Binding SaveAndReceiveCommand}" 
                                Style="{StaticResource QuickBooksActionButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Save &amp; Close" Command="{Binding SaveOrderCommand}" 
                                Style="{StaticResource QuickBooksActionButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Save &amp; New" Command="{Binding SaveAndNewCommand}" 
                                Style="{StaticResource QuickBooksPrimaryActionButtonStyle}" Margin="0,0,10,0"/>
                        <Button Content="Clear" Command="{Binding ClearOrderCommand}" 
                                Style="{StaticResource QuickBooksActionButtonStyle}" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Loading Overlay -->
        <ContentControl Grid.RowSpan="5" Style="{StaticResource StandardLoadingOverlay}"
                        Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}"/>

        <!-- Modal Dialog Overlay -->
        <ContentControl Grid.RowSpan="5" Content="{Binding OverlayViewModel}" Panel.ZIndex="1000"/>
    </Grid>
</UserControl>






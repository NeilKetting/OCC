<infra:BaseListView x:Class="OCC.WpfClient.Features.ProcurementHub.Views.SupplierListView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProcurementHub.ViewModels"
              xmlns:views="clr-namespace:OCC.WpfClient.Features.ProcurementHub.Views"
              xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
              xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
              xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
              mc:Ignorable="d" 
              d:DesignHeight="800" d:DesignWidth="1200"
              d:DataContext="{d:DesignInstance Type=vm:SupplierViewModel}"
              IsDrawerOpen="{Binding IsOverlayActive}">

    <UserControl.Resources>
        <!-- Drawer Animations -->
        <Storyboard x:Key="OpenDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="600" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BackgroundDimmer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="600" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="BackgroundDimmer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>

        <DataTemplate DataType="{x:Type vm:SupplierDetailViewModel}">
            <views:SupplierDetailView />
        </DataTemplate>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <conv:VisibilityConverter x:Key="VisibilityConverter" />
    </UserControl.Resources>

    <Grid Margin="0" Background="{StaticResource AppBackground}">
        <!-- Main Background Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="15">
                <StackPanel>
                    <TextBlock Text="Supplier Management" Style="{StaticResource HeaderText}" />
                    <TextBlock Text="Manage procurement sources and bank details." Style="{StaticResource LabelText}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddSupplierCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Add Supplier" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Stats & Search Line -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                               Style="{StaticResource ModernInput}" Height="32" Padding="8,0" BorderThickness="0" Background="Transparent"
                               ap:WatermarkProperties.Watermark="Search suppliers..."/>
                    
                    <Border Grid.Column="2" Width="1" Height="20" Background="{StaticResource GlassBorder}" Margin="15,0" VerticalAlignment="Center"/>

                    <!-- Branch Filter -->
                    <ComboBox Grid.Column="3" ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding SelectedBranchFilter}" 
                               Style="{StaticResource ModernComboBox}" Height="30" MinWidth="100"/>

                    <Border Grid.Column="4" Width="1" Height="20" Background="{StaticResource GlassBorder}" Margin="15,0" VerticalAlignment="Center"/>

                    <!-- Columns Selection -->
                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <Grid>
                            <ToggleButton x:Name="ColumnsToggle" Style="{StaticResource ToolbarToggleButton}" Width="100" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0" Opacity="0.8"/>
                                    <TextBlock Text="COLUMNS" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=ColumnsToggle}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,5,0,0" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="DISPLAY COLUMNS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Branch" IsChecked="{Binding IsBranchVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2" Foreground="White"/>
                                        <CheckBox Content="Contact" IsChecked="{Binding IsContactVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2" Foreground="White"/>
                                        <CheckBox Content="Phone" IsChecked="{Binding IsPhoneVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2" Foreground="White"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Print -->
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal" Margin="10,0">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="PRINT" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    
                    <!-- Stats -->
                    <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#20FFFFFF" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="TOTAL: " FontSize="10" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Supplier Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="10,0,10,10" HorizontalAlignment="Stretch" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}" 
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" 
                          IsReadOnly="True"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="Auto" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="Auto" Foreground="{StaticResource TextSub}" Visibility="{Binding Data.IsBranchVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <DataGridTextColumn Header="CONTACT" Binding="{Binding ContactPerson}" Width="Auto" Foreground="{StaticResource TextSub}" Visibility="{Binding Data.IsContactVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="Auto" Visibility="{Binding Data.IsPhoneVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>

                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Edit">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="14"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Delete">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ap:CommandProperties.DoubleClickCommand" 
                                    Value="{Binding DataContext.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem Header="Edit Supplier" 
                                                  Command="{Binding Path=PlacementTarget.Tag.EditSupplierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <Separator Style="{x:Null}" Visibility="Collapsed"/>
                                        <MenuItem Header="Delete Supplier" 
                                                  Command="{Binding Path=PlacementTarget.Tag.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"
                                                  Foreground="{StaticResource ErrorRed}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="12"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Loading Overlay -->
            <Border Grid.RowSpan="3" Background="#80000000" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                    <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DRAWER OVERLAY -->
        <Grid x:Name="DrawerOverlay" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="BackgroundDimmer" Background="#80000000" Opacity="0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseOverlayCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border x:Name="DrawerContent" HorizontalAlignment="Right" Width="550" 
                    Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorderMedium}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="550"/>
                </Border.RenderTransform>
                
                <ContentControl Content="{Binding OverlayViewModel}" Margin="0"/>
            </Border>
        </Grid>
    </Grid>
</infra:BaseListView>





<UserControl x:Class="OCC.WpfClient.Features.ProcurementHub.Views.SupplierDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProcurementHub.ViewModels"
             xmlns:models="clr-namespace:OCC.Shared.Models;assembly=OCC.Shared"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:SupplierDetailViewModel}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:FriendlyEnumConverter x:Key="FriendlyEnumConverter" />

        <!-- Compact Add Line Button Style -->
        <Style x:Key="CompactAddLineButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1A2E9DFF"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True"
                                Padding="{TemplateBinding Padding}"
                                RenderTransformOrigin="0.5,0.5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#332E9DFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBlueHover}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#4D2E9DFF"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderText}" FontSize="20"/>
                        <TextBlock Text="Manage supplier profile and banking" Style="{StaticResource LabelText}" Opacity="0.7"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource WindowCloseButton}" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0" Padding="0">
                <StackPanel Margin="0,0,20,0">
                    <!-- Section: General Info -->
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="&#xE946;" Style="{StaticResource SymbolSectionIcon}" Foreground="{StaticResource AccentBlue}"/>
                            <TextBlock Text="General Information" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource AccentBlue}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Supplier Name" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Enter supplier name..."/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="VAT Number" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding VatNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="VAT..."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Acc #" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding SupplierAccountNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Acc..."/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Text="Physical Address" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInput}" 
                                     Height="Auto" 
                                     MinHeight="60" 
                                     AcceptsReturn="True" 
                                     VerticalScrollBarVisibility="Auto" 
                                     TextWrapping="Wrap" 
                                     Padding="8,6" 
                                     VerticalContentAlignment="Top"
                                     ap:WatermarkProperties.Watermark="123 Street..."/>
                        </StackPanel>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="City" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="City..."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Code" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding PostalCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Code..."/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Assigned Branch" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailableBranches}" SelectedItem="{Binding SelectedBranch}" Style="{StaticResource ModernComboBox}" Height="36"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Section: Contact Details -->
                    <StackPanel Margin="0,0,0,25">
                        <Grid Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE77B;" Style="{StaticResource SymbolSectionIcon}" Foreground="{StaticResource SuccessGreen}"/>
                                <TextBlock Text="Contacts &amp; Departments" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource SuccessGreen}"/>
                            </StackPanel>
                            <Button Content="+ Add Contact" Command="{Binding AddContactCommand}" 
                                    Style="{StaticResource CompactAddLineButtonStyle}" HorizontalAlignment="Right"/>
                        </Grid>

                        <ItemsControl ItemsSource="{Binding Contacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SupplierContact}">
                                    <Border Background="#10FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <TextBlock Text="CONTACT DETAILS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                                <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Right" ToolTip="Remove Contact">
                                                    <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="13"/>
                                                </Button>
                                            </Grid>

                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Contact Name" Style="{StaticResource FormLabelText}"/>
                                                    <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Name..."/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Department" Style="{StaticResource FormLabelText}"/>
                                                    <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="e.g. Sales, Accounts..."/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="Email Address" Style="{StaticResource FormLabelText}"/>
                                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="email@supplier.com"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="Phone Number" Style="{StaticResource FormLabelText}"/>
                                                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="+27..."/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Section: Banking Info -->
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="&#xE807;" Style="{StaticResource SymbolSectionIcon}" Foreground="{StaticResource AlertOrange}"/>
                            <TextBlock Text="Banking Information" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource AlertOrange}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Bank Name" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailableBanks}" SelectedItem="{Binding SelectedBank}" Style="{StaticResource ModernComboBox}" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource FriendlyEnumConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12" Visibility="{Binding IsOtherBankSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Custom Bank Name" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding CustomBankName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Enter bank name..."/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Account Number" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Account #..."/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Branch Code" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding BranchCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Code..."/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Validation Summary -->
                    <Border Margin="0,0,0,15" Background="#1AEE4444" BorderBrush="{StaticResource ErrorRed}" 
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasErrors, Converter={StaticResource VisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorRed}" FontSize="12" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                        <Button Content="Save Supplier" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#CC000000" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

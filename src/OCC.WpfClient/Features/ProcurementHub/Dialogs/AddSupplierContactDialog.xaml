<UserControl x:Class="OCC.WpfClient.Features.ProcurementHub.Dialogs.AddSupplierContactDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dialogVm="clr-namespace:OCC.WpfClient.Features.ProcurementHub.ViewModels.Dialogs"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="450">

    <Grid Background="#CC0F172A" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Border Style="{StaticResource GlassCard}" Width="450" Padding="24" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center" BorderThickness="1">
            <StackPanel>
                <!-- Title Header -->
                <Grid Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE715;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SecondaryGold}" FontSize="24" Margin="0,0,10,0"/>
                        <TextBlock Text="ADD SUPPLIER CONTACT" Style="{StaticResource HeaderText}" FontSize="16" FontFamily="{StaticResource MichromaFont}" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="{Binding SupplierName, StringFormat='Supplier: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"/>
                <TextBlock Text="No email address on file. Please enter contact details to send this Purchase Order and save to the supplier:" 
                           FontSize="12" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                <!-- Contact Name -->
                <TextBlock Text="Contact Person / Name:" Style="{StaticResource CompactLabel}" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="e.g. John Smith" Margin="0,0,0,12"/>

                <!-- Email Address -->
                <TextBlock Text="Email Address *" Style="{StaticResource CompactLabel}" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="e.g. john@supplier.com" Margin="0,0,0,12"/>

                <!-- Phone -->
                <TextBlock Text="Phone Number (Optional):" Style="{StaticResource CompactLabel}" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="e.g. 021 555 1234" Margin="0,0,0,12"/>

                <!-- Department -->
                <TextBlock Text="Department:" Style="{StaticResource CompactLabel}" Foreground="{StaticResource TextSub}" Margin="0,0,0,4"/>
                <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="e.g. Sales / Accounts" Margin="0,0,0,16"/>

                <!-- Error Message Display -->
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorRed}" FontSize="12" Margin="0,0,0,12"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource VisibilityConverter}}"/>

                <!-- Action Buttons -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0"/>
                    <Button Grid.Column="2" Content="Save &amp; Send" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButton}" Width="120"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.MainHub.Views.NoticeBoardWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.MainHub.ViewModels"
             xmlns:models="clr-namespace:OCC.Shared.Models;assembly=OCC.Shared"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NoticeBoardWidgetViewModel}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Inverse Boolean To Visibility Converter -->
        <Style x:Key="CollapsedWhenAdding" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAddingNotice}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VisibleWhenAdding" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAddingNotice}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MinHeight="180">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Header -->
            <RowDefinition Height="*" />    <!-- Content Area -->
        </Grid.RowDefinitions>

        <!-- Header Row -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Notice Board" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <Border Background="{StaticResource AccentBlue}" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Notices.Count}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <!-- Add Notice Button (Managers Only) -->
            <Button Command="{Binding ToggleAddNoticeCommand}" 
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Cursor="Hand"
                    Visibility="{Binding CanManageNotices, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Button.ToolTip>
                    <ToolTip Content="Post New Notice"/>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#2000BFFF" CornerRadius="14" Width="28" Height="28">
                            <TextBlock x:Name="txt" Text="" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#00BFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#00BFFF"/>
                                <Setter TargetName="txt" Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- 1. Add Notice Form (Visible when IsAddingNotice is True) -->
            <Border Style="{StaticResource VisibleWhenAdding}" Background="#1F1F29" CornerRadius="10" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Title" Style="{StaticResource FormLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Height="32"/>
                    </StackPanel>

                    <!-- Content -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Content / Message" Style="{StaticResource FormLabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding NewContent, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    </StackPanel>

                    <!-- Category Select -->
                    <Grid Grid.Row="2" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Category" Style="{StaticResource FormLabelText}" Margin="0,0,0,4"/>
                            <ComboBox SelectedValue="{Binding NewCategory}" 
                                      SelectedValuePath="DataContext"
                                      Style="{StaticResource ModernComboBox}" Height="32" Width="180" HorizontalAlignment="Left">
                                <ComboBoxItem Content="Announcement" DataContext="{x:Static models:NoticeCategory.Announcement}"/>
                                <ComboBoxItem Content="Bug Testing" DataContext="{x:Static models:NoticeCategory.BugTesting}"/>
                                <ComboBoxItem Content="Maintenance" DataContext="{x:Static models:NoticeCategory.Maintenance}"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <!-- Actions -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Cancel Button -->
                        <Button Content="Cancel" Command="{Binding ToggleAddNoticeCommand}" Width="80" Height="30" Margin="0,0,10,0" Cursor="Hand" Foreground="White" FontSize="12">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="Transparent" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#20FFFFFF"/>
                                            <Setter TargetName="bg" Property="BorderBrush" Value="#80FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        
                        <!-- Post Notice Button -->
                        <Button Content="Post Notice" Command="{Binding PostNoticeCommand}" Width="100" Height="30" Cursor="Hand" Foreground="White" FontSize="12" FontWeight="SemiBold">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" Background="{StaticResource AccentBlue}" CornerRadius="5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background" Value="#007ACC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Notices List (Visible when IsAddingNotice is False) -->
            <ScrollViewer Style="{StaticResource CollapsedWhenAdding}" VerticalScrollBarVisibility="Auto"  Padding="0,0,15,0">
                <ItemsControl ItemsSource="{Binding Notices}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:NoticeBoardItem}">
                            <Border x:Name="cardBorder" CornerRadius="10" Padding="12" Margin="0,0,0,8" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Text details -->
                                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Category Icon -->
                                    <TextBlock x:Name="categoryIcon" Grid.Column="0" FontSize="20" Margin="0,0,12,0" VerticalAlignment="Top" Style="{StaticResource SymbolIcon}"/>

                                    <!-- Text Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="Bold" Margin="0,0,0,4" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Content}" Foreground="#FFE5E7EB" FontSize="12" LineHeight="16" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <StackPanel Orientation="Horizontal" Opacity="0.6">
                                            <TextBlock Text="📢 " FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="Posted by " Style="{StaticResource FormLabelText}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CreatedBy}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text=" • " Style="{StaticResource FormLabelText}" FontSize="10" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy/MM/dd HH:mm}}" Style="{StaticResource FormLabelText}" FontSize="10" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Delete Button (Managers Only) -->
                                    <Button Grid.Column="2" 
                                            Command="{Binding DataContext.DeleteNoticeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding Id}"
                                            Margin="10,0,0,0" VerticalAlignment="Top" Cursor="Hand"
                                            Visibility="{Binding DataContext.CanManageNotices, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" Background="#20EF4444" CornerRadius="10" Width="20" Height="20">
                                                    <TextBlock x:Name="txt" Text="" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="#EF4444"/>
                                                        <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- DataTriggers to set Color Themes based on Notice Category -->
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:NoticeCategory.Announcement}">
                                    <Setter TargetName="cardBorder" Property="Background" Value="#1A10B981"/> <!-- Emerald Green -->
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3010B981"/>
                                    <Setter TargetName="categoryIcon" Property="Text" Value=""/>
                                    <Setter TargetName="categoryIcon" Property="Foreground" Value="#10B981"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:NoticeCategory.BugTesting}">
                                    <Setter TargetName="cardBorder" Property="Background" Value="#1A06B6D4"/> <!-- Cyan -->
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="#3006B6D4"/>
                                    <Setter TargetName="categoryIcon" Property="Text" Value=""/>
                                    <Setter TargetName="categoryIcon" Property="Foreground" Value="#06B6D4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Category}" Value="{x:Static models:NoticeCategory.Maintenance}">
                                    <Setter TargetName="cardBorder" Property="Background" Value="#1AEF4444"/> <!-- Red -->
                                    <Setter TargetName="cardBorder" Property="BorderBrush" Value="#30EF4444"/>
                                    <Setter TargetName="categoryIcon" Property="Text" Value=""/>
                                    <Setter TargetName="categoryIcon" Property="Foreground" Value="#EF4444"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

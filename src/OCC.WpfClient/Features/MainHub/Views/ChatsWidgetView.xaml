<UserControl x:Class="OCC.WpfClient.Features.MainHub.Views.ChatsWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.MainHub.ViewModels"
             xmlns:chatDtos="clr-namespace:OCC.Shared.DTOs;assembly=OCC.Shared"
             xmlns:converters="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChatsWidgetViewModel}">
    <UserControl.Resources>
        <converters:UserInitialsConverter x:Key="UserInitialsConverter"/>
        <converters:UserColorConverter x:Key="UserColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid MinHeight="200">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Unread Chats" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <Border Background="#EF4444" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding UnreadSessions.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding UnreadSessions.Count}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                </Border>
            </StackPanel>

            <Button Content="Open Chat Hub" Command="{Binding NavigateToChatHubCommand}" HorizontalAlignment="Right" Style="{StaticResource ModernTabButton}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Loading Spinner -->
            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Background="Transparent" Foreground="{StaticResource AccentBlue}"
                         Visibility="{Binding IsLoadingChats, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- No Unread Chats Message -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding UnreadSessions.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoadingChats}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,5" Opacity="0.5"/>
                <TextBlock Text="No unread messages." Foreground="{StaticResource TextSub}" FontSize="13" FontStyle="Italic" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Unread Chats List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding UnreadSessions.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding UnreadSessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type chatDtos:ChatSessionDto}">
                            <!-- Clickable Session Card -->
                            <Button Command="{Binding DataContext.NavigateToChatSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,0,0,8" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cardBorder" Background="#0DFFFFFF" CornerRadius="10" Padding="12,8" BorderThickness="1" BorderBrush="#08FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Initials Avatar -->
                                                    <ColumnDefinition Width="*"/>    <!-- Name / Preview -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Time / Badge -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Circular Avatar -->
                                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" 
                                                        Background="{Binding Name, Converter={StaticResource UserColorConverter}}" 
                                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name, Converter={StaticResource UserInitialsConverter}}" 
                                                               Foreground="White" FontSize="12" FontWeight="Bold" 
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Content Preview -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastMessage.Content, FallbackValue='No messages yet'}" Style="{StaticResource FormLabelText}" FontSize="11" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" Opacity="0.75"/>
                                                </StackPanel>

                                                <!-- Time & Badge -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding LastMessage.SentDate, StringFormat={}{0:HH:mm}}" Foreground="{StaticResource TextSub}" FontSize="10" HorizontalAlignment="Right"/>
                                                    <Border Background="#EF4444" CornerRadius="7" Padding="4,1" Margin="0,2,0,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="#1AFFFFFF"/>
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

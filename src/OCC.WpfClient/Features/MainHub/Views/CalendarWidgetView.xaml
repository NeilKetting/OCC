<UserControl x:Class="OCC.WpfClient.Features.MainHub.Views.CalendarWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.MainHub.ViewModels"
             xmlns:calModels="clr-namespace:OCC.WpfClient.Features.CalendarHub.Models"
             xmlns:converters="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CalendarWidgetViewModel}">
    <UserControl.Resources>
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    
    <Grid MinHeight="250">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Upcoming Schedule" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Next 7 Days" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center" Margin="10,2,0,0"/>
            </StackPanel>
            
            <Button Content="View Calendar" Command="{Binding NavigateToCalendarCommand}" HorizontalAlignment="Right" Style="{StaticResource ModernTabButton}" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold"/>
        </Grid>

        <Grid Grid.Row="1">
            <!-- Loading Spinner -->
            <ProgressBar IsIndeterminate="True" Height="4" VerticalAlignment="Top" Background="Transparent" Foreground="{StaticResource AccentBlue}"
                         Visibility="{Binding IsLoadingEvents, Converter={StaticResource BooleanToVisibilityConverter}}"/>

            <!-- No Events Message -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding UpcomingEvents.Count}" Value="0"/>
                                    <Condition Binding="{Binding IsLoadingEvents}" Value="False"/>
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible"/>
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,10" Opacity="0.5"/>
                <TextBlock Text="No events scheduled for the next 7 days." Foreground="{StaticResource TextSub}" FontSize="14" FontStyle="Italic" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Events List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <Trigger Property="HasContent" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding UpcomingEvents.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                
                <ItemsControl ItemsSource="{Binding UpcomingEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type calModels:CalendarEvent}">
                            <!-- Clickable Event Card -->
                            <Button Command="{Binding DataContext.NavigateToEventCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Margin="0,0,0,10" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="cardBorder" Background="#0DFFFFFF" CornerRadius="10" Padding="15,10" BorderThickness="1" BorderBrush="#08FFFFFF">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                                    <ColumnDefinition Width="*"/>    <!-- Text details -->
                                                    <ColumnDefinition Width="Auto"/> <!-- Date/Tag -->
                                                </Grid.ColumnDefinitions>

                                                <!-- Type Icon -->
                                                <Border x:Name="IconBorder" Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="#1C2E9DFF" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="IconTxt" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Text info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Foreground="White" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="SemiBold" 
                                                                   Visibility="{Binding ProjectName, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="•" Foreground="{StaticResource TextSub}" FontSize="11" 
                                                                   Visibility="{Binding ProjectName, Converter={StaticResource StringToVisibilityConverter}}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource FormLabelText}" FontSize="11" TextTrimming="CharacterEllipsis" Opacity="0.7"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Date Info -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding StartDate, StringFormat={}{0:dd MMM}}" Foreground="White" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                                    <TextBlock x:Name="TypeLabel" Text="Task" Foreground="{StaticResource TextSub}" FontSize="11" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="cardBorder" Property="Background" Value="#1AFFFFFF"/>
                                                <Setter TargetName="cardBorder" Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                            </Trigger>
                                            <!-- Public Holiday style -->
                                            <DataTrigger Binding="{Binding Type}" Value="PublicHoliday">
                                                <Setter TargetName="IconBorder" Property="Background" Value="#1AFF8F00"/>
                                                <Setter TargetName="IconTxt" Property="Text" Value=""/>
                                                <Setter TargetName="IconTxt" Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                                                <Setter TargetName="TypeLabel" Property="Text" Value="Holiday"/>
                                            </DataTrigger>
                                            <!-- Birthday style -->
                                            <DataTrigger Binding="{Binding Type}" Value="Birthday">
                                                <Setter TargetName="IconBorder" Property="Background" Value="#1AEC4899"/>
                                                <Setter TargetName="IconTxt" Property="Text" Value=""/>
                                                <Setter TargetName="IconTxt" Property="Foreground" Value="#EC4899"/>
                                                <Setter TargetName="TypeLabel" Property="Text" Value="Birthday"/>
                                            </DataTrigger>
                                            <!-- Leave style -->
                                            <DataTrigger Binding="{Binding Type}" Value="Leave">
                                                <Setter TargetName="IconBorder" Property="Background" Value="#1ABE9DFF"/>
                                                <Setter TargetName="IconTxt" Property="Text" Value=""/>
                                                <Setter TargetName="IconTxt" Property="Foreground" Value="#BE9DFF"/>
                                                <Setter TargetName="TypeLabel" Property="Text" Value="Leave"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.GanttMenuBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OCC.WpfClient.Features.ProjectHub.Views"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ProjectGanttViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="VerticalGanttButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="2,4"/>
                <Setter Property="Margin" Value="1,0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Width" Value="80"/>
                <Setter Property="Height" Value="52"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource GlassBorderUltraLight}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.3"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1" Padding="10,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- Left: Title + Predecessor Cascade Actions -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Gantt Chart" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>

                <Border Width="1" Background="{StaticResource GlassBorderUltraLight}" Margin="12,5" Height="32" VerticalAlignment="Center"/>

                <!-- Apply Predecessor Scheduling -->
                <Button Command="{Binding ApplyPredecessorCascadeCommand}" 
                        Style="{StaticResource VerticalGanttButton}" 
                        ToolTip="Recalculate task dates based on predecessor (Finish-to-Start) relationships">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="Scheduling" FontSize="10" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Save Schedule (only visible when pending changes exist) -->
                <Button Command="{Binding SaveCascadeChangesCommand}"
                        Visibility="{Binding HasPendingCascadeChanges, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource VerticalGanttButton}" 
                        ToolTip="Save cascaded date changes to the database">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="Save Changes" FontSize="10" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource GlassBorderUltraLight}" Margin="12,5" Height="32" VerticalAlignment="Center"/>

                <!-- Add Task -->
                <Button Command="{Binding NewTaskCommand}" 
                        Style="{StaticResource VerticalGanttButton}" 
                        ToolTip="Create a new top-level task for the project">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="Add Task" FontSize="10" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Add Subtask -->
                <Button Command="{Binding CreateSubtaskCommand}" 
                        Style="{StaticResource VerticalGanttButton}" 
                        ToolTip="Create a child subtask under the selected task">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&#xE8A7;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="#C084FC" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="Add Subtask" FontSize="10" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Edit -->
                <Button Command="{Binding EditTaskCommand}" 
                        Style="{StaticResource VerticalGanttButton}" 
                        ToolTip="Edit details of the selected task">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource OrangeBrush}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="Edit Task" FontSize="10" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Delete -->
                <Button Command="{Binding DeleteTaskCommand}" 
                        Style="{StaticResource VerticalGanttButton}" 
                        ToolTip="Delete the selected task">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="Delete" FontSize="10" Foreground="{StaticResource ErrorRed}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Border Width="1" Background="{StaticResource GlassBorderUltraLight}" Margin="12,5" Height="32" VerticalAlignment="Center"/>

                <!-- Print -->
                <Button Command="{Binding PrintCommand}" 
                        Style="{StaticResource VerticalGanttButton}" 
                        ToolTip="Print the Gantt tasks report">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SecondaryGold}" HorizontalAlignment="Center" Margin="0,0,0,3"/>
                        <TextBlock Text="Print" FontSize="10" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right Controls: Show Links Toggle + Zoom + Date Navigation -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">

                <!-- Show Links Toggle -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="Show Links" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" Margin="0,0,8,0" FontSize="11"/>
                    <ToggleButton IsChecked="{Binding ShowDependencyLines, Mode=TwoWay}" 
                                  Width="40" Height="20"
                                  VerticalAlignment="Center"
                                  ToolTip="Show or hide dependency connector lines">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <!-- Track -->
                                                <Border x:Name="Track" 
                                                        Background="#555" 
                                                        CornerRadius="10" 
                                                        Width="40" Height="20"/>
                                                <!-- Thumb -->
                                                <Ellipse x:Name="Thumb" 
                                                         Width="14" Height="14" 
                                                         Fill="White"
                                                         HorizontalAlignment="Left"
                                                         Margin="3,0,0,0">
                                                    <Ellipse.RenderTransform>
                                                        <TranslateTransform x:Name="ThumbTranslate" X="0"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#E8750A" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                                                 Storyboard.TargetProperty="X"
                                                                                 To="20" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <ColorAnimation Storyboard.TargetName="Track"
                                                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                                To="#555" Duration="0:0:0.15"/>
                                                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate"
                                                                                 Storyboard.TargetProperty="X"
                                                                                 To="0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Thumb" Property="Fill" Value="#E0E0E0"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>

                <Border Width="1" Background="{StaticResource GlassBorderUltraLight}" Margin="5,5,15,5" Height="20" VerticalAlignment="Center"/>

                <Button Command="{Binding GoToTodayCommand}" Content="Today" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
                <Border Width="1" Background="{StaticResource GlassBorderUltraLight}" Margin="15,5" Height="20" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ZoomOutCommand}" Width="24" Height="24" Padding="0">
                        <TextBlock Text="&#xE949;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource OrangeBrush}" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Slider Value="{Binding ZoomLevel}" Minimum="0.4" Maximum="3.0" Width="100" VerticalAlignment="Center" Margin="5,0" />
                    <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ZoomInCommand}" Width="24" Height="24" Padding="0">
                        <TextBlock Text="&#xE948;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource OrangeBrush}" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

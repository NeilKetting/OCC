<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.GanttMenuBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OCC.WpfClient.Features.ProjectHub.Views"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="50" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:ProjectGanttViewModel}">

    <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1" Padding="10,5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            
            <!-- Left Controls: Filter / View Options -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="FilterButton" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding ToggleFilterPopupCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Filter" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                        <Border Background="{StaticResource AccentBlue}" CornerRadius="8" Padding="5,0" Margin="5,0,0,0" 
                                Visibility="{Binding FilterSubContractorId, Converter={StaticResource VisibilityConverter}, ConverterParameter='NotNull'}">
                             <TextBlock Text="1" FontSize="9" Foreground="White" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Popup IsOpen="{Binding IsFilterPopupOpen}" PlacementTarget="{Binding ElementName=FilterButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{StaticResource BackgroundCard}" BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1" CornerRadius="8" Margin="5" Padding="0" Width="280">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#10FFFFFF" Padding="15,10" CornerRadius="8,8,0,0">
                                <TextBlock Text="Filter Tasks" FontWeight="SemiBold" Foreground="White"/>
                            </Border>

                            <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="QUICK FILTERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="5,5,5,10"/>
                                    
                                    <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Overdue" Margin="0,2">
                                        <Grid HorizontalAlignment="Stretch" Width="240">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#FF5252" Margin="5,0,10,0"/>
                                                <TextBlock Text="Overdue" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#30FF5252" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding OverdueCount}" FontSize="10" Foreground="#FF5252" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due Today" Margin="0,2">
                                        <Grid HorizontalAlignment="Stretch" Width="240">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" Margin="5,0,10,0"/>
                                                <TextBlock Text="Due Today" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#302E9DFF" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DueTodayCount}" FontSize="10" Foreground="{StaticResource AccentBlue}" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due This Week" Margin="0,2">
                                        <Grid HorizontalAlignment="Stretch" Width="240">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#8B5CF6" Margin="5,0,10,0"/>
                                                <TextBlock Text="Due This Week" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#308B5CF6" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DueThisWeekCount}" FontSize="10" Foreground="#8B5CF6" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due This Month" Margin="0,2">
                                        <Grid HorizontalAlignment="Stretch" Width="240">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#EC4899" Margin="5,0,10,0"/>
                                                <TextBlock Text="Due This Month" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Border Background="#30EC4899" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding DueThisMonthCount}" FontSize="10" Foreground="#EC4899" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Button>

                                    <Border Height="1" Background="{StaticResource GlassBorderUltraLight}" Margin="5,15"/>

                                    <TextBlock Text="SUBCONTRACTORS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="5,5,5,10"/>
                                    
                                    <ItemsControl ItemsSource="{Binding SubContractorFilters}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButtonStyle}" 
                                                        Command="{Binding DataContext.ApplySubContractorFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                        CommandParameter="{Binding Id}" Margin="0,2">
                                                    <Grid HorizontalAlignment="Stretch" Width="240">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" Margin="5,0,10,0" FontSize="12"/>
                                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                        </StackPanel>
                                                        <Border Background="#15FFFFFF" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding TaskCount}" FontSize="10" Foreground="White" Opacity="0.7"/>
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Grid.Row="2" Style="{StaticResource LinkButtonStyle}" Command="{Binding ClearFiltersCommand}" 
                                    HorizontalAlignment="Stretch" Padding="15,12" Background="#05FFFFFF">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Margin="0,0,10,0" FontSize="12"/>
                                    <TextBlock Text="Clear All Filters" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Popup>
                <Button Style="{StaticResource SecondaryButton}">
                     <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="View" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Right Controls: Zoom and Date Navigation -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Command="{Binding GoToTodayCommand}" Content="Today" Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" />
                <Border Width="1" Background="{StaticResource GlassBorderUltraLight}" Margin="15,5" Height="20" VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" Margin="0,0,10,0"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ZoomOutCommand}" Width="24" Height="24" Padding="0">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                    <Slider Value="{Binding ZoomLevel}" Minimum="0.4" Maximum="3.0" Width="100" VerticalAlignment="Center" Margin="5,0"/>
                    <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding ZoomInCommand}" Width="24" Height="24" Padding="0">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

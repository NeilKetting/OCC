<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectHseqDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance vm:ProjectHseqDashboardViewModel}">

    <Grid Background="{StaticResource BackgroundDark}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="15">

                <!-- Header -->
                <StackPanel Margin="0,0,0,15">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource PrimaryTeal}" FontSize="24" Margin="0,0,12,0"/>
                        <TextBlock Text="Project HSEQ Dashboard" Style="{StaticResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Health, Safety, Environment &amp; Quality performance overview for this project." Style="{StaticResource LabelText}" Opacity="0.7"/>
                </StackPanel>

                <!-- KPI Cards -->
                <UniformGrid Columns="4" Margin="0,0,0,20">
                    <!-- Safe Hours -->
                    <Border Style="{StaticResource ToolbarBorder}" Background="{StaticResource BackgroundDark}" Margin="0,0,8,0">
                        <StackPanel Margin="15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Safe Hours" Style="{StaticResource TitleText}" Opacity="0.8" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding TotalSafeHours, StringFormat=\{0:N2\}}" Style="{StaticResource HeaderText}" Foreground="{StaticResource SuccessGreen}" FontSize="20"/>
                            <TextBlock Text="Hours without LTI" Style="{StaticResource LabelText}" Opacity="0.6" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Avg Audit Score -->
                    <Border Style="{StaticResource ToolbarBorder}" Background="{StaticResource BackgroundDark}" Margin="8,0,8,0">
                        <StackPanel Margin="15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource PrimaryTeal}" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Avg Audit Score" Style="{StaticResource TitleText}" Opacity="0.8" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AverageAuditScore, StringFormat='{}{0}%'}" Style="{StaticResource HeaderText}" Foreground="{StaticResource PrimaryTeal}" FontSize="20"/>
                            <TextBlock Text="Average compliance score" Style="{StaticResource LabelText}" Opacity="0.6" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Audits -->
                    <Border Style="{StaticResource ToolbarBorder}" Background="{StaticResource BackgroundDark}" Margin="8,0,8,0">
                        <StackPanel Margin="15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Total Audits" Style="{StaticResource TitleText}" Opacity="0.8" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding AuditsTotal}" Style="{StaticResource HeaderText}" Foreground="White" FontSize="20"/>
                            <TextBlock Text="Audits conducted on site" Style="{StaticResource LabelText}" Opacity="0.6" FontSize="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Total Incidents -->
                    <Border Style="{StaticResource ToolbarBorder}" Background="{StaticResource BackgroundDark}" Margin="8,0,0,0">
                        <StackPanel Margin="15">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AlertOrange}" FontSize="15" Margin="0,0,8,0"/>
                                <TextBlock Text="Total Incidents" Style="{StaticResource TitleText}" Opacity="0.8" FontSize="12"/>
                            </StackPanel>
                            <TextBlock Text="{Binding IncidentsTotal}" Style="{StaticResource HeaderText}" Foreground="{StaticResource AlertOrange}" FontSize="20"/>
                            <TextBlock Text="Reported incidents/hazards" Style="{StaticResource LabelText}" Opacity="0.6" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Charts Column Layout -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4*"/>
                        <ColumnDefinition Width="5*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Audit Trends -->
                    <Border Grid.Column="0" Style="{StaticResource ToolbarBorder}" Height="380" Background="{StaticResource BackgroundDark}" Margin="0,0,8,0">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Audit Score Trend" Style="{StaticResource TitleText}" Margin="0,0,0,10" FontSize="13"/>
                            <lvc:CartesianChart Grid.Row="1" Background="Transparent"
                                                 LegendTextPaint="{Binding LegendTextPaint}"
                                                 LegendTextSize="12"
                                                 Series="{Binding AuditTrendSeries}" 
                                                 XAxes="{Binding AuditTrendXAxes}"
                                                 YAxes="{Binding AuditTrendYAxes}"/>
                        </Grid>
                    </Border>

                    <!-- Category Breakdown -->
                    <Border Grid.Column="1" Style="{StaticResource ToolbarBorder}" Height="380" Background="{StaticResource BackgroundDark}" Margin="8,0,8,0">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Category Score Breakdown" Style="{StaticResource TitleText}" Margin="0,0,0,10" FontSize="13"/>
                            <lvc:CartesianChart Grid.Row="1" Background="Transparent"
                                                 LegendTextPaint="{Binding LegendTextPaint}"
                                                 LegendTextSize="12"
                                                 Series="{Binding CategoryBreakdownSeries}" 
                                                 XAxes="{Binding CategoryXAxes}"
                                                 YAxes="{Binding CategoryYAxes}"/>
                        </Grid>
                    </Border>

                    <!-- Incident Distribution -->
                    <Border Grid.Column="2" Style="{StaticResource ToolbarBorder}" Height="380" Background="{StaticResource BackgroundDark}" Margin="8,0,0,0">
                        <Grid Margin="15">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Incident Types" Style="{StaticResource TitleText}" Margin="0,0,0,10" FontSize="13"/>
                            <lvc:PieChart Grid.Row="1" Background="Transparent" Series="{Binding IncidentDistributionSeries}" LegendPosition="Bottom"
                                          LegendTextPaint="{Binding LegendTextPaint}"
                                          LegendTextSize="11"/>
                        </Grid>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

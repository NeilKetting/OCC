<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectReportRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance vm:ProjectReportRunViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDarker}">
        <Grid.RowDefinitions>
            <!-- Header Section -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content (Split Pane) -->
            <RowDefinition Height="*"/>
            <!-- Bottom Progress & Actions -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER SECTION -->
        <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="20,15">
            <StackPanel Grid.Column="0">
                <TextBlock Text="WEEKLY BATCH REPORT RUN" Foreground="{StaticResource SecondaryGold}" FontSize="12" FontWeight="Bold"/>
                <TextBlock Text="Generate Project Reports" Foreground="White" FontSize="28" FontWeight="Light" Margin="0,5,0,0"/>
                <TextBlock Text="Review, edit, and queue all active projects to generate their Thursday weekly report in one run." Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT (SPLIT PANE) -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: Project Queue (Checklist) -->
                <ColumnDefinition Width="380"/>
                <!-- Splitter -->
                <ColumnDefinition Width="20"/>
                <!-- Right Panel: Editor for Selected Item -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: PROJECT QUEUE -->
            <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="PROJECT QUEUE" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,12"/>

                    <!-- Header Toggle Select All -->
                    <Border Grid.Row="1" Background="#10FFFFFF" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="10,8" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox Grid.Column="0" IsChecked="{Binding SelectAllChecked}" Command="{Binding ToggleSelectAllCommand}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Select All Projects" Foreground="White" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Queue List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding RunItems}" SelectedItem="{Binding SelectedItem}" Background="Transparent" BorderThickness="0" Margin="0,5,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DataTemplate.Resources>
                                    <Style x:Key="StatusBorderStyle" TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Pending">
                                                <Setter Property="Background" Value="#1AFFFFFF"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Generating...">
                                                <Setter Property="Background" Value="#20FFC107"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Completed">
                                                <Setter Property="Background" Value="#2000C853"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Failed">
                                                <Setter Property="Background" Value="#20FF4B4B"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style x:Key="StatusTextBlockStyle" TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Pending">
                                                <Setter Property="Text" Value="Pending"/>
                                                <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Generating...">
                                                <Setter Property="Text" Value="Generating"/>
                                                <Setter Property="Foreground" Value="{StaticResource SecondaryGold}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Completed">
                                                <Setter Property="Text" Value="Completed"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding GenerationStatus}" Value="Failed">
                                                <Setter Property="Text" Value="Failed"/>
                                                <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataTemplate.Resources>
                                <Grid Margin="5,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox for batch run -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Project Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ProjectSummary.Name}" Foreground="White" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="Week " Foreground="{StaticResource TextSub}" FontSize="11"/>
                                            <TextBlock Text="{Binding WeekNumber}" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource StatusBorderStyle}" VerticalAlignment="Center" Padding="8,4" CornerRadius="4">
                                        <TextBlock Style="{StaticResource StatusTextBlockStyle}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Padding" Value="5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#1A2E9DFF"/>
                                                    <Setter TargetName="border" Property="BorderBrush" Value="#402E9DFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: DRAFT EDITOR -->
            <Grid Grid.Column="2" DataContext="{Binding SelectedItem}">
                <!-- Empty State -->
                <Border Style="{StaticResource GlassCard}" 
                        Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}}" 
                        Padding="30">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="80" Opacity="0.1" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="No Project Selected" FontSize="18" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" FontWeight="Bold"/>
                        <TextBlock Text="Select a project from the left queue to edit its weekly report draft." FontSize="13" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Editor State -->
                <Grid Visibility="{Binding Converter={StaticResource NullToVisibilityConverter}, ConverterParameter=Invert}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Selected Project Header -->
                    <Border Grid.Row="0" Margin="0,0,0,15" Padding="5,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding ProjectSummary.Name}" Foreground="White" FontSize="22" FontWeight="Light"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="#20FFFFFF" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="REPORT WEEK " Foreground="{StaticResource TextSub}" FontSize="9" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding WeekNumber}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Draft Details" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Editors -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-15,0" Padding="0,0,15,0">
                        <StackPanel>

                            <!-- Project Status Summary Card -->
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="PROJECT STATUS SUMMARY" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Command="{Binding DataContext.AutoGenerateSelectedSummaryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SecondaryGold}" Margin="0,0,5,0" FontSize="12" VerticalAlignment="Center"/>
                                                <TextBlock Text="Auto-Generate Draft" Foreground="White" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <TextBox Text="{Binding StatusSummary, UpdateSourceTrigger=PropertyChanged}" 
                                             MinHeight="110" 
                                             AcceptsReturn="True" 
                                             TextWrapping="Wrap" 
                                             VerticalScrollBarVisibility="Auto" 
                                             Style="{StaticResource ModernInput}"
                                             Padding="10" 
                                             CaretBrush="White" 
                                             FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Milestones Card -->
                                <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="CONTRACT DATES &amp; MILESTONES" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                                        <!-- Project Dates -->
                                        <Grid Margin="0,0,0,20">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                                <TextBlock Text="Project Start Date" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,0,3"/>
                                                <Border Background="#10FFFFFF" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Height="35" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProjectDetails.StartDate, StringFormat='{}{0:yyyy/MM/dd}', TargetNullValue='-'}" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                                <TextBlock Text="Project Finish Date" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,0,3"/>
                                                <Border Background="#10FFFFFF" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Height="35" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ProjectDetails.EndDate, StringFormat='{}{0:yyyy/MM/dd}', TargetNullValue='-'}" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>

                                        <!-- This Week's Milestones -->
                                        <TextBlock Text="THIS WEEK'S MILESTONES" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                                        <!-- No This Week Milestones Message -->
                                        <TextBlock Text="No milestones scheduled for this week." 
                                                   Foreground="{StaticResource TextSub}" 
                                                   FontSize="12" 
                                                   FontStyle="Italic"
                                                   Margin="0,0,0,15"
                                                   Visibility="{Binding NoThisWeekMilestones, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- This Week Milestones List -->
                                        <ItemsControl ItemsSource="{Binding ThisWeekMilestones}" Visibility="{Binding HasThisWeekMilestones, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,15">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                                                    <Border CornerRadius="4" Padding="4,2" Background="#15FFFFFF">
                                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding StartDate, StringFormat='Start: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding PlannedDate, StringFormat='Due: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10"/>
                                                            </StackPanel>

                                                            <!-- Delay Reason Input -->
                                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="Reason for Delay" Foreground="{StaticResource SecondaryGold}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Height="45" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Overdue Milestones -->
                                        <TextBlock Text="OVERDUE MILESTONES" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,10,0,10"/>

                                        <!-- No Overdue Milestones Message -->
                                        <TextBlock Text="No overdue milestones." 
                                                   Foreground="{StaticResource TextSub}" 
                                                   FontSize="12" 
                                                   FontStyle="Italic"
                                                   Margin="0,0,0,10"
                                                   Visibility="{Binding NoOverdueMilestones, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                        <!-- Overdue Milestones List -->
                                        <ItemsControl ItemsSource="{Binding OverdueMilestones}" Visibility="{Binding HasOverdueMilestones, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border CornerRadius="6" Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                                        <StackPanel>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" Foreground="{StaticResource SecondaryGold}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                                                    <Border CornerRadius="4" Padding="4,2" Background="#15FFFFFF">
                                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Grid>
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                <TextBlock Text="{Binding StartDate, StringFormat='Start: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,10,0"/>
                                                                <TextBlock Text="{Binding PlannedDate, StringFormat='Due: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10"/>
                                                            </StackPanel>

                                                            <!-- Delay Reason Input (Always shown for overdue tasks since IsOverdue is true) -->
                                                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <TextBlock Text="Reason for Delay" Foreground="{StaticResource SecondaryGold}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Height="45" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Waste & POW Edit Card -->
                                <StackPanel Grid.Column="2" Margin="0,0,0,20">
                                    <!-- Program of Works Edit Card -->
                                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="PROGRAM OF WORKS METRICS" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                    <TextBlock Text="POW % REQUIRED" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                                    <TextBox Text="{Binding PowPercentRequired, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                    <TextBlock Text="DELAY DAYS" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                                    <TextBox Text="{Binding DelayDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Waste Disposal Card -->
                                    <Border Style="{StaticResource GlassCard}" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="WASTE DISPOSAL QUANTITIES" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="General Waste (TON)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBox Grid.Column="1" Text="{Binding GeneralWasteTon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Rubble (m3)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBox Grid.Column="1" Text="{Binding RubbleM3, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Scrap metals (TON)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBox Grid.Column="1" Text="{Binding ScrapMetalsTon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="100"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="Asbestos (TON)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                                <TextBox Grid.Column="1" Text="{Binding AsbestosTon, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <!-- BOTTOM PROGRESS & ACTIONS -->
        <Border Grid.Row="2" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,1,0,0" Background="#10000000" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left side: Generation Progress -->
                <Grid Grid.Column="0" Margin="0,0,30,0" VerticalAlignment="Center" Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding BatchStatusText}" Foreground="White" FontSize="12" Margin="0,0,0,8"/>
                    <ProgressBar Grid.Row="1" Value="{Binding BatchProgress}" Maximum="100" Height="8" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                </Grid>

                <!-- Standby Text -->
                <TextBlock Grid.Column="0" Text="Standby - Make your selections and edit drafts, then click Generate." Foreground="{StaticResource TextSub}" FontSize="12" FontStyle="Italic" VerticalAlignment="Center" Visibility="{Binding IsGenerating, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"/>

                <!-- Right side: Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Command="{Binding SaveSelectedItemCommand}" Style="{StaticResource IconButton}" Margin="0,0,12,0" Padding="15,10" IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Current Draft" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding GenerateReportsCommand}" Style="{StaticResource IconButton}" Padding="20,10" IsEnabled="{Binding IsGenerating, Converter={StaticResource InverseBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Margin="0,0,8,0"/>
                            <TextBlock Text="Generate Reports" Style="{StaticResource LabelText}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- STANDARD LOADING OVERLAY -->
        <ContentControl Grid.Row="0" Grid.RowSpan="3" Style="{StaticResource StandardLoadingOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}"/>
    </Grid>
</UserControl>

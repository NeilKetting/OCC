<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectTaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:local="clr-namespace:OCC.WpfClient.Features.ProjectHub.Views"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:ProjectTaskListViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <conv:VisibilityConverter x:Key="VisibilityConverter" />
            <conv:LevelToIndentConverter x:Key="LevelToIndentConverter" IndentStep="30" />
            <conv:RotationConverter x:Key="RotationConverter" />

            <Style x:Key="ExpanderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="4" Width="20" Height="20">
                                <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tool Bar -->
            <Border Grid.Row="0" Margin="10">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Project Tasks" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBlue}" CornerRadius="12" Padding="10,2" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalActionableTaskCount}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding NewTaskCommand}" Style="{StaticResource ActionButtonPrimary}" Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock Text="Create Task"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats & Search Line -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="10,0,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Search Icon -->
                        <ColumnDefinition Width="250" />  <!-- Search Box -->
                        <ColumnDefinition Width="Auto" /> <!-- Stage Filter -->
                        <ColumnDefinition Width="Auto" /> <!-- Divider -->
                        <ColumnDefinition Width="Auto" /> <!-- Columns -->
                        <ColumnDefinition Width="*" />    <!-- Spacer -->
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernInput}" Height="34" Padding="8,0" BorderThickness="0" Background="Transparent"
                             ap:WatermarkProperties.Watermark="Search tasks..."/>

                    <!-- Stage Filter -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="Filter Stage:" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" Margin="0,0,10,0" FontSize="11" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding AvailableStages}" SelectedItem="{Binding SelectedStageFilter}" Style="{StaticResource ModernComboBox}" Width="150" Height="34"/>
                    </StackPanel>

                    <Separator Grid.Column="3" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,5" Foreground="#20FFFFFF"/>

                    <Button Grid.Column="4" Command="{Binding ToggleColumnPickerCommand}" Style="{StaticResource GhostButton}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="COLUMNS" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Column Picker Popup -->
                    <Popup IsOpen="{Binding IsColumnPickerOpen}" StaysOpen="False" Placement="Bottom" Margin="0,5,0,0">
                        <Border Background="{StaticResource AppBackground}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Width="200">
                            <StackPanel>
                                <TextBlock Text="Toggle Columns" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox Content="Start Date" IsChecked="{Binding IsStartVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="End Date" IsChecked="{Binding IsEndVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Progress" IsChecked="{Binding IsProgressVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Stage" IsChecked="{Binding IsStageVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Duration" IsChecked="{Binding IsDurationVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Assigned" IsChecked="{Binding IsAssignedVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Priority" IsChecked="{Binding IsPriorityVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Task List -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="10,0,10,10" Padding="1">
                <Grid>
                    <DataGrid x:Name="TasksGrid"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              MouseDoubleClick="OnTaskDoubleClick">
                        <DataGrid.Columns>
                            <!-- Status Icon -->
                            <DataGridTemplateColumn Header="STATUS" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="5" Color="White" Opacity="0.2" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="STATUS" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#15FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Background" Value="#20EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                                                <Setter Property="Text" Value="OVERDUE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Task Name with Hierarchy -->
                            <DataGridTemplateColumn Header="TASK NAME" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentLevel, Converter={StaticResource LevelToIndentConverter}}">
                                            <!-- Expander Button -->
                                            <Button Style="{StaticResource ExpanderButtonStyle}" 
                                                    Command="{Binding Data.ToggleExpandCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource VisibilityConverter}}"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="8" Foreground="White" Opacity="0.7">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource RotationConverter}}" CenterX="4" CenterY="4"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>
                                            
                                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Dates -->
                            <DataGridTextColumn Header="START DATE" Binding="{Binding StartDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="110" Visibility="{Binding Data.IsStartVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                            <DataGridTextColumn Header="END DATE" Binding="{Binding FinishDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="110" Visibility="{Binding Data.IsEndVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>

                            <!-- Progress -->
                            <DataGridTemplateColumn Header="PROGRESS" Width="100" Visibility="{Binding Data.IsProgressVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="5,0">
                                            <ProgressBar Value="{Binding PercentComplete}" Height="6" Background="#15FFFFFF" Foreground="{StaticResource AccentBlue}" BorderThickness="0" Template="{StaticResource ModernProgressBarTemplate}"/>
                                            <TextBlock Text="{Binding PercentComplete, StringFormat='{}{0}%'}" FontSize="8" Foreground="White" HorizontalAlignment="Right" Margin="0,-12,0,0" Opacity="0.6"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Priority -->
                            <DataGridTemplateColumn Header="PRIORITY" Width="100" Visibility="{Binding Data.IsPriorityVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Priority}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Important">
                                                            <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>


                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Header="Edit Task" Command="{Binding EditTaskCommand}" CommandParameter="{Binding SelectedTask}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Add Subtask" Command="{Binding CreateSubtaskCommand}" CommandParameter="{Binding SelectedTask}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Assign To..." Command="{Binding ShowAssignToCommand}" CommandParameter="{Binding SelectedTask}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Delete Task" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding SelectedTask}" Foreground="{StaticResource ErrorRed}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="{StaticResource ErrorRed}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasTasks, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="48" Foreground="{StaticResource TextSub}" Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock Text="No tasks found for this project" Foreground="{StaticResource TextSub}" FontSize="14" Margin="0,20,0,0"/>
                        <Button Content="Create Your First Task" Command="{Binding NewTaskCommand}" Style="{StaticResource GhostButton}" Margin="0,20,0,0"/>
                    </StackPanel>

                    <!-- Loading Overlay -->
                    <ContentControl Style="{StaticResource StandardLoadingOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Task Detail Drawer (Overlay handled by TaskDetailView itself) -->
        <ContentControl Content="{Binding CurrentTaskDetail}"/>

        <!-- Assign To Popup (Overlay) -->
        <Border Background="#99000000" Visibility="{Binding IsAssignPopupOpen, Converter={StaticResource VisibilityConverter}}">
            <Border Style="{StaticResource GlassCard}" Width="400" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#10FFFFFF" Padding="20,15">
                        <Grid>
                            <TextBlock Text="Assign Task" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Command="{Binding CloseAssignPopupCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="20,15,20,0">
                        <TextBlock Text="{Binding TaskToAssign.Name}" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBox Text="{Binding SubContractorSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernInput}" Height="34" 
                                 ap:WatermarkProperties.Watermark="Search contractors..."/>
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding AvailableSubContractors}" 
                             Background="Transparent" BorderThickness="0" Margin="10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="5" Padding="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource VisibilityConverter}}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" Height="30" Background="{Binding Color}" CornerRadius="2" Margin="0,0,15,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Specialty}" Foreground="{StaticResource TextSub}" FontSize="11"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" Style="{StaticResource ModernCheckBox}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Padding="20" Background="#05FFFFFF">
                        <Grid>
                            <Button Content="Cancel" Command="{Binding CloseAssignPopupCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Width="100"/>
                            <Button Content="Save Assignments" Command="{Binding SaveAssignmentsCommand}" Style="{StaticResource ActionButtonPrimary}" HorizontalAlignment="Right" Width="150"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectTaskListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:local="clr-namespace:OCC.WpfClient.Features.ProjectHub.Views"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance vm:ProjectTaskListViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <conv:VisibilityConverter x:Key="VisibilityConverter" />
            <conv:LevelToIndentConverter x:Key="LevelToIndentConverter" IndentStep="30" />
            <conv:RotationConverter x:Key="RotationConverter" />

            <Style x:Key="ExpanderButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="4" Width="20" Height="20">
                                <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="LinkButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="Transparent">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Focusable" Value="False"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.8"/>
                        <Setter Property="Background" Value="#10FFFFFF"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Tool Bar -->
            <Border Grid.Row="0" Margin="10">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Project Tasks" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <Border Background="{StaticResource AccentBlue}" CornerRadius="12" Padding="10,2" Margin="15,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding TotalActionableTaskCount}" Foreground="White" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Filter Button -->
                        <Button x:Name="FilterButton" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding ToggleFilterPopupCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Filter" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                                <Border Background="{StaticResource AccentBlue}" CornerRadius="8" Padding="5,0" Margin="5,0,0,0" 
                                        Visibility="{Binding FilterSubContractorId, Converter={StaticResource VisibilityConverter}, ConverterParameter='NotNull'}">
                                     <TextBlock Text="1" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <Popup IsOpen="{Binding IsFilterPopupOpen}" PlacementTarget="{Binding ElementName=FilterButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource BackgroundCard}" BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1" CornerRadius="8" Margin="5" Padding="0" Width="280">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Background="#10FFFFFF" Padding="15,10" CornerRadius="8,8,0,0">
                                        <TextBlock Text="Filter Tasks" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>

                                    <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="10">
                                            <TextBlock Text="QUICK FILTERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="5,5,5,10"/>
                                            
                                            <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Overdue" Margin="0,2">
                                                <Grid HorizontalAlignment="Stretch" Width="240">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#FF5252" Margin="5,0,10,0"/>
                                                        <TextBlock Text="Overdue" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Background="#30FF5252" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding OverdueCount}" FontSize="10" Foreground="#FF5252" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due Today" Margin="0,2">
                                                <Grid HorizontalAlignment="Stretch" Width="240">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" Margin="5,0,10,0"/>
                                                        <TextBlock Text="Due Today" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Background="#302E9DFF" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding DueTodayCount}" FontSize="10" Foreground="{StaticResource AccentBlue}" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due This Week" Margin="0,2">
                                                <Grid HorizontalAlignment="Stretch" Width="240">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#8B5CF6" Margin="5,0,10,0"/>
                                                        <TextBlock Text="Due This Week" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Background="#308B5CF6" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding DueThisWeekCount}" FontSize="10" Foreground="#8B5CF6" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <Button Style="{StaticResource LinkButtonStyle}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due This Month" Margin="0,2">
                                                <Grid HorizontalAlignment="Stretch" Width="240">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#EC4899" Margin="5,0,10,0"/>
                                                        <TextBlock Text="Due This Month" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Border Background="#30EC4899" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding DueThisMonthCount}" FontSize="10" Foreground="#EC4899" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <Border Height="1" Background="{StaticResource GlassBorderUltraLight}" Margin="5,15"/>

                                            <TextBlock Text="SUBCONTRACTORS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="5,5,5,10"/>
                                            
                                            <ItemsControl ItemsSource="{Binding SubContractorFilters}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource LinkButtonStyle}" 
                                                                Command="{Binding DataContext.ApplySubContractorFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                                                CommandParameter="{Binding Id}" Margin="0,2">
                                                            <Grid HorizontalAlignment="Stretch" Width="240">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" Margin="5,0,10,0" FontSize="12"/>
                                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                                </StackPanel>
                                                                <Border Background="#15FFFFFF" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding TaskCount}" FontSize="10" Foreground="White" Opacity="0.7"/>
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <Button Grid.Row="2" Style="{StaticResource LinkButtonStyle}" Command="{Binding ClearFiltersCommand}" 
                                            HorizontalAlignment="Stretch" Padding="15,12" Background="#05FFFFFF">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Margin="0,0,10,0" FontSize="12"/>
                                            <TextBlock Text="Clear All Filters" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </Popup>

                        <Button Command="{Binding NewTaskCommand}" Style="{StaticResource ActionButtonPrimary}" Padding="20,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="12" Margin="0,0,10,0"/>
                                <TextBlock Text="Create Task"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats & Search Line -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="10,0,10,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- Search Icon -->
                        <ColumnDefinition Width="250" />
                        <!-- Search Box -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Stage Filter -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Filter Button -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Divider -->
                        <ColumnDefinition Width="Auto" />
                        <!-- Columns -->
                        <ColumnDefinition Width="*" />
                        <!-- Spacer -->
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" VerticalAlignment="Center" Margin="12,0,8,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernInput}" Height="34" Padding="8,0" BorderThickness="0" Background="Transparent"
                             ap:WatermarkProperties.Watermark="Search tasks..."/>

                    <!-- Stage Filter -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                        <TextBlock Text="Filter Stage:" VerticalAlignment="Center" Foreground="{StaticResource TextSub}" Margin="0,0,10,0" FontSize="11" FontWeight="Bold"/>
                        <ComboBox ItemsSource="{Binding AvailableStages}" SelectedItem="{Binding SelectedStageFilter}" Style="{StaticResource ModernComboBox}" Width="150" Height="34"/>
                    </StackPanel>

                    <!-- Filter Button -->
                    <Button x:Name="FilterButton" Grid.Column="3" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Command="{Binding ToggleFilterPopupCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Filter" VerticalAlignment="Center" Style="{StaticResource LabelText}"/>
                            <Border Background="{StaticResource AccentBlue}" CornerRadius="8" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding FilterSubContractorId, Converter={StaticResource VisibilityConverter}, ConverterParameter='NotNull'}">
                                <TextBlock Text="1" FontSize="9" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                    </Button>

                    <Popup IsOpen="{Binding IsFilterPopupOpen}" PlacementTarget="{Binding ElementName=FilterButton}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="1" CornerRadius="8" Margin="5" Padding="0" Width="280">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.5"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="#10FFFFFF" Padding="15,10" CornerRadius="8,8,0,0">
                                    <TextBlock Text="Filter Tasks" FontWeight="SemiBold" Foreground="White"/>
                                </Border>

                                <ScrollViewer Grid.Row="1" MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="5,10,0,10">
                                        <TextBlock Text="QUICK FILTERS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="5,5,5,10"/>

                                        <Button Style="{StaticResource ModernMenuButton}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Overdue" Margin="0,2">
                                            <Grid HorizontalAlignment="Stretch" Width="240">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#FF5252" Margin="5,0,10,0"/>
                                                    <TextBlock Text="Overdue" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#30FF5252" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding OverdueCount}" FontSize="10" Foreground="#FF5252" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernMenuButton}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due Today" Margin="0,2">
                                            <Grid HorizontalAlignment="Stretch" Width="240">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" Margin="5,0,10,0"/>
                                                    <TextBlock Text="Due Today" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#302E9DFF" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DueTodayCount}" FontSize="10" Foreground="{StaticResource AccentBlue}" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernMenuButton}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due This Week" Margin="0,2">
                                            <Grid HorizontalAlignment="Stretch" Width="240">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#8B5CF6" Margin="5,0,10,0"/>
                                                    <TextBlock Text="Due This Week" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#308B5CF6" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DueThisWeekCount}" FontSize="10" Foreground="#8B5CF6" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <Button Style="{StaticResource ModernMenuButton}" Command="{Binding ApplySmartFilterCommand}" CommandParameter="Due This Month" Margin="0,2">
                                            <Grid HorizontalAlignment="Stretch" Width="240">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#EC4899" Margin="5,0,10,0"/>
                                                    <TextBlock Text="Due This Month" VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <Border Background="#30EC4899" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding DueThisMonthCount}" FontSize="10" Foreground="#EC4899" FontWeight="Bold"/>
                                                </Border>
                                            </Grid>
                                        </Button>

                                        <Border Height="1" Background="{StaticResource GlassBorderUltraLight}" Margin="5,15"/>

                                        <TextBlock Text="SUBCONTRACTORS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="5,5,5,10"/>

                                        <ItemsControl ItemsSource="{Binding SubContractorFilters}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ModernMenuButton}" 
                                         Command="{Binding DataContext.ApplySubContractorFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" 
                                         CommandParameter="{Binding Id}" Margin="0,2">
                                                        <Grid HorizontalAlignment="Stretch" Width="240">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" Margin="5,0,10,0" FontSize="12"/>
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="160"/>
                                                            </StackPanel>
                                                            <Border Background="#15FFFFFF" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                                                                <TextBlock Text="{Binding TaskCount}" FontSize="10" Foreground="White" Opacity="0.7"/>
                                                            </Border>
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <Button Grid.Row="2" Style="{StaticResource ModernMenuButton}" Command="{Binding ClearFiltersCommand}" 
                                       HorizontalAlignment="Stretch" Padding="15,12" Background="#05FFFFFF">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Margin="0,0,10,0" FontSize="12"/>
                                        <TextBlock Text="Clear All Filters" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Popup>

                    <Separator Grid.Column="4" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,5" Foreground="#20FFFFFF"/>

                    <Button x:Name="ColumnsButton" Grid.Column="5" Command="{Binding ToggleColumnPickerCommand}" Style="{StaticResource GhostButton}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="COLUMNS" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Column Picker Popup -->
                    <Popup IsOpen="{Binding IsColumnPickerOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=ColumnsButton}" HorizontalOffset="-120" VerticalOffset="5">
                        <Border Background="{StaticResource AppBackground}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Width="200">
                            <StackPanel>
                                <TextBlock Text="Toggle Columns" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox Content="Start Date" IsChecked="{Binding IsStartVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="End Date" IsChecked="{Binding IsEndVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Progress" IsChecked="{Binding IsProgressVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Stage" IsChecked="{Binding IsStageVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Duration" IsChecked="{Binding IsDurationVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Assigned" IsChecked="{Binding IsAssignedVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Priority" IsChecked="{Binding IsPriorityVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- Task List -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="10,0,10,10" Padding="1">
                <Grid>
                    <DataGrid x:Name="TasksGrid"
                              ItemsSource="{Binding Tasks}"
                              SelectedItem="{Binding SelectedTask}"
                              Style="{StaticResource ModernDataGrid}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="None"
                              BorderThickness="0"
                              Background="Transparent"
                              MouseDoubleClick="OnTaskDoubleClick">
                        <DataGrid.Columns>
                            <!-- Status Icon -->
                            <DataGridTemplateColumn Header="STATUS" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Ellipse.Effect>
                                                <DropShadowEffect BlurRadius="5" Color="White" Opacity="0.2" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Badge -->
                            <DataGridTemplateColumn Header="STATUS" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#15FFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                            <Setter Property="Background" Value="#20EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                                                <Setter Property="Text" Value="OVERDUE"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Task Name with Hierarchy -->
                            <DataGridTemplateColumn Header="TASK NAME" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="{Binding IndentLevel, Converter={StaticResource LevelToIndentConverter}}">
                                            <!-- Expander Button -->
                                            <Button Style="{StaticResource ExpanderButtonStyle}" 
                                                    Command="{Binding Data.ToggleExpandCommand, Source={StaticResource Proxy}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding HasChildren, Converter={StaticResource VisibilityConverter}}"
                                                    Margin="0,0,10,0">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="8" Foreground="White" Opacity="0.7">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform Angle="{Binding IsExpanded, Converter={StaticResource RotationConverter}}" CenterX="4" CenterY="4"/>
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Button>

                                            <TextBlock Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" FontSize="13">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Dates -->
                            <DataGridTextColumn Header="START DATE" Binding="{Binding StartDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="Auto" Visibility="{Binding Data.IsStartVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                            <DataGridTextColumn Header="END DATE" Binding="{Binding FinishDate, StringFormat='{}{0:dd MMM yyyy}'}" Width="Auto" Visibility="{Binding Data.IsEndVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>

                            <!-- Progress -->
                            <DataGridTemplateColumn Header="PROGRESS" Width="Auto" MinWidth="100" Visibility="{Binding Data.IsProgressVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="5,0">
                                            <ProgressBar Value="{Binding PercentComplete}" Height="6" Background="#15FFFFFF" Foreground="{StaticResource AccentBlue}" BorderThickness="0" Template="{StaticResource ModernProgressBarTemplate}"/>
                                            <TextBlock Text="{Binding PercentComplete, StringFormat='{}{0}%'}" FontSize="8" Foreground="White" HorizontalAlignment="Right" Margin="0,-12,0,0" Opacity="0.6"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Stage -->
                            <DataGridTextColumn Header="STAGE" Binding="{Binding Status}" Width="Auto" Visibility="{Binding Data.IsStageVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>

                            <!-- Duration -->
                            <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="Auto" Visibility="{Binding Data.IsDurationVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>

                            <!-- Assigned -->
                            <DataGridTemplateColumn Header="ASSIGNED" Width="150" Visibility="{Binding Data.IsAssignedVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding Data.ShowAssignToCommand, Source={StaticResource Proxy}}" 
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource ModernMenuButton}"
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Foreground="White"
                                                Background="Transparent">
                                            <TextBlock Text="{Binding AssignedTo}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding AssignedTo}" Value="">
                                                                <Setter Property="Text" Value="Unassigned"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding AssignedTo}" Value="{x:Null}">
                                                                <Setter Property="Text" Value="Unassigned"/>
                                                                <Setter Property="Opacity" Value="0.5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Priority -->
                            <DataGridTemplateColumn Header="PRIORITY" Width="Auto" Visibility="{Binding Data.IsPriorityVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Priority}" VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Important">
                                                            <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>


                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource ModernContextMenu}">
                                <MenuItem Header="Edit Task" Command="{Binding EditTaskCommand}" CommandParameter="{Binding SelectedTask}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Add Subtask" Command="{Binding CreateSubtaskCommand}" CommandParameter="{Binding SelectedTask}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Assign To..." Command="{Binding ShowAssignToCommand}" CommandParameter="{Binding SelectedTask}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Delete Task" Command="{Binding DeleteTaskCommand}" CommandParameter="{Binding SelectedTask}" Foreground="{StaticResource ErrorRed}">
                                    <MenuItem.Icon>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="{StaticResource ErrorRed}"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>

                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasTasks, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="48" Foreground="{StaticResource TextSub}" Opacity="0.3" HorizontalAlignment="Center"/>
                        <TextBlock Text="No tasks found for this project" Foreground="{StaticResource TextSub}" FontSize="14" Margin="0,20,0,0"/>
                        <Button Content="Create Your First Task" Command="{Binding NewTaskCommand}" Style="{StaticResource GhostButton}" Margin="0,20,0,0"/>
                    </StackPanel>

                    <!-- Loading Overlay -->
                    <ContentControl Style="{StaticResource StandardLoadingOverlay}" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Task Detail Drawer (Overlay handled by TaskDetailView itself) -->
        <ContentControl Content="{Binding CurrentTaskDetail}"/>

        <!-- Assign To Popup (Overlay) -->
        <Border Background="#99000000" Visibility="{Binding IsAssignPopupOpen, Converter={StaticResource VisibilityConverter}}">
            <Border Style="{StaticResource GlassCard}" Width="400" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#10FFFFFF" Padding="20,15">
                        <Grid>
                            <TextBlock Text="Assign Task" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Command="{Binding CloseAssignPopupCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="20,15,20,0">
                        <TextBlock Text="{Binding TaskToAssign.Name}" Foreground="{StaticResource AccentBlue}" FontSize="12" FontWeight="Bold" Margin="0,0,0,15"/>
                        <TextBox Text="{Binding SubContractorSearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernInput}" Height="34" 
                                 ap:WatermarkProperties.Watermark="Search contractors..."/>
                    </StackPanel>

                    <ListBox Grid.Row="2" ItemsSource="{Binding AvailableSubContractors}" 
                             Background="Transparent" BorderThickness="0" Margin="10">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Margin="5" Padding="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#10FFFFFF"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="border" Property="Background" Value="#20FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource VisibilityConverter}}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="4" Height="30" Background="{Binding Color}" CornerRadius="2" Margin="0,0,15,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Specialty}" Foreground="{StaticResource TextSub}" FontSize="11"/>
                                    </StackPanel>
                                    <CheckBox Grid.Column="2" IsChecked="{Binding IsSelected}" Style="{StaticResource ModernCheckBox}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="3" Padding="20" Background="#05FFFFFF">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Command="{Binding CloseAssignPopupCommand}" Style="{StaticResource CancelButton}" Width="100" Margin="0,0,10,0"/>
                            <Button Content="Save Assignments" Command="{Binding SaveAssignmentsCommand}" Style="{StaticResource ActionButtonPrimary}"  Width="150"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

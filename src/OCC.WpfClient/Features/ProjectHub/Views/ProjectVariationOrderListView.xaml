<infra:ListViewBase x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectVariationOrderListView"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                    xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
                    xmlns:views="clr-namespace:OCC.WpfClient.Features.ProjectHub.Views"
                    xmlns:dialogs="clr-namespace:OCC.WpfClient.Features.ProjectHub.Dialogs"
                    xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
                    xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
                    mc:Ignorable="d" 
                    d:DesignHeight="600" d:DesignWidth="900"
                    d:DataContext="{d:DesignInstance Type=vm:ProjectVariationOrderListViewModel}"
                    IsDrawerOpen="{Binding IsOverlayActive}"
                    OverlayContent="{Binding ActiveOverlay}">

    <infra:ListViewBase.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectVariationOrderDetailViewModel}">
            <dialogs:ProjectVariationOrderDetailView />
        </DataTemplate>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
    </infra:ListViewBase.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Project Variation Orders" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="Track and manage extra-scope modifications and client variation requests." Style="{StaticResource LabelText}"/>
                </Grid>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                </StackPanel>
            </Grid>

            <!-- Stats, Filters & Search Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="10,0,10,15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══════════════════ QUICKBOOKS TOOLBAR ══════════════════ -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding LoadDataCommand}" ToolTip="Refresh Data">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Refresh" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Add Variation Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding AddVariationOrderCommand}" ToolTip="Add Variation">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Add Variation" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Print Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding PrintCommand}" ToolTip="Print Report">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SecondaryGold}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Print" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search & Filter Controls -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" Width="200" ap:WatermarkProperties.Watermark="Search variation orders..."/>
                        </StackPanel>

                        <!-- Stats -->
                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                            <Border Background="#20FFFFFF" CornerRadius="12" Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TOTAL: " FontSize="10" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Data Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="10,0,10,10" CornerRadius="0">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Visibility="{Binding Items.Count, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="80" Opacity="0.1" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="No Variation Orders Found" FontSize="18" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Grid -->
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" 
                              SelectionMode="Extended" 
                              AutoGenerateColumns="False" 
                              Style="{StaticResource ModernDataGrid}" 
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Visibility="{Binding Items.Count, Converter={StaticResource VisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=\{0:dd MMM yyyy\}}" Width="Auto" Foreground="{StaticResource TextSub}"/>
                            
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="Auto" FontWeight="SemiBold"/>
                            
                            <DataGridTextColumn Header="APPROVED BY" Binding="{Binding ApprovedBy}" Width="Auto" Foreground="{StaticResource TextSub}"/>

                            <DataGridTemplateColumn Header="STATUS" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border HorizontalAlignment="Left" CornerRadius="10" Padding="8,2" Margin="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#2060A5FA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Background" Value="#2022C55E"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                            <Setter Property="Background" Value="#20EF4444"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock TextAlignment="Center" FontSize="10" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Status}"/>
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Rejected">
                                                                <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="INVOICED" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsInvoiced}" 
                                                  Command="{Binding DataContext.ToggleInvoicedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                                  CommandParameter="{Binding}"
                                                  Style="{StaticResource ModernCheckBox}" 
                                                  HorizontalAlignment="Center" 
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Open">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Edit">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Delete">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="ap:CommandProperties.DoubleClickCommand" Value="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Loading Overlay -->
                    <Border Background="#40000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" CornerRadius="15">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</infra:ListViewBase>

<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.DailyCrewBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             xmlns:dto="clr-namespace:OCC.Shared.DTOs;assembly=OCC.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1024"
             d:DataContext="{d:DesignInstance vm:DailyCrewBuilderViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.2*"/> <!-- Clocked-in Workers -->
            <ColumnDefinition Width="16"/>    <!-- Spacing -->
            <ColumnDefinition Width="1*"/>   <!-- Deploy & Active Deployments -->
        </Grid.ColumnDefinitions>

        <!-- Left Column: Available Clocked-In Employees -->
        <Border Grid.Column="0" Style="{StaticResource GlassCard}" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Search & Controls -->
                    <RowDefinition Height="Auto"/> <!-- Stats Ribbon -->
                    <RowDefinition Height="*"/>    <!-- Scrollable list of workers -->
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="DAILY OPERATIONS" Foreground="#FFB900" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="Available Employees" Foreground="{StaticResource TextMain}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    <TextBlock Text="List of active employees and their assignment status" Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Search, Team & Select All/Clear Buttons -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                              Style="{StaticResource ModernInput}" 
                              ap:WatermarkProperties.Watermark="Search workers by name, role or status..."
                              Height="38"/>

                    <ComboBox Grid.Column="2" ItemsSource="{Binding Teams}"
                              SelectedItem="{Binding SelectedTeam}"
                              Style="{StaticResource ModernComboBox}"
                              DisplayMemberPath="Name"
                              Height="38"
                              ap:WatermarkProperties.Watermark="Select Team..."/>

                    <Button Grid.Column="4" Content="Select All" Style="{StaticResource SecondaryButton}"
                            Command="{Binding SelectAllCommand}" Padding="12,0" FontSize="12" Height="38"/>

                    <Button Grid.Column="6" Content="Clear" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearSelectionCommand}" Padding="12,0" FontSize="12" Height="38"/>
                </Grid>

                <!-- Stats Ribbon -->
                <Border Grid.Row="2" Margin="0,0,0,12" Background="#0AFFFFFF" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center">
                            <Run Text="Active employees: "/>
                            <Run Text="{Binding AvailableEmployees.Count, Mode=OneWay, FallbackValue=0}" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                        </TextBlock>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCount, FallbackValue=0}" FontWeight="Bold" Foreground="#FFB900" FontSize="14" Margin="0,0,4,0"/>
                            <TextBlock Text="selected" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Scrollable List -->
                <Grid Grid.Row="3">
                    <!-- Loading State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
                        <ProgressBar IsIndeterminate="True" Width="180" Height="4" Margin="0,0,0,10"/>
                        <TextBlock Text="Refreshing operations dashboard..." Foreground="{StaticResource TextSub}" FontSize="13"/>
                    </StackPanel>



                    <!-- Employees List -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                        <ItemsControl ItemsSource="{Binding AvailableEmployees}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SelectableDailyEmployee}">
                                    <Border Padding="12,10" Margin="0,2" CornerRadius="8" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#03FFFFFF"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource GlassBorder}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#12FFB900"/>
                                                        <Setter Property="BorderBrush" Value="#40FFB900"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#0AFFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- Avatar -->
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>    <!-- Name / Role -->
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="Auto"/> <!-- Status Tag -->
                                                <ColumnDefinition Width="16"/>
                                                <ColumnDefinition Width="Auto"/> <!-- Checkbox -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar Circle -->
                                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#334155"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                 <Setter Property="Background" Value="#FFB900"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Initials}" FontSize="13" FontWeight="Bold" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1A1A2E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Name / Role -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding FullName}" Foreground="{StaticResource TextMain}" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                                    <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="4" Background="#12EF6C00" BorderBrush="#30EF6C00" BorderThickness="1"
                                                            Visibility="{Binding IsDeployed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding DeployedProjectName, StringFormat='Already Assigned - {0}'}" 
                                                                   Foreground="#EF6C00" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                                    <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextSub}" FontSize="11"/>
                                                    <StackPanel Orientation="Horizontal" Visibility="{Binding HasTeams, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="  •  " Foreground="{StaticResource TextSub}" FontSize="11" Opacity="0.5"/>
                                                        <TextBlock Text="{Binding TeamsText}" Foreground="#FFB900" FontSize="11"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Status Tag (Unassigned vs Deployed) -->
                                            <Border Grid.Column="4" CornerRadius="4" Padding="8,4" VerticalAlignment="Center" BorderThickness="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#0F00FF88"/>
                                                        <Setter Property="BorderBrush" Value="#3000FF88"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDeployed}" Value="True">
                                                                <Setter Property="Background" Value="#12EF6C00"/>
                                                                <Setter Property="BorderBrush" Value="#30EF6C00"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Unassigned"/>
                                                            <Setter Property="Foreground" Value="#00FF88"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsDeployed}" Value="True">
                                                                    <Setter Property="Text" Value="{Binding AssignmentStatusText}"/>
                                                                    <Setter Property="Foreground" Value="#EF6C00"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Checkbox for Selection -->
                                            <CheckBox Grid.Column="6" 
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" 
                                                      IsEnabled="{Binding IsDeployed, Converter={StaticResource InverseBooleanConverter}}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Column: Deploy Control (Top) & Today's active deployments (Bottom) -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Dispatch Panel -->
                <RowDefinition Height="16"/>   <!-- Spacing -->
                <RowDefinition Height="*"/>    <!-- Active Dispatches Panel -->
            </Grid.RowDefinitions>

            <!-- Dispatch Panel -->
            <Border Grid.Row="0" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="Auto"/> <!-- Form Fields -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="DISPATCH CENTER" Foreground="#FFB900" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Deploy New Crew" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Project selector -->
                            <RowDefinition Height="Auto"/> <!-- Crew label -->
                            <RowDefinition Height="Auto"/> <!-- Dates -->
                            <RowDefinition Height="Auto"/> <!-- Options -->
                            <RowDefinition Height="Auto"/> <!-- Validation msg -->
                            <RowDefinition Height="Auto"/> <!-- Deploy button -->
                        </Grid.RowDefinitions>

                        <!-- Project Selector -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="SELECT DESTINATION PROJECT" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Projects}"
                                      SelectedItem="{Binding SelectedProject}"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="Name"
                                      Height="38"/>
                        </StackPanel>

                        <!-- Crew Label -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="CREW DESCRIPTION LABEL" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding CrewLabel, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInput}"
                                     ap:WatermarkProperties.Watermark="e.g. Concrete Layer Team"
                                     Height="38"/>
                        </StackPanel>

                        <!-- Dates (Start and End) -->
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <!-- Start Date -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DEPLOYMENT DATE" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding DeploymentDate, Mode=TwoWay}"
                                            Style="{StaticResource ModernDatePicker}"
                                            Height="38"/>
                            </StackPanel>
                            
                            <!-- End Date -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ASSIGN UNTIL (END DATE)" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                <DatePicker SelectedDate="{Binding AssignmentEndDate, Mode=TwoWay}"
                                            Style="{StaticResource ModernDatePicker}"
                                            Height="38"/>
                            </StackPanel>
                        </Grid>

                        <!-- Options -->
                        <CheckBox Grid.Row="3" Content="Exclude Weekends" IsChecked="{Binding ExcludeWeekends, Mode=TwoWay}"
                                  Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,0,0,12" VerticalAlignment="Center"/>

                        <!-- Validation Message -->
                        <TextBlock Grid.Row="4" Text="{Binding ValidationMessage}" Foreground="#EF4444" FontSize="12" Margin="0,0,0,12"
                                   Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                        <!-- Deploy Button -->
                        <Button Grid.Row="5" Style="{StaticResource CreateButton}" Content="Deploy Crew" BorderBrush="{StaticResource OrangeBrush}"
                                Command="{Binding DeployCrewCommand}" 
                                Height="40" HorizontalAlignment="Stretch">                           
                        </Button>
                    </Grid>
                </Grid>
            </Border>

            <!-- Active Dispatches Panel -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title -->
                        <RowDefinition Height="*"/>    <!-- Deployments List -->
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="ACTIVE DISPATCHES" Foreground="#FFB900" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="Today's Crew Deployments" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Scrollable Deployments List -->
                    <Grid Grid.Row="1">
                        <!-- Loading State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" Width="140" Height="3" Margin="0,0,0,8"/>
                        </StackPanel>

                        <!-- Empty State -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,45"
                                    Visibility="{Binding ActiveDeployments.Count, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Invert'}">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="{StaticResource TextSub}" Opacity="0.3" HorizontalAlignment="Center"/>
                            <TextBlock Text="No crews deployed today" Foreground="{StaticResource TextSub}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- List of Today's deployments -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Visibility="{Binding IsLoading, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                            <ItemsControl ItemsSource="{Binding ActiveDeployments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type dto:SiteDeploymentDto}">
                                        <Border Background="#06FFFFFF" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/> <!-- Details & Action -->
                                                    <RowDefinition Height="Auto"/> <!-- Members WrapPanel -->
                                                </Grid.RowDefinitions>

                                                <!-- Title, Label, and Cancel Action -->
                                                <Grid Grid.Row="0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource AccentBlue}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMain}" FontSize="12" Margin="0,1,0,0"/>
                                                    </StackPanel>

                                                    <!-- Recall/Cancel Crew Button -->
                                                    <Button Grid.Column="1" Style="{StaticResource DangerButton}"
                                                            Command="{Binding DataContext.CancelDeploymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Width="32" Height="32" ToolTip="Recall / Cancel Crew" Padding="0">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons" FontSize="13"/>
                                                    </Button>
                                                </Grid>

                                                <!-- Members Badges -->
                                                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                                                    <TextBlock Foreground="{StaticResource TextSub}" FontSize="11">
                                                        <Run Text="Deployed Workers ("/>
                                                        <Run Text="{Binding Members.Count, Mode=OneWay}" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                                        <Run Text="):"/>
                                                    </TextBlock>
                                                    
                                                    <ItemsControl ItemsSource="{Binding Members}" Margin="0,4,0,0">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal"/>
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type dto:SiteDeploymentMemberDto}">
                                                                <Border Width="26" Height="26" CornerRadius="13" Background="#2A3547" Margin="0,2,4,2" BorderThickness="1" BorderBrush="#20FFFFFF"
                                                                        ToolTipService.ToolTip="{Binding FullName}">
                                                                    <TextBlock Text="{Binding Initials}" FontSize="9" FontWeight="Bold" Foreground="White"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:converters="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="950" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance vm:ProjectReportViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/Colors.xaml"/>
                <ResourceDictionary Source="/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:FileNameConverter x:Key="FileNameConverter"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDarker}">
        <Grid.RowDefinitions>
            <!-- Header Section -->
            <RowDefinition Height="Auto"/>
            <!-- Main Content Section -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- HEADER SECTION -->
        <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Height="84" VerticalAlignment="Center">
                    <TextBlock Text="DAILY SITE PROJECT REPORT" Foreground="{StaticResource SecondaryGold}" FontSize="12" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Project.Name}" Foreground="White" FontSize="28" FontWeight="Light" Margin="0,5,0,0"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Border Background="#20FFFFFF" CornerRadius="4" Padding="8,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="WEEK " Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding WeekNumber}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding Source={x:Static System:DateTime.Today}, StringFormat='{}{0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" FontSize="12" xmlns:System="clr-namespace:System;assembly=mscorlib"/>
                        <Ellipse Width="6" Height="6" Fill="{StaticResource SuccessGreen}" Margin="15,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Project.Status}" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,20,0">
                    <Button Command="{Binding SaveCommand}" Style="{StaticResource CreateIconButton}" Margin="0,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" Margin="0,0,8,0" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Save Changes" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding PrintCommand}" Style="{StaticResource CreateIconButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolButtonIcon}"/>
                            <TextBlock Text="Generate PDF" Style="{StaticResource ButtonTextStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="30" Margin="0,10,15,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left Stats & Inputs -->
                    <ColumnDefinition Width="350"/>
                    <!-- Right Details & Photo Grid -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDE COLUMN -->
                <StackPanel Grid.Column="0" Margin="0,0,25,0">

                    <!-- Program of Works Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="PROGRAM OF WORKS" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="TASKS" Foreground="{StaticResource TextSub}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalTasks}" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                    <TextBlock Text="ACTIVE" Foreground="{StaticResource TextSub}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding InProgressTasks}" Foreground="{StaticResource AccentBlue}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="DONE" Foreground="{StaticResource TextSub}" FontSize="10" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding CompletedTasks}" Foreground="{StaticResource SuccessGreen}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Overall Progress" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,0,0,5"/>
                            <Grid>
                                <ProgressBar Value="{Binding OverallProgress}" Maximum="100" Height="8" Foreground="{StaticResource SuccessGreen}" Background="#20FFFFFF"/>
                            </Grid>
                            <TextBlock Text="{Binding OverallProgress, StringFormat='{}{0:F1}% Completed'}" Foreground="White" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Right"/>

                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="POW % REQUIRED" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="5" Height="24" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PowPercentRequired, StringFormat='{}{0:F1}%'}" Foreground="White" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="DELAY DAYS" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding DelayDays, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Safe Working Hours Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="28" Margin="0,0,15,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="SAFE WORKING HOURS" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SafeWorkingHours, StringFormat='{}{0:N0} Hours'}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Contract Dates & Milestones Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="CONTRACT DATES &amp; MILESTONES" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                            <!-- Project Dates -->
                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="Project Start Date" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,0,3"/>
                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Height="35" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Project.StartDate, StringFormat='{}{0:yyyy/MM/dd}', TargetNullValue='-'}" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="Project Finish Date" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,0,3"/>
                                    <Border Background="#10FFFFFF" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="10,8" Height="35" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Project.EndDate, StringFormat='{}{0:yyyy/MM/dd}', TargetNullValue='-'}" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- This Week's Milestones -->
                            <TextBlock Text="THIS WEEK'S MILESTONES" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,10"/>

                            <!-- No This Week Milestones Message -->
                            <TextBlock Text="No milestones scheduled for this week." 
                                       Foreground="{StaticResource TextSub}" 
                                       FontSize="12" 
                                       FontStyle="Italic"
                                       Margin="0,0,0,15"
                                       Visibility="{Binding NoThisWeekMilestones, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- This Week Milestones List -->
                            <ItemsControl ItemsSource="{Binding ThisWeekMilestones}" Visibility="{Binding HasThisWeekMilestones, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,15">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                                        <Border CornerRadius="4" Padding="4,2" Background="#15FFFFFF">
                                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding StartDate, StringFormat='Start: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding PlannedDate, StringFormat='Due: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10"/>
                                                </StackPanel>

                                                <!-- Delay Reason Input -->
                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Reason for Delay" Foreground="{StaticResource SecondaryGold}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Height="45" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Overdue Milestones -->
                            <TextBlock Text="OVERDUE MILESTONES" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,10,0,10"/>

                            <!-- No Overdue Milestones Message -->
                            <TextBlock Text="No overdue milestones." 
                                       Foreground="{StaticResource TextSub}" 
                                       FontSize="12" 
                                       FontStyle="Italic"
                                       Margin="0,0,0,10"
                                       Visibility="{Binding NoOverdueMilestones, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                            <!-- Overdue Milestones List -->
                            <ItemsControl ItemsSource="{Binding OverdueMilestones}" Visibility="{Binding HasOverdueMilestones, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Background="#08FFFFFF" BorderBrush="#10FFFFFF" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" Foreground="{StaticResource SecondaryGold}" FontSize="11" FontWeight="Bold" Margin="0,0,8,0"/>
                                                        <Border CornerRadius="4" Padding="4,2" Background="#15FFFFFF">
                                                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding StartDate, StringFormat='Start: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding PlannedDate, StringFormat='Due: {0:yyyy/MM/dd}'}" Foreground="{StaticResource TextSub}" FontSize="10"/>
                                                </StackPanel>

                                                <!-- Delay Reason Input (Always shown for overdue tasks since IsOverdue is true) -->
                                                <StackPanel Margin="0,8,0,0" Visibility="{Binding IsOverdue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="Reason for Delay" Foreground="{StaticResource SecondaryGold}" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" Height="45" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontSize="11"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Waste Disposal Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="WASTE DISPOSAL" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="General Waste (TON)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" Text="{Binding GeneralWasteTon}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Rubble (m3)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" Text="{Binding RubbleM3}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Scrap metals (TON)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" Text="{Binding ScrapMetalsTon}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Asbestos (TON)" Foreground="White" VerticalAlignment="Center" FontSize="12"/>
                                <TextBox Grid.Column="1" Text="{Binding AsbestosTon}" Style="{StaticResource TextBox.CardValue}" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Report Run History Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="REPORT RUN HISTORY" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                            <!-- No History Message -->
                            <TextBlock Text="No historical reports generated." 
                                       Foreground="{StaticResource TextSub}" 
                                       FontSize="12" 
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center" 
                                       Margin="0,10" 
                                       Visibility="{Binding ReportHistory, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"/>

                            <ItemsControl ItemsSource="{Binding ReportHistory}" Visibility="{Binding ReportHistory, Converter={StaticResource VisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Padding="0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ReportName}" Foreground="White" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding FileSize}" Foreground="{StaticResource TextSub}" FontSize="10" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" 
                                                        Command="{Binding DataContext.DownloadReportCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        Style="{StaticResource GhostButton}" 
                                                        Padding="8,4" 
                                                        FontSize="11" 
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SecondaryGold}" Margin="0,0,4,0" FontSize="12" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Open" Foreground="White" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>


                <!-- RIGHT SIDE COLUMN -->
                <StackPanel Grid.Column="1">

                    <!-- Project Status Summary Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="PROJECT STATUS SUMMARY" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Command="{Binding AutoGenerateSummaryCommand}" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SecondaryGold}" Margin="0,0,5,0" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="Auto-Generate Draft" Foreground="White" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <TextBox Text="{Binding StatusSummary, UpdateSourceTrigger=PropertyChanged}" 
                                     MinHeight="100" 
                                     AcceptsReturn="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" 
                                     Foreground="White" 
                                     Background="#10FFFFFF" 
                                     BorderBrush="{StaticResource GlassBorder}" 
                                     BorderThickness="1" 
                                     Padding="10" 
                                     CaretBrush="White" 
                                     FontSize="13"/>
                        </StackPanel>
                    </Border>

                    <!-- Vendor Report / HSEQ Compliance Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <StackPanel>
                            <StackPanel.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontSize" Value="10"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,12"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <TextBlock Text="VENDOR REPORT - HSEQ COMPLIANCE" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>
                            
                            <!-- Primary Contractor: Orange Circle Construction -->
                            <DataGrid ItemsSource="{Binding PrimaryContractorRows}" 
                                      AutoGenerateColumns="False" 
                                      Background="Transparent" 
                                      BorderThickness="0" 
                                      CanUserAddRows="False" 
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="#10FFFFFF" 
                                      RowBackground="Transparent" 
                                      AlternatingRowBackground="#05FFFFFF"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="VENDOR NAME" Binding="{Binding VendorName}" IsReadOnly="True" Width="2*"/>
                                    <DataGridTextColumn Header="SCOPE" Binding="{Binding Scope}" IsReadOnly="True" Width="1.5*"/>
                                    <DataGridTextColumn Header="SAFETY APPROVED" Binding="{Binding SafetyApproved, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="1.2*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="APP SCORE" Binding="{Binding AppScore, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="1*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="AU 1" Binding="{Binding Audit1, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="0.8*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="AU 2" Binding="{Binding Audit2, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="0.8*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="AU 3" Binding="{Binding Audit3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="0.8*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Sub-Contractors Expander (Collapsed by default, hidden if empty) -->
                            <Expander IsExpanded="False" 
                                      Background="Transparent" 
                                      BorderThickness="0" 
                                      Margin="0,10,0,0"
                                      Visibility="{Binding SubContractorRows, Converter={StaticResource VisibilityConverter}}">
                                <Expander.Style>
                                    <Style TargetType="Expander">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Expander">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*" x:Name="ContentRow"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <ToggleButton x:Name="HeaderSite"
                                                                          Grid.Row="0"
                                                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                          Background="#0AFFFFFF"
                                                                          BorderBrush="{StaticResource GlassBorderUltraLight}"
                                                                          BorderThickness="0,1,0,1"
                                                                          Padding="10,8"
                                                                          Cursor="Hand">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                Padding="{TemplateBinding Padding}">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <ContentPresenter Grid.Column="0" Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                                                                <TextBlock x:Name="Arrow" 
                                                                                           Grid.Column="1" 
                                                                                           Text="&#xE70D;" 
                                                                                           Style="{StaticResource SymbolIcon}" 
                                                                                           FontSize="10" 
                                                                                           Foreground="{StaticResource TextSub}" 
                                                                                           VerticalAlignment="Center"
                                                                                           RenderTransformOrigin="0.5,0.5">
                                                                                    <TextBlock.RenderTransform>
                                                                                        <RotateTransform Angle="0"/>
                                                                                    </TextBlock.RenderTransform>
                                                                                </TextBlock>
                                                                            </Grid>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsChecked" Value="True">
                                                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <RotateTransform Angle="180"/>
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource SecondaryGold}"/>
                                                                            </Trigger>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Arrow" Property="Foreground" Value="White"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                                <ToggleButton.Content>
                                                                    <ContentPresenter Content="{TemplateBinding Header}" />
                                                                </ToggleButton.Content>
                                                            </ToggleButton>

                                                            <ContentPresenter x:Name="ExpandSite"
                                                                              Grid.Row="1"
                                                                              Visibility="Collapsed"
                                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                              Margin="0"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsExpanded" Value="True">
                                                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Expander.Style>
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal" Margin="0,2">
                                        <TextBlock Text="Sub-Contractors" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Background="#1AFFFFFF" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SubContractorRows.Count, StringFormat='{}{0}'}" Foreground="{StaticResource SecondaryGold}" FontSize="9" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </Expander.Header>
                                <DataGrid ItemsSource="{Binding SubContractorRows}" 
                                          AutoGenerateColumns="False" 
                                          Background="Transparent" 
                                          BorderThickness="0" 
                                          CanUserAddRows="False" 
                                          GridLinesVisibility="Horizontal" 
                                          HorizontalGridLinesBrush="#10FFFFFF" 
                                          RowBackground="Transparent" 
                                          AlternatingRowBackground="#05FFFFFF"
                                          HeadersVisibility="None"
                                          Margin="0,5,0,0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="VENDOR NAME" Binding="{Binding VendorName}" IsReadOnly="True" Width="2*"/>
                                        <DataGridTextColumn Header="SCOPE" Binding="{Binding Scope}" IsReadOnly="True" Width="1.5*"/>
                                        <DataGridTextColumn Header="SAFETY APPROVED" Binding="{Binding SafetyApproved, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="1.2*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                    <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="APP SCORE" Binding="{Binding AppScore, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="1*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="AU 1" Binding="{Binding Audit1, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="0.8*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="AU 2" Binding="{Binding Audit2, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="0.8*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="AU 3" Binding="{Binding Audit3, UpdateSourceTrigger=LostFocus, Mode=TwoWay}" Width="0.8*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Expander>
                        </StackPanel>
                    </Border>

                    <!-- Variation Orders Card -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                        <StackPanel>
                            <TextBlock Text="SITE INSTRUCTIONS / VARIATION ORDERS" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" Margin="0,0,0,15"/>

                            <!-- No Variation Orders Message -->
                            <TextBlock Text="No variation orders registered for this project." 
                                       Foreground="{StaticResource TextSub}" 
                                       FontSize="13" 
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center" 
                                       Margin="0,20" 
                                       Visibility="{Binding VariationOrders, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"/>

                            <!-- Variation Orders DataGrid -->
                            <DataGrid ItemsSource="{Binding VariationOrders}" 
                                      AutoGenerateColumns="False" 
                                      Background="Transparent" 
                                      BorderThickness="0" 
                                      CanUserAddRows="False" 
                                      GridLinesVisibility="Horizontal" 
                                      HorizontalGridLinesBrush="#10FFFFFF" 
                                      RowBackground="Transparent" 
                                      AlternatingRowBackground="#05FFFFFF"
                                      HeadersVisibility="Column"
                                      Visibility="{Binding VariationOrders, Converter={StaticResource VisibilityConverter}}">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="Padding" Value="10,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#20FFFFFF"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10,12"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='{}{0:yyyy/MM/dd}'}" Width="1.2*"/>
                                    <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="3*"/>
                                    <DataGridTextColumn Header="APPROVED BY" Binding="{Binding ApprovedBy}" Width="1.5*"/>
                                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="1.5*">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="Approved">
                                                        <Setter Property="Foreground" Value="{StaticResource SuccessGreen}"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="Pending">
                                                        <Setter Property="Foreground" Value="{StaticResource SecondaryGold}"/>
                                                    </Trigger>
                                                    <Trigger Property="Text" Value="Variation Request">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="COMMENTS" Binding="{Binding AdditionalComments}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- Report & Progress Photos Card -->
                    <Border Style="{StaticResource GlassCard}" Padding="20">
                        <StackPanel>
                            <!-- Header Grid -->
                            <Grid Margin="0,0,0,15">
                                <TextBlock Text="REPORT &amp; PROGRESS PHOTOS" Foreground="{StaticResource TextSub}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                                <Button Command="{Binding UploadPhotoCommand}" Style="{StaticResource CreateIconButton}" HorizontalAlignment="Right" Height="28" Padding="10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Add Photo" Foreground="White" FontSize="11" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- No Photos Message -->
                            <TextBlock Text="No report photos uploaded yet." 
                                       Foreground="{StaticResource TextSub}" 
                                       FontSize="13" 
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center" 
                                       Margin="0,20" 
                                       Visibility="{Binding HasPhotos, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"/>

                            <!-- Photos ItemsControl -->
                            <ItemsControl ItemsSource="{Binding ReportPhotos}" Visibility="{Binding HasPhotos, Converter={StaticResource VisibilityConverter}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,15,15" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="5" Background="#10FFFFFF" Width="160" Height="120">
                                            <Grid>
                                                <!-- Image Preview (Centered, aspect ratio preserved) -->
                                                <Image Source="{Binding}" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                
                                                <!-- Custom Sleek Circle Delete Button Overlay -->
                                                <Button Command="{Binding DataContext.RemovePhotoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" 
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                        Margin="0,0,0,0" Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="bg" Background="#A0EF4444" CornerRadius="10" Width="20" Height="20">
                                                                <TextBlock Text="" FontFamily="Segoe MDL2 Assets" FontSize="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="bg" Property="Background" Value="#EF4444"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>

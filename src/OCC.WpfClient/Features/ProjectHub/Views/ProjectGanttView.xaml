<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectGanttView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OCC.WpfClient.Features.ProjectHub.Views"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:ProjectGanttViewModel}">

    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter" />
        
        <!-- Summary Task Bar Style -->
        <Style x:Key="SummaryBarStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#1E80D6" Offset="0"/>
                        <GradientStop Color="#0D47A1" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Height" Value="10"/>
            <Setter Property="CornerRadius" Value="1"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Leaf Task Bar Style -->
        <Style x:Key="LeafBarStyle" TargetType="Border">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource AccentBlueHoverColor}" Offset="0"/>
                        <GradientStop Color="{StaticResource AccentBlueColor}" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Height" Value="16"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <local:GanttMenuBarView Grid.Row="0"/>

        <!-- Main Content Layout -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Date Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
            </Grid.RowDefinitions>
            
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370" MinWidth="200"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="150"/>
            </Grid.ColumnDefinitions>

            <!-- Row 0: Headers -->
            <Border Grid.Row="0" Grid.Column="0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,1,1" Background="{StaticResource GlassBackgroundSubtle}" Height="35">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                        <!-- Draggable resize handle for PRED column -->
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="{Binding DataContext.PredColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Grid.ColumnDefinitions>
                    <!-- Row number header -->
                    <Border Grid.Column="0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,1,0" Background="Transparent">
                        <TextBlock Text="#" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Column="1" Text="TASK NAME" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" Margin="15,0"/>
                    <!-- Drag this splitter to resize the PRED column -->
                    <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="Transparent" Cursor="SizeWE"
                                  DragDelta="PredColumnSplitter_DragDelta"/>
                    <Border Grid.Column="3" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="1,0,0,0">
                        <TextBlock Text="PRED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   ToolTip="Predecessors — type row numbers (e.g. '3' or '3,5') and press Enter or click away"/>
                    </Border>
                </Grid>
            </Border>
            
            <!-- Date Headers ScrollViewer -->
            <ScrollViewer Grid.Row="0" Grid.Column="2" Name="HeaderScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Padding="10,0,15,0" Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding DateHeaders}" Width="{Binding CanvasWidth}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Height="35" Background="{StaticResource GlassBackgroundSubtle}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GanttDateHeader}">
                            <Border Width="{Binding Width}" Height="35" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,1,1">
                                <TextBlock Text="{Binding Text}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{StaticResource TextSub}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Row 1: Content -->
            <!-- Task List (Left) -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" Name="TaskListScrollViewer" HorizontalScrollBarVisibility="Auto" Padding="10,0,15,0" Margin="0,0,10,0">
                <ListBox ItemsSource="{Binding GanttTasks}" SelectedItem="{Binding SelectedTaskWrapper, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Canvas.Top" Value="{Binding RowTop}"/>
                            <Setter Property="Width" Value="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#30FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#15FFFFFF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GanttTaskWrapper}">
                            <Border x:Name="TaskRowBorder" Height="{Binding RowHeight}" BorderBrush="{StaticResource GlassBorderUltraLight}" 
                                    BorderThickness="0,0,0,1" Background="Transparent" PreviewMouseDown="TaskRow_PreviewMouseDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <!-- Spacer matching the header splitter -->
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="{Binding DataContext.PredColumnWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Row Number -->
                                    <Border Grid.Column="0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,1,0" Background="Transparent">
                                        <TextBlock Text="{Binding RowNumber}" 
                                                   VerticalAlignment="Center" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource TextSub}" FontSize="10" Opacity="0.7"/>
                                    </Border>
                                    <!-- Task Name + Expander -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="{Binding IndentMargin}">
                                        <!-- Expander Button -->
                                        <Button Style="{StaticResource ToolbarIconButton}" 
                                                Command="{Binding ToggleCommand}" 
                                                Width="20" Height="20" 
                                                Margin="5,0,5,0"
                                                Visibility="{Binding HasChildren, Converter={StaticResource VisibilityConverter}}">
                                            <Grid>
                                                <TextBlock Text="&#xE972;" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="10" Opacity="0.5"
                                                           Visibility="{Binding Task.IsExpanded, Converter={StaticResource VisibilityConverter}}"/>
                                                <TextBlock Text="&#xE974;" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="10" Opacity="0.5"
                                                           Visibility="{Binding Task.IsExpanded, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"/>
                                            </Grid>
                                        </Button>
                                        <!-- Spacer if no children -->
                                        <Border Width="30" Visibility="{Binding HasChildren, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"/>
                                        
                                        <TextBlock Text="{Binding Task.Name}" 
                                                   VerticalAlignment="Center"
                                                   Foreground="White"
                                                   FontSize="12">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                                            <Setter Property="Foreground" Value="{StaticResource AccentBlue}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Predecessors Column -->
                                    <Border Grid.Column="3" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="1,0,0,0">
                                        <TextBox x:Name="PredTextBox"
                                                 Text="{Binding PredecessorText, UpdateSourceTrigger=Explicit}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{StaticResource TextSub}"
                                                 FontSize="10"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 Padding="2"
                                                 CaretBrush="{StaticResource OrangeBrush}"
                                                 SelectionBrush="{StaticResource OrangeBrush}"
                                                 ToolTip="Type row number(s) separated by commas, e.g. '3' or '3,5'. Press Enter or click away."
                                                 LostFocus="PredTextBox_LostFocus"
                                                 KeyDown="PredTextBox_KeyDown"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ScrollViewer>
            
            <GridSplitter Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource GlassBorderUltraLight}"/>

            <!-- Gantt Chart (Right) -->
            <ScrollViewer Grid.Row="1" Grid.Column="2" Name="GanttChartScrollViewer" HorizontalScrollBarVisibility="Auto" Padding="10,1,15,1"  Margin="0,0,10,0">
                <Grid>
                    <!-- Layer 1: Background Canvas for Today Marker -->
                    <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" IsHitTestVisible="False">
                        <Line X1="{Binding TodayPosition}" Y1="0" X2="{Binding TodayPosition}" Y2="{Binding CanvasHeight}" 
                              Stroke="{StaticResource AccentBlue}" StrokeThickness="2" StrokeDashArray="2 2" Opacity="0.6"/>
                    </Canvas>

                    <!-- Layer 2: Vertical Grid Columns (Zebra Stripes) -->
                    <ItemsControl ItemsSource="{Binding DateHeaders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding ColumnLeft}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GanttDateHeader}">
                                <Border Width="{Binding Width}" 
                                        Height="{Binding DataContext.CanvasHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        BorderBrush="{StaticResource GlassBorderUltraLight}" 
                                        BorderThickness="0,0,1,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAlternate}" Value="True">
                                                    <Setter Property="Background" Value="#05FFFFFF"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Layer 3: Dependencies (visibility toggled by ShowDependencyLines) -->
                    <ItemsControl ItemsSource="{Binding Dependencies}"
                                  Visibility="{Binding DataContext.ShowDependencyLines, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GanttDependencyLine}">
                                <Canvas>
                                    <!-- Connector Line -->
                                    <Path Data="{Binding PathGeometry}" Stroke="#C0614040" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                    <!-- Arrowhead -->
                                    <Path Data="{Binding ArrowGeometry}" Fill="#C0614040" StrokeThickness="0" />
                                </Canvas>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Layer 4: Tasks -->
                    <ItemsControl ItemsSource="{Binding GanttTasks}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas Width="{Binding CanvasWidth}" Height="{Binding CanvasHeight}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                <Setter Property="Canvas.Top" Value="{Binding Top}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GanttTaskWrapper}">
                                <StackPanel Orientation="Horizontal" Height="{Binding Height}" Background="Transparent"
                                            PreviewMouseDown="TaskRow_PreviewMouseDown">
                                    <Border Width="{Binding Width}">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource LeafBarStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                                        <Setter Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#1E80D6" Offset="0"/>
                                                                    <GradientStop Color="#0D47A1" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Height" Value="10"/>
                                                        <Setter Property="CornerRadius" Value="1"/>
                                                        <Setter Property="Margin" Value="0,5,0,0"/>
                                                        <Setter Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.4"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    
                                    <TextBlock Text="{Binding LabelText}" 
                                               Foreground="White"
                                               FontSize="12"
                                               VerticalAlignment="Center"
                                               Padding="5,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSummary}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
        
        <!-- Task Detail Drawer (Overlay handled by TaskDetailView itself) -->
        <ContentControl Content="{Binding CurrentTaskDetail}"/>
    </Grid>
</UserControl>

<infra:ListViewBase x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:views="clr-namespace:OCC.WpfClient.Features.ProjectHub.Views"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance Type=vm:ProjectListViewModel}"
             IsDrawerOpen="{Binding IsOverlayActive}"
             OverlayContent="{Binding ActiveOverlay}"
             SelectedItems="{Binding SelectedItems, Mode=OneWayToSource}" DrawerWidth="900">
    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <views:ProjectDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectCreateDetailViewModel}">
            <views:ProjectCreateDetailView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="&#xEA37;" Style="{StaticResource SymbolIcon}" FontSize="36" Foreground="#5C2D91" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Projects" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="Monitor and manage all active design and construction projects." Style="{StaticResource LabelText}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Command="{Binding AddProjectCommand}" Style="{StaticResource CreateIconButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolButtonIcon}" />
                            <TextBlock Text="Create New Project" Style="{StaticResource ButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filters & Stats Line -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="10,0,10,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernInput}" Height="32" Padding="8,0" BorderThickness="0" Background="Transparent"
                             ap:WatermarkProperties.Watermark="Search projects..."/>

                    <Border Grid.Column="2" Width="1" Height="20" Background="{StaticResource GlassBorder}" Margin="15,0" VerticalAlignment="Center"/>

                    <Button Grid.Column="3" Command="{Binding LoadDataAsyncCommand}" Style="{StaticResource ToolbarIconButton}" ToolTip="Refresh Data" Margin="0,0,15,0">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="16" Opacity="0.6"/>
                    </Button>

                    <!-- Columns Selection -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                        <Grid>
                            <ToggleButton x:Name="ColumnsToggle" Style="{StaticResource ToolbarToggleButton}" Width="100" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0" Opacity="0.8"/>
                                    <TextBlock Text="COLUMNS" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </ToggleButton>
                            <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=ColumnsToggle}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,5,0,0" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="DISPLAY COLUMNS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"/>
                                        <CheckBox Content="Progress" IsChecked="{Binding IsProgressVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2"/>
                                        <CheckBox Content="Site Manager" IsChecked="{Binding IsManagerVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2"/>
                                        <CheckBox Content="Latest Update" IsChecked="{Binding IsUpdateVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2"/>
                                        <CheckBox Content="Status" IsChecked="{Binding IsStatusVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2"/>
                                        <CheckBox Content="Priority" IsChecked="{Binding IsPriorityVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,2"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- Print -->
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ToolbarButton}" Margin="10,0">
                            <StackPanel Orientation="Horizontal" Margin="10,0">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="PRINT" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>

                        <CheckBox Content="Show Archived" IsChecked="{Binding ShowDeleted}" Style="{StaticResource ModernCheckBox}" Margin="15,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Data Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="10,0,10,10" CornerRadius="0">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                Visibility="{Binding Items.Count, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="80" Opacity="0.1" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        <TextBlock Text="No Projects Found" FontSize="18" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Grid -->
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" 
                              SelectionMode="Extended" 
                              AutoGenerateColumns="False" 
                              Style="{StaticResource ModernDataGrid}" 
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              Visibility="{Binding Items.Count, Converter={StaticResource VisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="Auto" />

                            <DataGridTemplateColumn Header="PROGRESS" Width="Auto" MinWidth="150" Visibility="{Binding Data.IsProgressVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="10,0">
                                            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="6" 
                                                         Background="#1AFFFFFF" BorderThickness="0" 
                                                         Foreground="{StaticResource AccentBlue}"/>
                                            <TextBlock Text="{Binding Progress, StringFormat='{}{0}%'}" 
                                                       FontSize="10" Foreground="White" 
                                                       HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                       Margin="0,-12,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="SITE MANAGER" Width="Auto" Visibility="{Binding Data.IsManagerVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Width="30" Height="30" CornerRadius="15" Margin="20,0"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{Binding SiteManagerName, Converter={StaticResource UserColorConverter}}"
                                                ToolTip="{Binding SiteManagerName}">
                                            <TextBlock Text="{Binding SiteManagerName, Converter={StaticResource UserInitialsConverter}}" 
                                                       VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                       Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="LATEST UPDATE" Binding="{Binding LatestFinish, StringFormat='{}{0:d}'}" Width="Auto" Visibility="{Binding Data.IsUpdateVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>

                            <DataGridTemplateColumn Header="PRIORITY" Width="Auto" Visibility="{Binding Data.IsPriorityVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" Margin="10,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#1AFFFFFF"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                            <Setter Property="Background" Value="#1A9CA3AF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                            <Setter Property="Background" Value="#1A2E9DFF"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="High">
                                                            <Setter Property="Background" Value="#1AFF8F00"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                            <Setter Property="Background" Value="#1AFF4B4B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Priority}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Low">
                                                                <Setter Property="Foreground" Value="#9CA3AF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Medium">
                                                                <Setter Property="Foreground" Value="#2E9DFF"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="High">
                                                                <Setter Property="Foreground" Value="#FF8F00"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Priority}" Value="Critical">
                                                                <Setter Property="Foreground" Value="#FF4B4B"/>
                                                                <Setter Property="FontWeight" Value="Bold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="STATUS" Width="Auto" Visibility="{Binding Data.IsStatusVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="#1AFFFFFF" Padding="8,4" CornerRadius="4" HorizontalAlignment="Left" Margin="10,0">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource FriendlyEnumConverter}}" Foreground="White" FontSize="12"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Open Project Dashboard"
                                                        Visibility="{Binding IsActive, Converter={StaticResource VisibilityConverter}}">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="14" Opacity="0.8"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Edit"
                                                        Visibility="{Binding IsActive, Converter={StaticResource VisibilityConverter}}">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.RestoreProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Restore Project"
                                                        Visibility="{Binding IsActive, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="14"/>
                                            </Button>
                                            <Button Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Delete / Archive">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="ap:CommandProperties.DoubleClickCommand" 
                                             Value="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                                <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Loading Overlay -->
                    <Border Background="#40000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" CornerRadius="15">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</infra:ListViewBase>

<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.CreateProjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:models="clr-namespace:OCC.WpfClient.Features.ProjectHub.Models"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:CreateProjectViewModel}">

    <Grid Margin="20" Background="{StaticResource CardBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Form -->
        <Grid Grid.Column="0" Margin="0,0,30,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,25">
                <TextBlock Text="{Binding Title}" FontSize="26" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Quickly create maintenance jobs or comprehensive projects." 
                           FontSize="14" Foreground="{StaticResource TextSub}"/>
            </StackPanel>

            <!-- Mode Switcher -->
            <Border Grid.Row="1" Background="{StaticResource InputBackground}" 
                    CornerRadius="10" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource PremiumRadioButtonStyle}" Content="Job (Quick)" 
                                 IsChecked="{Binding CreationMode, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ProjectCreationMode.Quick}}"/>
                    <RadioButton Style="{StaticResource PremiumRadioButtonStyle}" Content="Full Project" 
                                 IsChecked="{Binding CreationMode, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ProjectCreationMode.Comprehensive}}"/>
                </StackPanel>
            </Border>

            <!-- Form Body -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="PROJECT NAME" Style="{StaticResource FormLabelText}"/>
                    <TextBox Text="{Binding Project.Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" 
                             Style="{StaticResource ModernInput}" Margin="0,0,0,20"
                             ap:WatermarkProperties.Watermark="e.g. Engen Bendor"/>

                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CUSTOMER" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" Style="{StaticResource ModernComboBox}" DisplayMemberPath="Name" ap:WatermarkProperties.Watermark="Select..."/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="SITE MANAGER" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding SiteManagers}" SelectedItem="{Binding SelectedSiteManager}" Style="{StaticResource ModernComboBox}" DisplayMemberPath="DisplayName" ap:WatermarkProperties.Watermark="Assign..."/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="SHORT DESCRIPTION" Style="{StaticResource FormLabelText}"/>
                    <TextBox Text="{Binding Project.Description}" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Style="{StaticResource ModernInput}" Margin="0,0,0,20"
                             ap:WatermarkProperties.Watermark="Quick overview..."/>

                    <Border BorderBrush="{StaticResource GlassBorderMedium}" BorderThickness="0,1,0,0" Padding="0,20,0,10" Margin="0,10,0,10">
                        <TextBlock Text="SITE LOCATION" Style="{StaticResource FormLabelText}" FontWeight="Bold" Foreground="{StaticResource AccentBlue}"/>
                    </Border>

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="STREET ADDRESS" Style="{StaticResource FormLabelText}"/>
                        <Grid>
                            <TextBox x:Name="AddressBox" Text="{Binding Project.StreetLine1, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Search address..."/>
                            <Popup IsOpen="{Binding AddressSuggestions.Count, Converter={StaticResource CollectionToBooleanConverter}, Mode=OneWay}" PlacementTarget="{Binding ElementName=AddressBox}" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Width="300" MaxHeight="200">
                                    <ListBox ItemsSource="{Binding AddressSuggestions}" SelectedItem="{Binding SelectedAddressSuggestion}" Background="Transparent" BorderThickness="0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Description}" Foreground="White" Padding="12,8"/>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </StackPanel>

                    <Border Visibility="{Binding IsComprehensiveMode, Converter={StaticResource BooleanToVisibilityConverter}}" Background="#1A3B82F6" BorderBrush="#803B82F6" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="32" Margin="0,0,20,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Import from MS Project" FontWeight="Bold" Foreground="White" FontSize="14"/>
                                <TextBlock Text="Load tasks from .xml" Foreground="{StaticResource TextSub}" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Browse..." Command="{Binding BrowseImportCommand}" Style="{StaticResource ActionButtonSecondary}" Height="32" Padding="15,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Vertical" Margin="0,20,0,0">
                <Button Command="{Binding CreateProjectCommand}" Content="CREATE PROJECT" Style="{StaticResource ActionButtonPrimary}" Height="45" Margin="0,0,0,10"/>
                <Button Command="{Binding CloseCommand}" Content="CANCEL" Style="{StaticResource ActionButtonSecondary}" Height="45"/>
            </StackPanel>
        </Grid>

        <!-- Right Panel: Comprehensive Details -->
        <Border Grid.Column="1" Width="350" Background="#05FFFFFF" 
                BorderBrush="{StaticResource GlassBorderMedium}" 
                BorderThickness="1,0,0,0" Padding="15,15,10,15"
                Visibility="{Binding IsComprehensiveMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel  Margin="0,0,15,0">
                    <TextBlock Text="Detailed Configuration" FontSize="18" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,25"/>

                    <TextBlock Text="STATUS" Style="{StaticResource FormLabelText}"/>
                    <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Project.Status}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20"/>

                    <TextBlock Text="PRIORITY" Style="{StaticResource FormLabelText}"/>
                    <ComboBox ItemsSource="{Binding Priorities}" SelectedItem="{Binding Project.Priority}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20"/>

                    <TextBlock Text="PROJECT DATES" Style="{StaticResource FormLabelText}"/>
                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker SelectedDate="{Binding Project.StartDate}" Style="{StaticResource ModernDatePicker}"/>
                        <DatePicker Grid.Column="2" SelectedDate="{Binding Project.EndDate}" Style="{StaticResource ModernDatePicker}"/>
                    </Grid>

                    <TextBlock Text="LOCALITY DETAILS" Style="{StaticResource FormLabelText}"/>
                    <TextBox Text="{Binding Project.StreetLine2}" Style="{StaticResource ModernInput}" Margin="0,0,0,10" ap:WatermarkProperties.Watermark="Unit / Floor"/>
                    <TextBox Text="{Binding Project.City}" Style="{StaticResource ModernInput}" Margin="0,0,0,10" ap:WatermarkProperties.Watermark="City"/>
                    <TextBox Text="{Binding Project.PostalCode}" Style="{StaticResource ModernInput}" Margin="0,0,0,25" ap:WatermarkProperties.Watermark="Postal Code"/>

                    <TextBlock Text="REFERENCE CODE" Style="{StaticResource FormLabelText}"/>
                    <TextBox Text="{Binding Project.ShortName}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="PROJ-001"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Reconciliation Overlay (In-Drawer) -->
        <Border Grid.ColumnSpan="2" Background="{StaticResource BackgroundDark}" Visibility="{Binding IsReconciling, Converter={StaticResource BooleanToVisibilityConverter}}" Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,25">
                    <TextBlock Text="Assignee Reconciliation" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Map imported project resources to system records." Foreground="{StaticResource TextSub}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding ReconciliationRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ImportedName}" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                            <RadioButton Content="Map" IsChecked="{Binding Action, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ReconciliationAction.MapToExisting}}" Style="{StaticResource PremiumRadioButtonStyle}" Margin="0,0,15,0"/>
                                            <RadioButton Content="Create" IsChecked="{Binding Action, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ReconciliationAction.CreateNew}}" Style="{StaticResource PremiumRadioButtonStyle}" Margin="0,0,15,0"/>
                                            <RadioButton Content="Skip" IsChecked="{Binding Action, Converter={StaticResource EqualityConverter}, ConverterParameter={x:Static models:ReconciliationAction.Skip}}" Style="{StaticResource PremiumRadioButtonStyle}"/>
                                        </StackPanel>
                                        <ComboBox ItemsSource="{Binding SuggestedMatches}" SelectedItem="{Binding SelectedMatch}" Visibility="{Binding IsMapped, Converter={StaticResource VisibilityConverter}}" Style="{StaticResource ModernComboBox}" DisplayMemberPath="DisplayName"/>
                                        
                                        <Grid Visibility="{Binding IsNew, Converter={StaticResource VisibilityConverter}}" Margin="0,15,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="20"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="EMAIL" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding Email}" Style="{StaticResource ModernInput}" Height="35"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="PHONE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding Phone}" Style="{StaticResource ModernInput}" Height="35"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                                                <TextBlock Text="BRANCH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding Branch}" Style="{StaticResource ModernInput}" Height="35"/>
                                            </StackPanel>
                                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                                <TextBlock Text="SPECIALTIES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding Specialties}" Style="{StaticResource ModernInput}" Height="35"/>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
                                                <TextBlock Text="ADDRESS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,5"/>
                                                <TextBox Text="{Binding Address}" Style="{StaticResource ModernInput}" Height="35"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Row="2" Command="{Binding ConfirmReconciliationCommand}" Content="APPLY MAPPINGS" Style="{StaticResource ActionButtonPrimary}" Height="45" Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>

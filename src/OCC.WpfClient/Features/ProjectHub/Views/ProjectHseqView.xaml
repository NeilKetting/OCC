<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectHseqView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance vm:ProjectHseqViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Tab Header Bar -->
        <Border Grid.Row="0" Background="#0AFFFFFF" BorderBrush="#15FFFFFF" BorderThickness="0,0,0,1" Padding="20,0">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource MenuTabButton}" Content="Documents" IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Documents}"
                             Command="{Binding ShowDocumentsCommand}" Padding="16,12" Margin="0,0,4,0"/>
                <RadioButton Style="{StaticResource MenuTabButton}" Content="Incidents" IsChecked="{Binding ActiveTab, Converter={StaticResource EqualityConverter}, ConverterParameter=Incidents}"
                             Command="{Binding ShowIncidentsCommand}" Padding="16,12" Margin="0,0,4,0"/>
            </StackPanel>
        </Border>

        <!-- Sub View -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</UserControl>

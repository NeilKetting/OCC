<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.CrewBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d"
             d:DesignHeight="620" d:DesignWidth="660"
             d:DataContext="{d:DesignInstance vm:CrewBuilderViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource GlassCard}" Width="640" Padding="0" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Crew Label + Date -->
                <RowDefinition Height="Auto"/>  <!-- Search + count -->
                <RowDefinition Height="*"/>     <!-- Employee List -->
                <RowDefinition Height="Auto"/>  <!-- Validation + Actions -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#0AFFFFFF" BorderBrush="#10FFFFFF" BorderThickness="0,0,0,1" Padding="24,16" CornerRadius="16,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="BUILD CREW" Foreground="#FFB900" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ProjectName}" Foreground="{StaticResource TextMain}" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource IconButtonSmall}" Command="{Binding CancelCommand}" VerticalAlignment="Top">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Crew Label Field -->
            <Grid Grid.Row="1" Margin="24,16,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CREW LABEL" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding CrewLabel, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernInput}"
                             ap:WatermarkProperties.Watermark="e.g. Tilers — Morning Shift"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Text="DATE" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding DeploymentDate, StringFormat='{}{0:dd MMM yyyy}'}" 
                               Foreground="{StaticResource TextMain}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Bottom"/>
                </StackPanel>
            </Grid>

            <!-- Search + Selection Actions -->
            <Grid Grid.Row="2" Margin="24,12,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="&#xE721;  Search by name or role..."/>

                <Button Grid.Column="2" Content="Select All" Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectAllCommand}" Padding="10,6" FontSize="12"/>

                <Button Grid.Column="4" Content="Clear" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearSelectionCommand}" Padding="10,6" FontSize="12"/>
            </Grid>

            <!-- Info Row -->
            <Border Grid.Row="2" Margin="24,50,24,0" Background="#0AFFFFFF" CornerRadius="6" Padding="12,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Foreground="{StaticResource TextSub}" FontSize="11">
                        <Run Text="Auto-clocked employees available today: "/>
                        <Run Text="{Binding AvailableEmployees.Count}" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    </TextBlock>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedCount}" FontWeight="Bold" Foreground="#FFB900" FontSize="13" Margin="0,0,4,0"/>
                        <TextBlock Text=" selected" Foreground="{StaticResource TextSub}" FontSize="11" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Employee List -->
            <Border Grid.Row="3" Margin="24,8,24,0" Background="#05FFFFFF" CornerRadius="8" MaxHeight="280">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                    <Grid>
                        <!-- Loading state -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Visibility="{Binding IsLoadingEmployees, Converter={StaticResource VisibilityConverter}}">
                            <ProgressBar IsIndeterminate="True" Width="200" Height="3" Margin="0,0,0,8" Foreground="{StaticResource AccentBlue}"/>
                            <TextBlock Text="Loading clocked-in employees..." Foreground="{StaticResource TextSub}" FontSize="12" HorizontalAlignment="Center"/>
                        </StackPanel>
 
                        <ItemsControl ItemsSource="{Binding AvailableEmployees}"
                                      Visibility="{Binding IsLoadingEmployees, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SelectableEmployee}">
                                    <Border Padding="12,8" Margin="0,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Setter Property="CornerRadius" Value="6"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="#12FFB900"/>
                                                    </DataTrigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#08FFFFFF"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Avatar -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#334155"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="#FFB900"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Initials}" FontSize="12" FontWeight="Bold" 
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="White"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter Property="Foreground" Value="#1A1A2E"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Name + Role -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FullName}" Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="Medium"/>
                                                <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextSub}" FontSize="11"/>
                                            </StackPanel>

                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="3" IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- Footer: Validation + Buttons -->
            <Border Grid.Row="4" Padding="24,16" BorderBrush="#10FFFFFF" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Validation Message -->
                    <TextBlock Grid.Row="0" Text="{Binding ValidationMessage}" Foreground="#EF4444" FontSize="12"
                               Margin="0,0,0,10" Visibility="{Binding ValidationMessage, Converter={StaticResource StringToVisibilityConverter}}"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Command="{Binding CancelCommand}" Padding="18,9" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendToSiteCommand}" Padding="24,9">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C3;" FontFamily="Segoe Fluent Icons" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding SelectedCount, StringFormat='Send {0} to Site'}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.ProjectHub.Views.ProjectVariationOrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.ProjectHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="550"
             d:DataContext="{d:DesignInstance Type=vm:ProjectVariationOrderDetailViewModel}">

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderText}" FontSize="20"/>
                        <TextBlock Text="Manage project variation requests and approvals" Style="{StaticResource LabelText}" Opacity="0.7"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource WindowCloseButton}" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0" Padding="0,0,0,0">
                <StackPanel Margin="0,0,20,0">
                    
                    <!-- Section: General Details -->
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Variation Details" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource AccentBlue}"/>
                        </StackPanel>

                        <!-- Description Input -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Description" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Wrapper.Description, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInput}" 
                                     Padding="3"
                                     Height="80" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     VerticalContentAlignment="Top"
                                     ap:WatermarkProperties.Watermark="Enter description of variation..." />
                        </StackPanel>

                        <!-- Approved By Input -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Approved By" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Wrapper.ApprovedBy, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInput}" 
                                     ap:WatermarkProperties.Watermark="Enter who approved or requested the change..." />
                        </StackPanel>

                        <!-- Date Picker -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Date" Style="{StaticResource FormLabelText}"/>
                            <DatePicker SelectedDate="{Binding Wrapper.Date}" 
                                        Style="{StaticResource ModernDatePicker}" />
                        </StackPanel>

                        <!-- Status ComboBox -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Status" Style="{StaticResource FormLabelText}"/>
                            <ComboBox SelectedValue="{Binding Wrapper.Status}" 
                                      SelectedValuePath="Content" 
                                      Style="{StaticResource ModernComboBox}" 
                                      Height="36">
                                <ComboBoxItem Content="Variation Request"/>
                                <ComboBoxItem Content="Approved"/>
                                <ComboBoxItem Content="Rejected"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Invoiced Toggle -->
                        <Border Background="#08FFFFFF" CornerRadius="12" Padding="15" Margin="0,10,0,10">
                            <CheckBox IsChecked="{Binding Wrapper.IsInvoiced}" Style="{StaticResource ModernToggleSwitch}">
                                <TextBlock Text="Mark as Invoiced" Foreground="White" VerticalAlignment="Center"/>
                            </CheckBox>
                        </Border>

                        <!-- Additional Comments Input -->
                        <StackPanel Margin="0,10,0,12">
                            <TextBlock Text="Additional Comments" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Wrapper.AdditionalComments, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource ModernInput}" 
                                     Padding="3"                                     
                                     Height="100" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     VerticalContentAlignment="Top"
                                     ap:WatermarkProperties.Watermark="Add any relevant comments or background information..." />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Validation Summary -->
                    <Border Margin="0,0,0,15" Background="#1AEE4444" BorderBrush="{StaticResource ErrorRed}" 
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasErrors, Converter={StaticResource VisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorRed}" FontSize="12" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid>
                        <!-- Print Button -->
                        <Button HorizontalAlignment="Left" Style="{StaticResource ActionButtonSecondary}" Command="{Binding PrintCommand}" Width="120" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="Print" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Cancel / Save Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="0,0,8,0"/>
                            <Button Content="Save" Style="{StaticResource ActionButtonPrimary}" Command="{Binding SaveCommand}" Width="140" Height="40"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#CC000000" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.EmployeeHub.Views.BulkRaiseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.EmployeeHub.ViewModels"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=vm:BulkRaiseViewModel}">

    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Input / Control Section -->
                <RowDefinition Height="*"/>    <!-- Preview Grid -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Bulk Wage Increase" Style="{StaticResource HeaderText}" FontSize="20"/>
                        <TextBlock Text="Apply a percentage rate raise to all active hourly employees." Style="{StaticResource LabelText}" Opacity="0.7"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource WindowCloseButton}" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Input Section -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,12" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Orientation="Vertical" Width="150" Margin="0,0,20,0">
                        <TextBlock Text="Percentage Increase (%)" Style="{StaticResource FormLabelText}"/>
                        <TextBox Text="{Binding IncreasePercentage, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernInput}" 
                                 ap:WatermarkProperties.Watermark="e.g. 6.0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Preview &amp; Select Employees" Style="{StaticResource SectionHeaderText}" Margin="0,0,0,4"/>
                        <TextBlock Text="Modify the percentage on the left to see new rates update dynamically. Uncheck any employees you want to exclude from the raise." Style="{StaticResource LabelText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="2" Margin="0,0,0,15">
                <DataGrid ItemsSource="{Binding Previews}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                          ScrollViewer.VerticalScrollBarVisibility="Auto" 
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <!-- Select Checkbox Column -->
                        <DataGridTemplateColumn Width="50" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" 
                                              Style="{StaticResource ModernCheckBox}" 
                                              HorizontalAlignment="Center" 
                                              VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Employee Info -->
                        <DataGridTextColumn Header="BAS #" Binding="{Binding EmployeeNumber}" Width="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding Name}" Width="*" IsReadOnly="True" FontWeight="Bold"/>
                        
                        <!-- Old Rate -->
                        <DataGridTextColumn Header="OLD RATE" Binding="{Binding OldRate, StringFormat='R {0:F2}'}" Width="120" IsReadOnly="True" Foreground="{StaticResource TextSub}"/>
                        
                        <!-- New Rate -->
                        <DataGridTextColumn Header="NEW RATE" Binding="{Binding NewRate, StringFormat='R {0:F2}'}" Width="120" IsReadOnly="True" Foreground="{StaticResource SuccessGreen}" FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="3" Padding="0,20,0,0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                <Grid>
                    <Button HorizontalAlignment="Left" Style="{StaticResource PrintButton}" Command="{Binding PrintCommand}" Content="Print Preview" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="0,0,10,0"/>
                        <Button Content="Apply Raise" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}" Width="130"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#CC000000" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<utils:ListViewBase x:Class="OCC.WpfClient.Features.EmployeeHub.Views.EmployeeListView"
                IsDrawerOpen="{Binding IsOverlayActive}"
                OverlayContent="{Binding OverlayViewModel}"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:vm="clr-namespace:OCC.WpfClient.Features.EmployeeHub.ViewModels"
               xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
               xmlns:utils="clr-namespace:OCC.WpfClient.Infrastructure"
               xmlns:views="clr-namespace:OCC.WpfClient.Features.EmployeeHub.Views"
               xmlns:dialogs="clr-namespace:OCC.WpfClient.Features.EmployeeHub.Dialogs"
               xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
               mc:Ignorable="d" 
               d:DesignHeight="800" d:DesignWidth="1200"
               d:DataContext="{d:DesignInstance Type=vm:EmployeeListViewModel}">

    <UserControl.Resources>
        <infra:VisibilityConverter x:Key="VisibilityConverter" />
        <utils:BindingProxy x:Key="BindingProxy" Data="{Binding}" />

        <DataTemplate DataType="{x:Type vm:EmployeeDetailViewModel}">
            <views:EmployeeDetailView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:BulkRaiseViewModel}">
            <dialogs:BulkRaiseView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0" Background="{StaticResource AppBackground}">
        <!-- Main Background Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="&#xE77B;" Style="{StaticResource SymbolIcon}" FontSize="36" Foreground="#FFFF00" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Employee Overview" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="Manage staff records and teams." Style="{StaticResource LabelText}"/>
                </Grid>
            </Grid>

            <!-- Compact Filters & Stats Line (Redesigned as QuickBooks Toolbar Card) -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══════════════════ QUICKBOOKS TOOLBAR ══════════════════ -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding LoadDataCommand}" ToolTip="Refresh Data">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Refresh" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Add Employee Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding AddEmployeeCommand}" ToolTip="Add New Employee">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Add Employee" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Bulk Raise Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding BulkRaiseCommand}" ToolTip="Bulk Wage Increase">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE706;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="#FB923C" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Bulk Raise" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Print Button -->
                            <Button x:Name="PrintBtn" Style="{StaticResource QuickBooksToolbarButtonStyle}" ap:ButtonProperties.OpenContextMenuOnClick="True" ToolTip="Print Report" ContextMenuService.IsEnabled="False">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SecondaryGold}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Print" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <MenuItem Header="Standard Employee Report" Command="{Binding PrintCommand}" Style="{StaticResource ModernMenuItem}"/>
                                        <MenuItem Header="Foreign Nationals Passport Report" Command="{Binding PrintForeignNationalsCommand}" Style="{StaticResource ModernMenuItem}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Columns Toggle Button -->
                            <ToggleButton x:Name="ColumnsBtn" Style="{StaticResource QuickBooksToolbarToggleButtonStyle}" ToolTip="Show/Hide Columns">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE136;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Columns" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </ToggleButton>

                            <!-- Column Picker Popup -->
                            <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsBtn}" StaysOpen="False" PlacementTarget="{Binding ElementName=ColumnsBtn}" Placement="Bottom" AllowsTransparency="True" HorizontalOffset="-60" VerticalOffset="5">
                                <Border Background="{StaticResource BackgroundDarker}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Width="200">
                                    <ScrollViewer MaxHeight="400">
                                        <StackPanel>
                                            <TextBlock Text="DISPLAY COLUMNS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"/>

                                            <TextBlock Text="Core" Style="{StaticResource FormLabelText}"/>
                                            <CheckBox Content="Number" IsChecked="{Binding IsNumberVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Position" IsChecked="{Binding IsPositionVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Type" IsChecked="{Binding IsTypeVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Branch" IsChecked="{Binding IsBranchVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>

                                            <TextBlock Text="Personal" Style="{StaticResource FormLabelText}"/>
                                            <CheckBox Content="Phone" IsChecked="{Binding IsPhoneVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Email" IsChecked="{Binding IsEmailVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="ID Number" IsChecked="{Binding IsIdNumberVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>

                                            <TextBlock Text="Finance" Style="{StaticResource FormLabelText}"/>
                                            <CheckBox Content="Rate Type" IsChecked="{Binding IsRateTypeVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Hourly Rate" IsChecked="{Binding IsHourlyRateVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Tax Number" IsChecked="{Binding IsTaxNumberVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Bank" IsChecked="{Binding IsBankNameVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>

                                            <TextBlock Text="Status &amp; Dates" Style="{StaticResource FormLabelText}"/>
                                            <CheckBox Content="Leave" IsChecked="{Binding IsLeaveBalanceVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Start Date" IsChecked="{Binding IsEmploymentDateVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Shift Start" IsChecked="{Binding IsShiftStartVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                            <CheckBox Content="Shift End" IsChecked="{Binding IsShiftEndVisible}" Command="{Binding SaveLayoutCommand}" Foreground="White" Margin="0,2"/>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>

                    <!-- Search & Filters Row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="180" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" ap:WatermarkProperties.Watermark="Search staff..." VerticalAlignment="Center"/>

                        <!-- Filters -->
                        <StackPanel Orientation="Horizontal" Grid.Column="2" VerticalAlignment="Center" Margin="15,0">
                            <ComboBox SelectedIndex="{Binding SelectedFilterIndex}" Height="30" Style="{StaticResource ModernComboBox}" Margin="0,0,10,0">
                                <ComboBoxItem Content="All Types" />
                                <ComboBoxItem Content="Permanent" />
                                <ComboBoxItem Content="Contract" />
                            </ComboBox>

                            <ComboBox SelectedIndex="{Binding SelectedBranchFilterIndex}" 
                                      Height="30" Style="{StaticResource ModernComboBox}" Margin="0,0,10,0">
                                <ComboBoxItem Content="All Branches" />
                                <ComboBoxItem Content="Johannesburg" />
                                <ComboBoxItem Content="Cape Town" />
                            </ComboBox>

                            <ComboBox SelectedIndex="{Binding SelectedStatusFilterIndex}" 
                                      Height="30" Style="{StaticResource ModernComboBox}" Margin="0,0,10,0">
                                <ComboBoxItem Content="Active Only" />
                                <ComboBoxItem Content="Inactive Only" />
                                <ComboBoxItem Content="All Statuses" />
                            </ComboBox>

                            <ComboBox SelectedIndex="{Binding SelectedSalaryTypeFilterIndex}" 
                                      Height="30" Style="{StaticResource ModernComboBox}">
                                <ComboBoxItem Content="All Salary Types" />
                                <ComboBoxItem Content="Hourly" />
                                <ComboBoxItem Content="Monthly Salary" />
                            </ComboBox>
                        </StackPanel>

                        <!-- Stats -->
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#20FFFFFF" CornerRadius="12" Padding="10,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="TOTAL: " FontSize="10" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding TotalCount}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Employee Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="2" HorizontalAlignment="Stretch" Margin="10,0,10,10" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NUMBER" Binding="{Binding EmployeeNumber}" Width="Auto" Visibility="{Binding Data.IsNumberVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" FontWeight="SemiBold" />
                        <DataGridTemplateColumn Header="EMPLOYEE" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#EF4444" FontSize="14" Margin="5,0,0,0" ToolTip="Passport stamp expires soon or stamp date is not set!"
                                                   Visibility="{Binding IsPassportStampExpired, Converter={StaticResource VisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="POSITION" Binding="{Binding Role, Converter={StaticResource FriendlyEnumConverter}}" Width="Auto" Visibility="{Binding Data.IsPositionVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" Foreground="{StaticResource AccentBlue}" />
                        <DataGridTextColumn Header="TYPE" Binding="{Binding EmploymentType, Converter={StaticResource FriendlyEnumConverter}}" Width="Auto" Visibility="{Binding Data.IsTypeVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="Auto" Visibility="{Binding Data.IsBranchVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" Foreground="{StaticResource TextSub}" />
                        <DataGridTextColumn Header="PHONE" Binding="{Binding Phone}" Width="Auto" Visibility="{Binding Data.IsPhoneVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="EMAIL" Binding="{Binding Email}" Width="Auto" Visibility="{Binding Data.IsEmailVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="ID NUMBER" Binding="{Binding IdNumber}" Width="Auto" Visibility="{Binding Data.IsIdNumberVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="RATE TYPE" Binding="{Binding RateType, Converter={StaticResource FriendlyEnumConverter}}" Width="Auto" Visibility="{Binding Data.IsRateTypeVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="RATE" Binding="{Binding HourlyRate, StringFormat='R {0:N2}'}" Width="Auto" Visibility="{Binding Data.IsHourlyRateVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="TAX #" Binding="{Binding TaxNumber}" Width="Auto" Visibility="{Binding Data.IsTaxNumberVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="BANK" Binding="{Binding BankName}" Width="Auto" Visibility="{Binding Data.IsBankNameVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="LEAVE" Binding="{Binding LeaveBalance, StringFormat=\{0:N1\}}" Width="Auto" Visibility="{Binding Data.IsLeaveBalanceVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="START DATE" Binding="{Binding EmploymentDate, StringFormat=d}" Width="Auto" Visibility="{Binding Data.IsEmploymentDateVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="SHIFT START" Binding="{Binding ShiftStartTime, StringFormat={}{0:hh\:mm}}" Width="Auto" Visibility="{Binding Data.IsShiftStartVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTextColumn Header="SHIFT END" Binding="{Binding ShiftEndTime, StringFormat={}{0:hh\:mm}}" Width="Auto" Visibility="{Binding Data.IsShiftEndVisible, Source={StaticResource BindingProxy}, Converter={StaticResource VisibilityConverter}}" />
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Open Details">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="14"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Edit">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="14"/>
                                        </Button>
                                        <Button Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Delete">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ap:CommandProperties.DoubleClickCommand" Value="{Binding DataContext.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                        </Style>
                    </DataGrid.RowStyle>
                </DataGrid>
            </Border>

            <!-- Loading Overlay -->
            <Border Grid.RowSpan="3" Background="#80000000" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                    <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</utils:ListViewBase>



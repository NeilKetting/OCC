<UserControl x:Class="OCC.WpfClient.Features.Admin.Users.Views.UserDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.Admin.Users.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="550"
             d:DataContext="{d:DesignInstance Type=vm:UserDetailViewModel}">

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="User Profile" Style="{StaticResource HeaderText}" FontSize="20"/>
                        <TextBlock Text="Manage identity and security permissions" Style="{StaticResource LabelText}" Opacity="0.7"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource WindowCloseButton}" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0" Padding="0,0,0,0">
                <StackPanel Margin="0,0,20,0">
                    <!-- Personal Details -->
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="&#xE946;" Style="{StaticResource SymbolSectionIcon}" Foreground="{StaticResource AccentBlue}"/>
                            <TextBlock Text="Personal Information" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource AccentBlue}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="15" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="First Name" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Last Name" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Email Address" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" IsEnabled="{Binding IsNew}"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Phone Number" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0" Visibility="{Binding ShowCompanyName, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Company Name" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}"/>
                        </StackPanel>

                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="Branch / Location" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding Branches}" SelectedItem="{Binding SelectedBranch}" Style="{StaticResource ModernComboBox}" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource FriendlyEnumConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </StackPanel>

                    <!-- Account Security -->
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="" Style="{StaticResource SymbolSectionIcon}" Foreground="{StaticResource AlertOrange}"/>
                            <TextBlock Text="Account Security" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource AlertOrange}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Access Role" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Style="{StaticResource ModernComboBox}" Height="36">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource FriendlyEnumConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Password Reset" Style="{StaticResource FormLabelText}"/>
                            <PasswordBox Style="{StaticResource ModernPasswordInput}" Height="36"
                                         infra:PasswordHelper.Attach="True"
                                         infra:PasswordHelper.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="Leave empty to maintain current password." 
                                       Style="{StaticResource LabelText}" FontSize="11" Opacity="0.5" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Status & Access -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="&#xF439;" Style="{StaticResource SymbolSectionIcon}" Foreground="{StaticResource SuccessGreen}"/>
                            <TextBlock Text="Status &amp; Permissions" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource SuccessGreen}"/>
                        </StackPanel>

                        <Border Background="#08FFFFFF" CornerRadius="12" Padding="15" Margin="0,0,0,20">
                            <StackPanel>
                                <CheckBox IsChecked="{Binding IsApproved}" Style="{StaticResource ModernToggleSwitch}" Margin="0,0,0,10">
                                    <TextBlock Text="Account Approved" Foreground="White" VerticalAlignment="Center"/>
                                </CheckBox>
                                <CheckBox IsChecked="{Binding IsEmailVerified}" Style="{StaticResource ModernToggleSwitch}">
                                    <TextBlock Text="Email Verified" Foreground="White" VerticalAlignment="Center"/>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <!-- User App Access -->
                        
                        <Border BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0" Padding="0,15,0,0"
                                Visibility="{Binding ShowModuleAccess, Converter={StaticResource VisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="CORE MODULE ACCESS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,12"/>
                                <UniformGrid Columns="1">
                                    <CheckBox IsChecked="{Binding HasDashboardAccess}" Content="Dashboard &amp; Home" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasChatAccess}" Content="Direct Messaging &amp; Channels" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasEmployeeManagementAccess}" Content="Employee &amp; Staff Records" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasAttendanceAccess}" Content="Time &amp; Attendance" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasCustomerAccess}" Content="Customers" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasProjectsAccess}" Content="Project Management" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasHealthSafetyAccess}" Content="HSEQ Compliance" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasCalendarAccess}" Content="Calendar" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasTodoAccess}" Content="Personal To-Dos" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                </UniformGrid>

                                <TextBlock Text="SUPPLY CHAIN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,15,0,12"/>
                                <UniformGrid Columns="1">
                                    <CheckBox IsChecked="{Binding HasProcurementAccess}" Content="Procurement" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasInventoryAccess}" Content="Warehouse &amp; Inventory" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasPurchaseOrderAccess}" Content="Purchase Order Management" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasSuppliersAccess}" Content="Supplier Database" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                </UniformGrid>

                                <TextBlock Text="PARTNERS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,15,0,12"/>
                                <UniformGrid Columns="1">
                                    <CheckBox IsChecked="{Binding HasPerformanceDashboardAccess}" Content="Performance Dashboard" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasSubContractorsAccess}" Content="Sub-Contractors" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasSnagListAccess}" Content="Snag List" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                </UniformGrid>

                                <TextBlock Text="SUPPORT &amp; RESOURCES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,15,0,12"/>
                                <UniformGrid Columns="1">
                                    <CheckBox IsChecked="{Binding HasSupportCenterAccess}" Content="Support Center" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                </UniformGrid>

                                <TextBlock Text="PAYROLL &amp; WAGES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,15,0,12"/>
                                <UniformGrid Columns="1">
                                    <CheckBox IsChecked="{Binding HasJhbWagesAccess}" Content="Johannesburg (JHB) Wages" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                    <CheckBox IsChecked="{Binding HasCptWagesAccess}" Content="Cape Town (CPT) Wages" Style="{StaticResource ModernCheckBox}" Margin="0,0,0,10"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Validation Summary -->
                    <Border Margin="0,0,0,15" Background="#1AEE4444" BorderBrush="{StaticResource ErrorRed}" 
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasErrors, Converter={StaticResource VisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorRed}" FontSize="12" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Margin="0,0,10,0"/>
                        <Button Content="Update Profile" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#CC000000" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.SettingsHub.Views.AuditLogDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.SettingsHub.ViewModels"
             xmlns:utils="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="400"
             d:DataContext="{d:DesignInstance Type=vm:AuditLogDetailViewModel}"
             Background="{StaticResource BackgroundDark}">

    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter" />
        <Style x:Key="TextBlockLeftAlign" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Header/Title -->
            <RowDefinition Height="Auto" />
            <!-- Metadata Cards -->
            <RowDefinition Height="*" />
            <!-- Changes Grid -->
            <RowDefinition Height="Auto" />
            <!-- Close Button -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="AUDIT LOG DETAIL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" />
                <TextBlock Text="{Binding DisplayLog.EntityName}" FontSize="18" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <Button Grid.Column="1" Command="{Binding CloseCommand}" Style="{StaticResource ToolbarIconButton}" VerticalAlignment="Top">
                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Opacity="0.7"/>
            </Button>
        </Grid>

        <!-- Metadata Cards -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15" Margin="0,0,0,15">
            <StackPanel>
                <!-- Action Badge & Table Name -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Border CornerRadius="10" Padding="8,2" HorizontalAlignment="Left">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#15FFAB00"/>
                                <Setter Property="BorderBrush" Value="{StaticResource SecondaryGold}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DisplayLog.Action}" Value="Create">
                                        <Setter Property="Background" Value="#1500C853"/>
                                        <Setter Property="BorderBrush" Value="#00C853"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DisplayLog.Action}" Value="Delete">
                                        <Setter Property="Background" Value="#15E81123"/>
                                        <Setter Property="BorderBrush" Value="#E81123"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding DisplayLog.Action}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SecondaryGold}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource SecondaryGold}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DisplayLog.Action}" Value="Create">
                                            <Setter Property="Foreground" Value="#00C853"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DisplayLog.Action}" Value="Delete">
                                            <Setter Property="Foreground" Value="#E81123"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                    
                    <TextBlock Grid.Column="1" Text="{Binding DisplayLog.TableName, StringFormat='Entity Table: {0}'}" 
                               FontSize="13" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>

                <Separator Background="{StaticResource GlassBorder}" Margin="0,5"/>

                <!-- User & Timestamp Details -->
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Performed By: " Foreground="{StaticResource TextSub}" FontSize="12" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayLog.UserName}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Timestamp: " Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayLog.Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Record ID: " Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,8,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DisplayLog.RecordId}" Foreground="{StaticResource TextSub}" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayLog.RecordId}" Width="200" TextAlignment="Right" Margin="0,8,0,0"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Changes Comparison Grid -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="MODIFIED FIELDS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,8" />

            <Border Grid.Row="1" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Background="#08FFFFFF">
                <DataGrid ItemsSource="{Binding DisplayLog.ChangedFields}" AutoGenerateColumns="False" IsReadOnly="True" 
                          BorderThickness="0" Background="Transparent" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="FIELD" Binding="{Binding PropertyName}" Width="110" FontWeight="Bold" Foreground="White" ElementStyle="{StaticResource TextBlockLeftAlign}"/>
                        
                        <!-- Old Value -->
                        <DataGridTemplateColumn Header="OLD VALUE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#10FF0000" BorderBrush="#30FF0000" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="2">
                                        <TextBlock Text="{Binding OldValue}" TextWrapping="Wrap" Foreground="#FF8F8F" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- New Value -->
                        <DataGridTemplateColumn Header="NEW VALUE" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="#1000FF00" BorderBrush="#3000FF00" BorderThickness="1" CornerRadius="4" Padding="5,2" Margin="2">
                                        <TextBlock Text="{Binding NewValue}" TextWrapping="Wrap" Foreground="#8FFF8F" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Close button at bottom -->
        <Button Grid.Row="3" Command="{Binding CloseCommand}" Content="Close Detail" Style="{StaticResource CancelButton}" Height="38"/>
    </Grid>
</UserControl>

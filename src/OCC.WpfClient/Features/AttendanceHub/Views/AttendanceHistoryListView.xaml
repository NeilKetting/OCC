<local:AttendanceHistoryListViewBase 
    x:Class="OCC.WpfClient.Features.AttendanceHub.Views.AttendanceHistoryListView"
    IsDrawerOpen="{Binding IsOverlayActive}"
    OverlayContent="{Binding OverlayViewModel}"
    DrawerWidth="{Binding DrawerWidth}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OCC.WpfClient.Features.AttendanceHub.Views"
    xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
    xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
    xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
    xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="980"
    d:DataContext="{d:DesignInstance vm:AttendanceHistoryListViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <conv:VisibilityConverter x:Key="VisibilityConverter" />

            <DataTemplate DataType="{x:Type vm:AttendanceDetailViewModel}">
                <local:AttendanceDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AttendanceImportPreviewViewModel}">
                <local:AttendanceImportPreviewView />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ TOOLBAR ══════════════════ -->
        <Border Grid.Row="0" Padding="16,10" Background="#06FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Page Header Info (Fills Remaining Space) -->
                <TextBlock Grid.Row="0" Grid.Column="0"  Text="ATTENDANCE HISTORY" Style="{StaticResource HeaderText}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding TotalCount}"/>
                            <Run Text="records | "/>
                            <Run Text="{Binding TotalHours}"/>
                            <Run Text=" hours total"/>
                </TextBlock>

                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LoadDataCommand}" ToolTip="Refresh" Margin="0,0,10,0">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolButtonIcon}" Margin="0,0,8,0" Foreground="{StaticResource AccentBlue}"/>
                    </Button>
                    <Button Style="{StaticResource PrintButton}" Command="{Binding PrintCommand}" Padding="0" ToolTip="Print Report" Width="120" Margin="0,0,12,0"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource CreateIconButton}" Command="{Binding AddRecordCommand}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolButtonIcon}" />
                            <TextBlock Text="Add Entry" Style="{StaticResource ButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding ImportExcelCommand}" Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolButtonIcon}" Margin="0,0,8,0" />
                            <TextBlock Text="Import Excel" Style="{StaticResource ButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

            </Grid>
        </Border>

        <!-- ══════════════════ FILTER BAR ══════════════════ -->
        <Border Grid.Row="1" Padding="16,10" Background="#04FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <!-- Search -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" Width="200" ap:WatermarkProperties.Watermark="Search attendance..."/>
                </StackPanel>
                <!-- From Date -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="From" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource ModernDatePicker}" Width="130"/>
                </StackPanel>
                <!-- To Date -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="To" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource ModernDatePicker}" Width="130"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <!-- Status Filter -->
                    <ComboBox SelectedIndex="{Binding SelectedStatusIndex}" Style="{StaticResource ModernComboBox}" Width="140" Margin="0,0,12,0">
                        <ComboBoxItem Content="All Statuses"/>
                        <ComboBoxItem Content="Present"/>
                        <ComboBoxItem Content="Late"/>
                        <ComboBoxItem Content="Absent"/>
                        <ComboBoxItem Content="Sick"/>
                        <ComboBoxItem Content="Leave"/>
                    </ComboBox>
                    <!-- Branch Filter -->
                    <ComboBox SelectedIndex="{Binding SelectedBranchIndex}" Style="{StaticResource ModernComboBox}" Width="140" Margin="0,0,12,0">
                        <ComboBoxItem Content="All Branches"/>
                        <ComboBoxItem Content="Johannesburg"/>
                        <ComboBoxItem Content="Cape Town"/>
                    </ComboBox>

                    <!-- Columns Filter Button -->
                    <Button x:Name="ColumnsButton" Command="{Binding ToggleColumnPickerCommand}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Height="35">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="COLUMNS" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Column Picker Popup -->
                    <Popup IsOpen="{Binding IsColumnPickerOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=ColumnsButton}" HorizontalOffset="-120" VerticalOffset="5">
                        <Border Background="{StaticResource BackgroundDark}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Width="200">
                            <StackPanel>
                                <TextBlock Text="Toggle Columns" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                                <CheckBox Content="Date" IsChecked="{Binding IsDateColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Employee" IsChecked="{Binding IsEmployeeColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Project" IsChecked="{Binding IsProjectColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Status" IsChecked="{Binding IsStatusColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Clock In" IsChecked="{Binding IsClockInColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Clock Out" IsChecked="{Binding IsClockOutColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Hours" IsChecked="{Binding IsHoursColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Branch" IsChecked="{Binding IsBranchColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                <CheckBox Content="Notes" IsChecked="{Binding IsNotesColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>                
            </WrapPanel>
        </Border>

        <!-- ══════════════════ DATA GRID ══════════════════ -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#06FFFFFF"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Style="{StaticResource ModernDataGrid}">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ap:CommandProperties.DoubleClickCommand" Value="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                    <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="Auto" Visibility="{Binding Data.IsDateColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="180" Visibility="{Binding Data.IsEmployeeColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="160" Visibility="{Binding Data.IsProjectColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100" Visibility="{Binding Data.IsStatusColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="CLOCK IN" Binding="{Binding CheckInTime, StringFormat=HH:mm}" Width="Auto" Visibility="{Binding Data.IsClockInColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="CLOCK OUT" Binding="{Binding CheckOutTime, StringFormat=HH:mm}" Width="Auto" Visibility="{Binding Data.IsClockOutColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="HOURS" Binding="{Binding HoursWorked, StringFormat={}{0:F1}}" Width="Auto" Visibility="{Binding Data.IsHoursColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="Auto" Visibility="{Binding Data.IsBranchColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="Auto" Visibility="{Binding Data.IsNotesColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                <!-- Actions -->
                <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Edit Record"
                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="{StaticResource AccentBlue}" Margin="5">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Delete Record"
                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="{StaticResource ErrorRed}" Margin="5">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</local:AttendanceHistoryListViewBase>

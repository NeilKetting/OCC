<local:AttendanceHistoryListViewBase 
    x:Class="OCC.WpfClient.Features.AttendanceHub.Views.AttendanceHistoryListView"
    IsDrawerOpen="{Binding IsOverlayActive}"
    OverlayContent="{Binding OverlayViewModel}"
    DrawerWidth="{Binding DrawerWidth}"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OCC.WpfClient.Features.AttendanceHub.Views"
    xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
    xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
    xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
    xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="980"
    d:DataContext="{d:DesignInstance vm:AttendanceHistoryListViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
            <conv:VisibilityConverter x:Key="VisibilityConverter" />
            <conv:FriendlyEnumConverter x:Key="FriendlyEnumConverter" />

            <DataTemplate DataType="{x:Type vm:AttendanceDetailViewModel}">
                <local:AttendanceDetailView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AttendanceImportPreviewViewModel}">
                <local:AttendanceImportPreviewView />
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row 0: QuickBooks Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: Title Header -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Filters -->
            <RowDefinition Height="*"/>
            <!-- Row 3: DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ PAGE HEADER ══════════════════ -->
        <Border Grid.Row="1" Margin="16,12,16,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#xE81C;" Style="{StaticResource SymbolIcon}" 
                           Foreground="#FBBF24" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="ATTENDANCE HISTORY" Style="{StaticResource HeaderText}" FontFamily="{StaticResource MichromaFont}" FontSize="20" Foreground="White"/>
                    <TextBlock Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0">
                        <Run Text="{Binding TotalCount}"/>
                        <Run Text=" records | "/>
                        <Run Text="{Binding TotalHours}"/>
                        <Run Text=" hours total"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ FILTER BAR ══════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="16,10" Margin="16,6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <!-- ══════════════════ QUICKBOOKS TOOLBAR ══════════════════ -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding LoadDataCommand}" ToolTip="Refresh Data">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Refresh" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Add Entry Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding AddRecordCommand}" ToolTip="Add New Entry">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Add Entry" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Import Excel Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding ImportExcelCommand}" ToolTip="Import from Excel">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE718;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Import Excel" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Print Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding PrintCommand}" ToolTip="Print Report">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SecondaryGold}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Print" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Columns Button -->
                            <Button x:Name="ColumnsButton" Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding ToggleColumnPickerCommand}" ToolTip="Show/Hide Columns">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE136;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Columns" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <!-- Column Picker Popup -->
                            <Popup IsOpen="{Binding IsColumnPickerOpen}" StaysOpen="False" Placement="Bottom" PlacementTarget="{Binding ElementName=ColumnsButton}" HorizontalOffset="-60" VerticalOffset="5">
                                <Border Background="{StaticResource BackgroundDark}" BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="8" Padding="15" Width="200">
                                    <StackPanel>
                                        <TextBlock Text="Toggle Columns" Foreground="White" FontWeight="Bold" Margin="0,0,0,10"/>
                                        <CheckBox Content="Date" IsChecked="{Binding IsDateColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Employee" IsChecked="{Binding IsEmployeeColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Project" IsChecked="{Binding IsProjectColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Status" IsChecked="{Binding IsStatusColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Clock In" IsChecked="{Binding IsClockInColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Clock Out" IsChecked="{Binding IsClockOutColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Hours" IsChecked="{Binding IsHoursColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="O/T Sat" IsChecked="{Binding IsOtSatColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="O/T Sun" IsChecked="{Binding IsOtSunColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="O/T Hol" IsChecked="{Binding IsOtHolColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Branch" IsChecked="{Binding IsBranchColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                        <CheckBox Content="Notes" IsChecked="{Binding IsNotesColumnVisible}" Style="{StaticResource ModernCheckBox}" Margin="0,5"/>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Border>
                </Grid>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- Search -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- From Date -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- To Date -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Status Filter -->
                        <ColumnDefinition Width="Auto"/>
                        <!-- Branch Filter -->
                        <ColumnDefinition Width="*"/>
                        <!-- Spacing -->
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,4,20,4" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" Width="160" ap:WatermarkProperties.Watermark="Search attendance..."/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal">
                    <!-- TimeSpan Filter -->
                    <ComboBox SelectedIndex="{Binding SelectedTimeSpanIndex}" 
                              Style="{StaticResource ModernComboBox}" Margin="0,4,15,4" VerticalAlignment="Center">
                        <ComboBoxItem Content="All Time"/>
                        <ComboBoxItem Content="Today"/>
                        <ComboBoxItem Content="Yesterday"/>
                        <ComboBoxItem Content="This Week"/>
                        <ComboBoxItem Content="Last Week"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last Month"/>
                        <ComboBoxItem Content="Custom Range"/>
                    </ComboBox>

                    <!-- From Date (Custom only) -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,20,4" VerticalAlignment="Center"
                                Visibility="{Binding IsCustomTimeSpan, Converter={StaticResource VisibilityConverter}}">
                        <TextBlock Text="From" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource ModernDatePicker}" />
                    </StackPanel>

                    <!-- To Date (Custom only) -->
                    <StackPanel Orientation="Horizontal" Margin="0,4,20,4" VerticalAlignment="Center"
                                Visibility="{Binding IsCustomTimeSpan, Converter={StaticResource VisibilityConverter}}">
                        <TextBlock Text="To" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource ModernDatePicker}"/>
                    </StackPanel>

                    <!-- Status Filter -->
                    <ComboBox SelectedIndex="{Binding SelectedStatusIndex}" 
                              Style="{StaticResource ModernComboBox}" Margin="0,4,15,4" VerticalAlignment="Center">
                        <ComboBoxItem Content="All Statuses"/>
                        <ComboBoxItem Content="Present"/>
                        <ComboBoxItem Content="Late"/>
                        <ComboBoxItem Content="Absent"/>
                        <ComboBoxItem Content="Sick"/>
                        <ComboBoxItem Content="Leave"/>
                        <ComboBoxItem Content="Unpaid"/>
                        <ComboBoxItem Content="Unpaid Leave"/>
                    </ComboBox>

                    <!-- Branch Filter -->
                    <ComboBox SelectedIndex="{Binding SelectedBranchIndex}" 
                              Style="{StaticResource ModernComboBox}" Margin="0,4,15,4" VerticalAlignment="Center">
                        <ComboBoxItem Content="All Branches"/>
                        <ComboBoxItem Content="Johannesburg"/>
                        <ComboBoxItem Content="Cape Town"/>
                    </ComboBox>

                    <!-- Remuneration/Pay Type Filter -->
                    <ComboBox SelectedIndex="{Binding SelectedRateTypeIndex}" 
                              Style="{StaticResource ModernComboBox}" Margin="0,4,15,4" VerticalAlignment="Center">
                        <ComboBoxItem Content="All Pay Types"/>
                        <ComboBoxItem Content="Hourly"/>
                        <ComboBoxItem Content="Salary"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ DATA GRID ══════════════════ -->
        <Border Grid.Row="3" Style="{StaticResource GlassCard}" Margin="16,0,16,16" Padding="1" CornerRadius="0">
            <DataGrid ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Extended"
                      RowBackground="Transparent"
                      AlternatingRowBackground="#06FFFFFF"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      Style="{StaticResource ModernDataGrid}">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Setter Property="ap:CommandProperties.DoubleClickCommand" Value="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                        <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu Style="{StaticResource ModernContextMenu}">
                                    <MenuItem Header="Open" Command="{Binding PlacementTarget.Tag.EditRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8A7;" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="{StaticResource SuccessGreen}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Edit" Command="{Binding PlacementTarget.Tag.EditRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="{StaticResource AccentBlue}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Assign to Project" Command="{Binding PlacementTarget.Tag.AssignProjectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE815;" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="{StaticResource SecondaryGold}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Mark as Absent (Zero Hours)" Command="{Binding PlacementTarget.Tag.MarkAsAbsentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE711;" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="{StaticResource ErrorRed}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Delete" Command="{Binding PlacementTarget.Tag.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding}">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="{StaticResource ErrorRed}"/>
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="Auto" Visibility="{Binding Data.IsDateColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="Auto" Visibility="{Binding Data.IsEmployeeColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="Auto" Visibility="{Binding Data.IsProjectColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="STATUS" Binding="{Binding Status, Converter={StaticResource FriendlyEnumConverter}}" Width="Auto" Visibility="{Binding Data.IsStatusColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="CLOCK IN" Binding="{Binding CheckInTime, StringFormat=HH:mm}" Width="Auto" Visibility="{Binding Data.IsClockInColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="CLOCK OUT" Binding="{Binding CheckOutTime, StringFormat=HH:mm}" Width="Auto" Visibility="{Binding Data.IsClockOutColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="HOURS" Binding="{Binding HoursWorked, StringFormat={}{0:F2}}" Width="Auto" Visibility="{Binding Data.IsHoursColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="O/T SAT" Binding="{Binding OtSaturday}" Width="Auto" Visibility="{Binding Data.IsOtSatColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="O/T SUN" Binding="{Binding OtSunday}" Width="Auto" Visibility="{Binding Data.IsOtSunColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="O/T HOL" Binding="{Binding OtHoliday}" Width="Auto" Visibility="{Binding Data.IsOtHolColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="Auto" Visibility="{Binding Data.IsBranchColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="Auto" Visibility="{Binding Data.IsNotesColumnVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                    <!-- Actions -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Edit Record"
                                            Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Foreground="{StaticResource AccentBlue}" Margin="5">
                                        <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </Button>
                                    <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Delete Record"
                                            Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Foreground="{StaticResource ErrorRed}" Margin="5">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</local:AttendanceHistoryListViewBase>

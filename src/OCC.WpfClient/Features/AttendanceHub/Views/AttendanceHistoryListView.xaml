<local:AttendanceHistoryListViewBase 
    x:Class="OCC.WpfClient.Features.AttendanceHub.Views.AttendanceHistoryListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OCC.WpfClient.Features.AttendanceHub.Views"
    xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
    xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
    xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="980"
    d:DataContext="{d:DesignInstance vm:AttendanceHistoryListViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Filter bar -->
            <RowDefinition Height="*"/>
            <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ TOOLBAR ══════════════════ -->
        <Border Grid.Row="0" Padding="16,10" Background="#06FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ATTENDANCE HISTORY" Style="{StaticResource HeaderText}"/>
                    <TextBlock Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0">
                        <Run Text="{Binding TotalCount}"/>
                        <Run Text="records | "/>
                        <Run Text="{Binding TotalHours}"/>
                        <Run Text=" hours total"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LoadDataCommand}" ToolTip="Refresh">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolButtonIcon}" Margin="0,0,8,0" Foreground="{StaticResource AccentBlue}"/>
                    </Button>
                    <Button Style="{StaticResource PrintButton}" Command="{Binding PrintCommand}" 
                            Margin="12,0,0,0" ToolTip="Print Report" />

                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ FILTER BAR ══════════════════ -->
        <Border Grid.Row="1" Padding="16,10" Background="#04FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <WrapPanel Orientation="Horizontal">
                <!-- Search -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                    <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" Width="200" ap:WatermarkProperties.Watermark="Search attendance..."/>
                </StackPanel>
                <!-- From Date -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="From" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Style="{StaticResource ModernDatePicker}" Width="130"/>
                </StackPanel>
                <!-- To Date -->
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0" VerticalAlignment="Center">
                    <TextBlock Text="To" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Style="{StaticResource ModernDatePicker}" Width="130"/>
                </StackPanel>
                <!-- Status Filter -->
                <ComboBox SelectedIndex="{Binding SelectedStatusIndex}" Style="{StaticResource ModernComboBox}" Width="140" Margin="0,0,12,0">
                    <ComboBoxItem Content="All Statuses"/>
                    <ComboBoxItem Content="Present"/>
                    <ComboBoxItem Content="Late"/>
                    <ComboBoxItem Content="Absent"/>
                    <ComboBoxItem Content="Sick"/>
                    <ComboBoxItem Content="Leave"/>
                </ComboBox>
                <!-- Branch Filter -->
                <ComboBox SelectedIndex="{Binding SelectedBranchIndex}" Style="{StaticResource ModernComboBox}" Width="140">
                    <ComboBoxItem Content="All Branches"/>
                    <ComboBoxItem Content="Johannesburg"/>
                    <ComboBoxItem Content="Cape Town"/>
                </ComboBox>
            </WrapPanel>
        </Border>

        <!-- ══════════════════ DATA GRID ══════════════════ -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding Items}"
                  SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  SelectionMode="Extended"
                  RowBackground="Transparent"
                  AlternatingRowBackground="#06FFFFFF"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  Style="{StaticResource ModernDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat=yyyy/MM/dd}" Width="Auto"/>
                <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="180"/>
                <DataGridTextColumn Header="PROJECT" Binding="{Binding ProjectName}" Width="160"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="CLOCK IN" Binding="{Binding CheckInTime, StringFormat=HH:mm}" Width="Auto"/>
                <DataGridTextColumn Header="CLOCK OUT" Binding="{Binding CheckOutTime, StringFormat=HH:mm}" Width="Auto"/>
                <DataGridTextColumn Header="HOURS" Binding="{Binding HoursWorked, StringFormat={}{0:F1}}" Width="Auto"/>
                <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="Auto"/>
                <DataGridTextColumn Header="NOTES" Binding="{Binding Notes}" Width="Auto"/>
                <!-- Actions -->
                <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Edit Record"
                                        Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="{StaticResource AccentBlue}" Margin="5">
                                    <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Delete Record"
                                        Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" Foreground="{StaticResource ErrorRed}" Margin="5">
                                    <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ══════════════════ EDIT DRAWER (inline slide panel) ══════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Visibility="{Binding IsEditPanelOpen, Converter={StaticResource VisibilityConverter}}">
            <!-- Dimmer -->
            <Border Background="#70000000"/>
            <!-- Panel -->
            <Border HorizontalAlignment="Right" Width="380"
                    Background="{StaticResource BackgroundDarker}"
                    BorderBrush="{StaticResource GlassBorder}" BorderThickness="1,0,0,0"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="EDIT ATTENDANCE RECORD" Foreground="{StaticResource AccentBlue}"
                               FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>

                    <TextBlock Text="Status" Style="{StaticResource LabelText}"/>
                    <ComboBox SelectedItem="{Binding EditingRecord.Status}" Style="{StaticResource ModernComboBox}" Margin="0,4,0,16">
                        <ComboBoxItem Content="Present" Tag="Present"/>
                        <ComboBoxItem Content="Late" Tag="Late"/>
                        <ComboBoxItem Content="Absent" Tag="Absent"/>
                        <ComboBoxItem Content="Sick" Tag="Sick"/>
                        <ComboBoxItem Content="Leave Authorized" Tag="LeaveAuthorized"/>
                        <ComboBoxItem Content="Leave Early" Tag="LeaveEarly"/>
                        <ComboBoxItem Content="Unpaid Sick" Tag="UnpaidSick"/>
                    </ComboBox>

                    <TextBlock Text="Clock In Time" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding EditingRecord.CheckInTime, StringFormat=HH:mm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernInput}" Margin="0,4,0,16"/>

                    <TextBlock Text="Clock Out Time" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding EditingRecord.CheckOutTime, StringFormat=HH:mm, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernInput}" Margin="0,4,0,16"/>

                    <TextBlock Text="Notes" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding EditingRecord.Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource ModernInput}" Height="80" TextWrapping="Wrap"
                             AcceptsReturn="True" Margin="0,4,0,16"/>

                    <!-- Sick Note Upload — visible when Status is Sick / UnpaidSick -->
                    <Border Padding="12" CornerRadius="6"
                            Background="#0A4CAF50" BorderBrush="#304CAF50" BorderThickness="1"
                            Margin="0,0,0,16"
                            Visibility="{Binding HasSickNote, Converter={StaticResource VisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="SICK NOTE ATTACHED" Foreground="#4CAF50" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SickNoteFilePath}" Foreground="{StaticResource TextSub}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,16"
                            Command="{Binding UploadSickNoteCommand}"
                            HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8A5;" Style="{StaticResource SymbolIcon}" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="UPLOAD SICK NOTE / DOCTOR'S CERT" VerticalAlignment="Center" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource SecondaryButton}" Content="CANCEL"
                                Command="{Binding CancelEditCommand}" Margin="0,0,12,0" Padding="14,8"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="SAVE RECORD"
                                Command="{Binding SaveRecordCommand}" Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</local:AttendanceHistoryListViewBase>

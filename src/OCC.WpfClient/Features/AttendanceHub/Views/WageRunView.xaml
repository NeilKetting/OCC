<UserControl x:Class="OCC.WpfClient.Features.AttendanceHub.Views.WageRunView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1200"
             d:DataContext="{d:DesignInstance vm:WageRunViewModel}">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:VisibilityConverter x:Key="VisibilityConverter" />
            <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="Auto"/>  <!-- Config bar -->
            <RowDefinition Height="*"/>     <!-- Content tabs (grid / history) -->
            <RowDefinition Height="Auto"/>  <!-- Footer grand total -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ TOOLBAR ══════════════════ -->
        <Border Grid.Row="0" Padding="16,10" Background="#06FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WAGE RUN" Style="{StaticResource HeaderText}"/>
                    <TextBlock Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0">
                        <Run Text="{Binding StartDate, StringFormat='dd MMM yyyy'}"/>
                        <Run Text=" — "/>
                        <Run Text="{Binding EndDate, StringFormat='dd MMM yyyy'}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0">
                    <!-- Refresh / Load history -->
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LoadDataCommand}" ToolTip="Refresh history">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolButtonIcon}" Foreground="{StaticResource AccentBlue}"/>
                    </Button>
                    <!-- Print PDF -->
                    <Button Style="{StaticResource PrintButton}" Command="{Binding PrintPdfCommand}" ToolTip="Print Wage Run PDF"
                            Margin="8,0,0,0" Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVis}}">
                    </Button>
                    <!-- Salary PDF Button -->
                    <Button Command="{Binding PrintSalaryVersionCommand}" ToolTip="Print Salary Version PDF"
                            Margin="8,0,0,0" Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource PrintButton}"
                            Content="Print Salary Version"/>

                    <!-- Print Supervisor Payments PDF -->
                    <Button Command="{Binding PrintSupervisorPaymentsCommand}" ToolTip="Print Supervisor Payments Checklist PDF"
                            Style="{StaticResource PrintButton}"
                            Margin="8,0,0,0" Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVis}}"
                            Content="Supervisor Payment Check List"/>
                    <!-- Finalize -->
                    <Button Command="{Binding FinalizeRunCommand}" Margin="8,0,0,0"
                            Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource CreateIconButton}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE930;" Style="{StaticResource SymbolButtonIcon}" Margin="0,0,8,0"/>
                            <TextBlock Text="FINALISE RUN"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ CONFIG BAR ══════════════════ -->
        <Border Grid.Row="1" Padding="16,10" Background="#04FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Core Filters & Actions -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <!-- Start Date -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <TextBlock Text="START DATE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" 
                                    Style="{StaticResource ModernDatePicker}" Width="140"/>
                    </StackPanel>

                    <!-- End Date (auto-filled) -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <TextBlock Text="END DATE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                    Style="{StaticResource ModernDatePicker}" Width="140"/>
                    </StackPanel>

                    <!-- Salary Type -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <TextBlock Text="SALARY TYPE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PayTypeOptions}" SelectedItem="{Binding SelectedPayType}"
                                   Style="{StaticResource ModernComboBox}" Width="140"/>
                    </StackPanel>

                    <!-- Branch -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <TextBlock Text="BRANCH" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding SelectedBranch}"
                                   Style="{StaticResource ModernComboBox}" Width="140"/>
                    </StackPanel>

                    <!-- Notes -->
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <TextBlock Text="NOTES" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernInput}" Width="180"/>
                    </StackPanel>

                    <!-- Deductions Panel Toggle -->
                    <ToggleButton x:Name="DeductionsToggle" Style="{StaticResource ToolbarToggleButton}" Width="150" Height="34" Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" Opacity="0.8" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="DEDUCTIONS &amp; FEES" Foreground="White" VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </ToggleButton>

                    <!-- Generate Button -->
                    <Button Command="{Binding GenerateDraftCommand}" Style="{StaticResource CreateIconButton}" Height="34" Margin="0,0,16,0" VerticalAlignment="Bottom">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8FD;" Style="{StaticResource SymbolButtonIcon}" Margin="0,0,8,0"/>
                            <TextBlock Text="GENERATE DRAFT"/>
                        </StackPanel>
                    </Button>

                    <!-- Column Options -->
                    <Grid VerticalAlignment="Bottom" Visibility="{Binding IsGenerated, Converter={StaticResource VisibilityConverter}}">
                        <ToggleButton x:Name="ColumnsToggle" Style="{StaticResource ToolbarToggleButton}" Width="100" Height="34">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" Opacity="0.8" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="COLUMNS" Foreground="White" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsChecked, ElementName=ColumnsToggle}" StaysOpen="False" PlacementTarget="{Binding ElementName=ColumnsToggle}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,5,0,0" Width="200">
                                <StackPanel>
                                    <TextBlock Text="DISPLAY COLUMNS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBlue}" Margin="0,0,0,8"/>
                                    <CheckBox Content="Index (#)" IsChecked="{Binding IsIndexVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="BAS" IsChecked="{Binding IsBasVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Name" IsChecked="{Binding IsNameVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Rate/Hr" IsChecked="{Binding IsRateHrVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Hours (HRS)" IsChecked="{Binding IsHrsVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="OT Rates" IsChecked="{Binding IsOtRatesVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Deductions" IsChecked="{Binding IsDeductionsVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Supervisor Fee" IsChecked="{Binding IsSupFeeVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Total Nett" IsChecked="{Binding IsTotalNettVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Bank" IsChecked="{Binding IsBankVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Account Number" IsChecked="{Binding IsBankAccountVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Comments" IsChecked="{Binding IsCommentsVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Notes" IsChecked="{Binding IsNotesVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Total Rem" IsChecked="{Binding IsTotalRemVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                    <CheckBox Content="Days" IsChecked="{Binding IsDaysVisible, Mode=TwoWay}" Style="{StaticResource ModernCheckBox}" Margin="0,4"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </WrapPanel>

                <!-- Expanded Deductions & Fees Panel -->
                <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsChecked, ElementName=DeductionsToggle, Converter={StaticResource BoolToVis}}">
                    <Border Background="#12FFFFFF" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Gas Charge -->
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="GAS CHARGE (TOTAL R)" Style="{StaticResource LabelText}" Margin="0,0,0,4" Foreground="{StaticResource AccentBlue}"/>
                                <TextBox Text="{Binding TotalGasCharge, StringFormat='F2', UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource ModernInput}" Width="120" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Washing Fee -->
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="WASHING FEE (R/PERSON)" Style="{StaticResource LabelText}" Margin="0,0,0,4" Foreground="{StaticResource AccentBlue}"/>
                                <TextBox Text="{Binding CompanyHousingWashingFee, StringFormat='F2', UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource ModernInput}" Width="120" TextAlignment="Right"/>
                            </StackPanel>

                            <!-- Supervisor Fee -->
                            <StackPanel Margin="0,0,24,0">
                                <TextBlock Text="SUPERVISOR FEE (R)" Style="{StaticResource LabelText}" Margin="0,0,0,4" Foreground="{StaticResource AccentBlue}"/>
                                <TextBox Text="{Binding DefaultSupervisorFee, StringFormat='F2', UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource ModernInput}" Width="120" TextAlignment="Right"/>
                            </StackPanel>
                            
                            <!-- Help info -->
                            <TextBlock Text="* Deductions are automatically distributed to company housed employees and supervisor fees to supervisors upon generating draft."
                                       Style="{StaticResource LabelText}" Opacity="0.5" VerticalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap"/>
                        </WrapPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════ MAIN CONTENT AREA ══════════════════ -->
        <Grid Grid.Row="2">
            <!-- If no lines generated yet, show history -->
            <Grid Visibility="{Binding IsGenerated, Converter={StaticResource VisibilityConverter}}">
                <!-- Wage Run Spreadsheet DataGrid -->
                <DataGrid ItemsSource="{Binding Lines}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          Style="{StaticResource ModernDataGrid}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.IsDeferredScrollingEnabled="False"
                          FontSize="11">

                    <DataGrid.Columns>
                        <!-- # -->
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsIndexVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <!-- BAS -->
                        <DataGridTextColumn Header="BAS" Binding="{Binding EmployeeNumber}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsBasVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <!-- NAME -->
                        <DataGridTextColumn Header="NAME" Binding="{Binding EmployeeName}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsNameVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <!-- RATE P/HR -->
                        <DataGridTextColumn Header="RATE P/HR" Binding="{Binding RatePHrDisplay, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsRateHrVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- HRS (Normal + Projected + Variance) — editable -->
                        <DataGridTemplateColumn Header="HRS" Width="Auto"
                                                Visibility="{Binding Data.IsHrsVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StdHoursDisplay, StringFormat='F2'}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding NormalHours, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- STD O/T RATE -->
                        <DataGridTextColumn Header="STD O/T RATE" Binding="{Binding StdOtRate, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- SAT O/T RATE -->
                        <DataGridTextColumn Header="SAT O/T RATE" Binding="{Binding SatOtRate, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- SUN RATE -->
                        <DataGridTextColumn Header="SUN-P'HOL RATE" Binding="{Binding SunPHolRate, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- DEC O/T RATE -->
                        <DataGridTextColumn Header="DEC O/T RATE" Binding="{Binding DecOtRate, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- DEC O/T HRS -->
                        <DataGridTextColumn Header="DEC O/T HRS" Binding="{Binding DecOtHrs, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- DEC TOTAL -->
                        <DataGridTextColumn Header="DEC TOTAL" Binding="{Binding DecTotal, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- STD O/T HRS — editable -->
                        <DataGridTemplateColumn Header="STD O/T" Width="Auto"
                                                Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Overtime15Hours, StringFormat='F2'}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Overtime15Hours, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- SAT O/T HRS — read-only -->
                        <DataGridTextColumn Header="SAT O/T" Binding="{Binding SatOt, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- SUN O/T HRS — editable -->
                        <DataGridTemplateColumn Header="SUN O/T" Width="Auto"
                                                Visibility="{Binding Data.IsOtRatesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Overtime20Hours, StringFormat='F2'}" HorizontalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Overtime20Hours, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- LOANS — editable -->
                        <DataGridTemplateColumn Header="LOANS" Width="Auto"
                                                Visibility="{Binding Data.IsDeductionsVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeductionLoanDisplay}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DeductionLoan, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- WASHING — editable -->
                        <DataGridTemplateColumn Header="WASHING" Width="Auto"
                                                Visibility="{Binding Data.IsDeductionsVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeductionWashingDisplay}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DeductionWashing, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- GAS — editable -->
                        <DataGridTemplateColumn Header="GAS" Width="Auto"
                                                Visibility="{Binding Data.IsDeductionsVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DeductionGasDisplay}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DeductionGas, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- OTHER — editable -->
                        <DataGridTemplateColumn Header="OTHER" Width="Auto"
                                                Visibility="{Binding Data.IsDeductionsVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OtherDisplay}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding DeductionOther, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- SUPERVISOR FEE — editable -->
                        <DataGridTemplateColumn Header="SUP FEE" Width="Auto"
                                                Visibility="{Binding Data.IsSupFeeVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding IncentiveSupervisor, StringFormat='F2'}" HorizontalAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding IncentiveSupervisor, UpdateSourceTrigger=LostFocus, StringFormat='F2'}" TextAlignment="Right"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- TOTAL NETT — read-only, highlighted -->
                        <DataGridTextColumn Header="TOTAL NETT" Binding="{Binding NetPay, StringFormat='R #,##0.00'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsTotalNettVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="{StaticResource OrangeBrush}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- BANK -->
                        <DataGridTextColumn Header="BANK" Binding="{Binding BankName}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsBankVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <!-- BANK ACC -->
                        <DataGridTextColumn Header="ACCOUNT NUMBER" Binding="{Binding BankAccountNumber}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsBankAccountVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <!-- USER COMMENTS -->
                        <DataGridTemplateColumn Header="COMMENTS" Width="Auto"
                                                Visibility="{Binding Data.IsCommentsVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Comments}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Comments, UpdateSourceTrigger=LostFocus}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <!-- VARIANCE NOTES -->
                        <DataGridTextColumn Header="NOTES" Binding="{Binding VarianceNotes}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsNotesVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}"/>
                        <!-- TOTAL REM -->
                        <DataGridTextColumn Header="TOTAL REM" Binding="{Binding TotalRem, StringFormat='R #,##0.00'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsTotalRemVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- RATE P/DAY -->
                        <DataGridTextColumn Header="RATE P/DAY" Binding="{Binding RatePDayDisplay, StringFormat='F2'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsDaysVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <!-- W1, W2, W3, TOT D -->
                        <DataGridTextColumn Header="WEEK 1" Binding="{Binding DaysWeek1Display, StringFormat='0.#'}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsDaysVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="WEEK 2" Binding="{Binding DaysWeek2Display}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsDaysVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="WEEK 3" Binding="{Binding DaysWeek3Display}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsDaysVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="TOTAL DAYS" Binding="{Binding TotalDaysDisplay}" Width="Auto" IsReadOnly="True"
                                            Visibility="{Binding Data.IsDaysVisible, Source={StaticResource Proxy}, Converter={StaticResource VisibilityConverter}}">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- Past Runs (when no draft generated) -->
            <Grid Visibility="{Binding IsGenerated, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,10" Background="#04FFFFFF" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PAST RUNS" Style="{StaticResource LabelText}" Opacity="0.7" VerticalAlignment="Center" FontWeight="Bold"/>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Past Runs Branch Filter -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,0" VerticalAlignment="Center">
                                <TextBlock Text="BRANCH:" Style="{StaticResource LabelText}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding BranchOptions}" SelectedItem="{Binding SelectedPastBranch}"
                                           Style="{StaticResource ModernComboBox}" Width="140" Height="28" FontSize="11"/>
                            </StackPanel>

                            <!-- Past Runs Salary Type Filter -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SALARY TYPE:" Style="{StaticResource LabelText}" Opacity="0.5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding PayTypeOptionsWithAll}" SelectedItem="{Binding SelectedPastSalaryType}"
                                           Style="{StaticResource ModernComboBox}" Width="140" Height="28" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding FilteredPastRuns}"
                          SelectedItem="{Binding SelectedPastRun}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          Style="{StaticResource ModernDataGrid}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Branch" Binding="{Binding Branch}" Width="120"/>
                        <DataGridTextColumn Header="Pay Type" Binding="{Binding PayType}" Width="120"/>
                        <DataGridTextColumn Header="Period Start" Binding="{Binding StartDate, StringFormat='dd MMM yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="Period End" Binding="{Binding EndDate, StringFormat='dd MMM yyyy'}" Width="120"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        <DataGridTextColumn Header="Lines" Binding="{Binding Lines.Count}" Width="60">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Actions" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ToolbarIconButton}"
                                             Command="{Binding DataContext.DeletePastRunCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             CommandParameter="{Binding}"
                                             ToolTip="Delete Run">
                                        <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolButtonIcon}" Foreground="#EF4444"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ══════════════════ GRAND TOTAL FOOTER ══════════════════ -->
        <Border Grid.Row="3" Padding="16,10" Background="#0AFFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsGenerated, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="GRAND TOTAL NET PAY:" Style="{StaticResource LabelText}" 
                           VerticalAlignment="Center" Margin="0,0,16,0" Opacity="0.7"/>
                <TextBlock Text="{Binding GrandTotalWage, StringFormat='R #,##0.00'}"
                           FontSize="20" FontWeight="Bold" Foreground="{StaticResource OrangeBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Busy Overlay -->
        <Border Grid.RowSpan="4" Background="#88000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="{StaticResource AccentBlue}" BorderThickness="0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

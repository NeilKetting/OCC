<utils:ListViewBase x:Class="OCC.WpfClient.Features.AttendanceHub.Views.LeaveManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
             xmlns:utils="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="980"
             d:DataContext="{d:DesignInstance vm:LeaveManagementViewModel}"
             IsDrawerOpen="{Binding IsApplyPanelOpen, Mode=TwoWay}"
             DrawerWidth="420">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>
            <!-- Stats + filter bar -->
            <RowDefinition Height="Auto"/>
            <!-- Stats + filter bar -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" Padding="20,12" Background="#06FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="LEAVE MANAGEMENT" Style="{StaticResource HeaderText}"/>
                <TextBlock Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0">
                    <Run Text="{Binding TotalCount}"/>
                    <Run Text="records — Annual / Sick / Maternity"/>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Stats Cards -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="16,10,16,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <!-- Pending -->
                <Border Style="{StaticResource GlassCard}" Padding="12,8" Margin="0,0,10,0" Background="#06FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource OrangeBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding PendingCount}" Foreground="{StaticResource OrangeBrush}" FontSize="20" FontWeight="Black"/>
                            <TextBlock Text="PENDING" Foreground="{StaticResource TextSub}" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Approved -->
                <Border Style="{StaticResource GlassCard}" Padding="12,8" Margin="0,0,10,0" Background="#06FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE930;" Style="{StaticResource SymbolIcon}" Foreground="#4CAF50" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding ApprovedCount}" Foreground="#4CAF50" FontSize="20" FontWeight="Black"/>
                            <TextBlock Text="APPROVED" Foreground="{StaticResource TextSub}" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- Rejected -->
                <Border Style="{StaticResource GlassCard}" Padding="12,8" Margin="0,0,0,0" Background="#06FFFFFF">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding RejectedCount}" Foreground="{StaticResource ErrorRed}" FontSize="20" FontWeight="Black"/>
                            <TextBlock Text="REJECTED" Foreground="{StaticResource TextSub}" FontSize="9" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══════════════════ STATS + FILTER BAR (Redesigned as QuickBooks Toolbar Card) ══════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="15,10" Margin="16,10,16,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════════════ QUICKBOOKS TOOLBAR ══════════════════ -->
                <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Refresh Button -->
                        <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding LoadDataCommand}" ToolTip="Refresh Data">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Refresh" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                        <!-- Leave Application Button -->
                        <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding OpenApplyPanelCommand}" ToolTip="Apply for Leave">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Apply Leave" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Stats, Search & Filters Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>                    

                    <!-- Filter Controls -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ToolbarTextBox}" Width="180" Margin="0,0,10,0" ap:WatermarkProperties.Watermark="Search leave records..." VerticalAlignment="Center"/>
                        <ComboBox SelectedIndex="{Binding SelectedFilterIndex}" Style="{StaticResource ModernComboBox}" Width="130" VerticalAlignment="Center">
                            <ComboBoxItem Content="All Statuses"/>
                            <ComboBoxItem Content="Pending"/>
                            <ComboBoxItem Content="Approved"/>
                            <ComboBoxItem Content="Rejected"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ══════════════════ DATA GRID ══════════════════ -->
        <Border Grid.Row="3" Margin="16,12,16,16" Style="{StaticResource GlassCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
                    <TextBlock Text="LEAVE REGISTER" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#06FFFFFF"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ap:CommandProperties.DoubleClickCommand" Value="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ap:CommandProperties.CommandParameter" Value="{Binding}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding Employee.DisplayName}" Width="160"/>
                        <DataGridTemplateColumn Header="TYPE" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" HorizontalAlignment="Left" Padding="8,3"
                                            Background="{Binding LeaveType, Converter={StaticResource LeaveTypeColorConverter}}" Margin="2">
                                        <TextBlock Text="{Binding LeaveType}" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="FROM" Binding="{Binding StartDate, StringFormat=dd MMM yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="TO" Binding="{Binding EndDate, StringFormat=dd MMM yyyy}" Width="Auto"/>
                        <DataGridTextColumn Header="DAYS" Binding="{Binding NumberOfDays}" Width="Auto"/>
                        <DataGridTemplateColumn Header="STATUS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" HorizontalAlignment="Center" Padding="10,3"
                                            Background="{Binding Status, Converter={StaticResource LeaveStatusColorConverter}}" Opacity="0.9">
                                        <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="REASON" Binding="{Binding Reason}" Width="*"/>
                        <!-- Actions -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Approve -->
                                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Approve Leave"
                                                Command="{Binding DataContext.ApproveLeaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#4CAF50" Margin="5">
                                            <TextBlock Text="&#xE930;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                        <!-- Reject -->
                                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Reject Leave"
                                                Command="{Binding DataContext.RejectLeaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource ErrorRed}" Margin="5">
                                            <TextBlock Text="&#xE8BB;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                        <!-- Print PDF -->
                                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Print Leave Form"
                                                Command="{Binding DataContext.PrintLeaveFormCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource AccentBlue}" Margin="5">
                                            <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                        <!-- Delete -->
                                        <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Delete"
                                                Command="{Binding DataContext.DeleteLeaveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="{StaticResource ErrorRed}" Margin="5">
                                            <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Busy overlay -->
                <Border Grid.Row="0" Grid.RowSpan="2" Background="#80000000"
                        Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

    </Grid>

    <utils:ListViewBase.OverlayContent>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel>
                <TextBlock Text="{Binding PanelHeaderTitle}" Foreground="{StaticResource AccentBlue}"
                           FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Employee -->
                <TextBlock Text="Employee" Style="{StaticResource LabelText}"/>
                <ComboBox ItemsSource="{Binding Employees}"
                          SelectedItem="{Binding SelectedEmployee}"
                          DisplayMemberPath="DisplayName"
                          IsEnabled="{Binding IsEmployeeSelectionEnabled}"
                          Style="{StaticResource ModernComboBox}" Margin="0,4,0,16"/>

                <!-- Leave Type -->
                <TextBlock Text="Leave Type" Style="{StaticResource LabelText}"/>
                <ComboBox ItemsSource="{Binding LeaveTypes}"
                          SelectedItem="{Binding SelectedLeaveType}"
                          Style="{StaticResource ModernComboBox}" Margin="0,4,0,16"/>

                <!-- Date Range -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Start Date" Style="{StaticResource LabelText}"/>
                        <DatePicker SelectedDate="{Binding StartDate}" Style="{StaticResource ModernDatePicker}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="End Date" Style="{StaticResource LabelText}"/>
                        <DatePicker SelectedDate="{Binding EndDate}" Style="{StaticResource ModernDatePicker}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Calculated Days -->
                <Border Padding="12,10" CornerRadius="6" Background="#0A2E9DFF" BorderBrush="#302E9DFF" BorderThickness="1" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE916;" Style="{StaticResource SymbolIcon}" FontSize="16" Foreground="{StaticResource AccentBlue}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock VerticalAlignment="Center">
                            <Run Text="{Binding CalculatedDays}" FontSize="22" FontWeight="Black" Foreground="{StaticResource AccentBlue}"/>
                            <Run Text=" working day(s)" Foreground="{StaticResource TextSub}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Balance Warning -->
                <Border Padding="12,10" CornerRadius="6" Background="#0AFF9800" BorderBrush="#30FF9800" BorderThickness="1" Margin="0,0,0,16"
                        Visibility="{Binding HasBalanceWarning, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="{Binding BalanceWarning}" Foreground="{StaticResource OrangeBrush}" FontSize="11" TextWrapping="Wrap"/>
                </Border>

                <!-- Reason -->
                <TextBlock Text="Reason for Leave" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ModernInput}" Height="80" TextWrapping="Wrap"
                         AcceptsReturn="True" Margin="0,4,0,24"/>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Content="CANCEL"
                            Command="{Binding CloseApplyPanelCommand}" Margin="0,0,12,0" Padding="14,8"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{Binding SubmitButtonText}"
                            Command="{Binding SubmitLeaveCommand}" Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </utils:ListViewBase.OverlayContent>
</utils:ListViewBase>

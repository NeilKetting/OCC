<UserControl x:Class="OCC.WpfClient.Features.AttendanceHub.Views.AttendanceImportPreviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:OCC.Shared.Models;assembly=OCC.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type=vm:AttendanceImportPreviewViewModel}">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter" />
        <ObjectDataProvider x:Key="AttendanceStatusEnum" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="models:AttendanceStatus"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundDarker}" Padding="24" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentBlue}" FontSize="14" FontWeight="Bold"/>
                <TextBlock Text="Review, map, and adjust the clocking data before saving to the database. Rows marked with errors must be resolved." 
                           Foreground="{StaticResource TextSub}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Preview DataGrid -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="True"
                      Style="{StaticResource ModernDataGrid}" HeadersVisibility="Column" SelectionMode="Single" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#334155" RowBackground="Transparent" AlternatingRowBackground="#05ffffff" BorderThickness="0"
                      Background="Transparent">
                <DataGrid.Columns>
                    <!-- Raw Employee Name -->
                    <DataGridTextColumn Header="EXCEL EMPLOYEE" Binding="{Binding RawEmployeeName}" IsReadOnly="True" Width="Auto">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="8,4"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Matched/Selected Employee -->
                    <DataGridTemplateColumn Header="MATCHED SYSTEM EMPLOYEE" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Employees, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding SelectedEmployee, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource ModernComboBox}" Height="28" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Date -->
                    <DataGridTemplateColumn Header="DATE" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <DatePicker SelectedDate="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource ModernDatePicker}" Height="28" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Project -->
                    <DataGridTemplateColumn Header="PROJECT" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DataContext.Projects, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                          SelectedItem="{Binding SelectedProject, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource ModernComboBox}" Height="28" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Custom Site (if other) -->
                    <DataGridTemplateColumn Header="CUSTOM SITE NAME" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CustomSite, UpdateSourceTrigger=PropertyChanged}"
                                          IsEnabled="{Binding IsCustomSiteEnabled}"
                                          Style="{StaticResource ModernInput}" Height="28" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="STATUS" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding Source={StaticResource AttendanceStatusEnum}}"
                                          SelectedItem="{Binding Status, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernComboBox}" Height="28" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Time In -->
                    <DataGridTemplateColumn Header="TIME IN" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CheckInTime, StringFormat=hh\\:mm, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernInput}" Height="28" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Time Out -->
                    <DataGridTemplateColumn Header="TIME OUT" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding CheckOutTime, StringFormat=hh\\:mm, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource ModernInput}" Height="28" Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status Message / Error -->
                    <DataGridTemplateColumn Header="VALIDATION STATUS" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" Margin="8,4" FontSize="11" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                    <Setter Property="Foreground" Value="#10B981"/> <!-- Green -->
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Foreground" Value="#EF4444"/> <!-- Red -->
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource CancelButton}" Content="CANCEL" Command="{Binding CloseCommand}" Margin="0,0,12,0" Padding="16,8"/>
                <Button Style="{StaticResource SaveButton}" Content="SAVE IMPORTED RECORDS" Command="{Binding SaveImportCommand}" Padding="16,8"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

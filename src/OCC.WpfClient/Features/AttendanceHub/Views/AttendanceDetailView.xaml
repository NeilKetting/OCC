<UserControl x:Class="OCC.WpfClient.Features.AttendanceHub.Views.AttendanceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             xmlns:controls="clr-namespace:OCC.WpfClient.CustomControls"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="380"
             d:DataContext="{d:DesignInstance Type=vm:AttendanceDetailViewModel}">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Border Background="{StaticResource BackgroundDarker}" Padding="24,24,15,24">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,25,0">
                <TextBlock Text="{Binding Title}" Foreground="{StaticResource AccentBlue}"
                           FontSize="12" FontWeight="Bold" Margin="0,0,0,20"/>

                <!-- Employee selection (when IsNew is true) -->
                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="Employee" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding Employees}" 
                              SelectedItem="{Binding SelectedEmployee}" 
                              DisplayMemberPath="DisplayName" 
                              Style="{StaticResource ModernComboBox}" 
                              Margin="0,4,0,16"/>
                </StackPanel>

                <!-- Employee display (when IsNew is false) -->
                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="Employee" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding SelectedEmployee.DisplayName, Mode=OneWay}" 
                             Style="{StaticResource ModernInput}" 
                             IsReadOnly="True" 
                             Margin="0,4,0,16"/>
                </StackPanel>

                <!-- Date selection (when IsNew is true) -->
                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="Date" Style="{StaticResource LabelText}"/>
                    <DatePicker SelectedDate="{Binding EditingRecord.Date, UpdateSourceTrigger=PropertyChanged}" 
                                Style="{StaticResource ModernDatePicker}" 
                                Margin="0,4,0,16"/>
                </StackPanel>

                <!-- Date display (when IsNew is false) -->
                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                    <TextBlock Text="Date" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding EditingRecord.Date, StringFormat=yyyy-MM-dd, Mode=OneWay}" 
                             Style="{StaticResource ModernInput}" 
                             IsReadOnly="True" 
                             Margin="0,4,0,16"/>
                </StackPanel>

                <TextBlock Text="Status" Style="{StaticResource LabelText}"/>
                <ComboBox SelectedValue="{Binding Status}" SelectedValuePath="Tag" Style="{StaticResource ModernComboBox}" Margin="0,4,0,16">
                    <ComboBoxItem Content="Present" Tag="Present"/>
                    <ComboBoxItem Content="Late" Tag="Late"/>
                    <ComboBoxItem Content="Absent" Tag="Absent"/>
                    <ComboBoxItem Content="Sick" Tag="Sick"/>
                    <ComboBoxItem Content="Leave Authorized" Tag="LeaveAuthorized"/>
                    <ComboBoxItem Content="Leave Early" Tag="LeaveEarly"/>
                    <ComboBoxItem Content="Unpaid Sick" Tag="UnpaidSick"/>
                </ComboBox>

                <!-- Project Selection (visible for Present/Late/LeaveEarly) -->
                <StackPanel Visibility="{Binding IsProjectSelectorVisible, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="Project / Site" Style="{StaticResource LabelText}"/>
                    <ComboBox ItemsSource="{Binding Projects}" 
                              SelectedItem="{Binding SelectedProject}" 
                              DisplayMemberPath="Name" 
                              Style="{StaticResource ModernComboBox}" 
                              Margin="0,4,0,16"/>
                </StackPanel>

                <!-- Custom Site Name (visible when "Other" is selected) -->
                <StackPanel Visibility="{Binding IsCustomSiteVisible, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="Custom Site Location" Style="{StaticResource LabelText}"/>
                    <TextBox Text="{Binding CustomSiteName, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernInput}" 
                             Margin="0,4,0,16"/>
                </StackPanel>

                <TextBlock Text="Clock In Time" Style="{StaticResource LabelText}"/>
                <controls:ModernTimePicker SelectedTime="{Binding CheckInTimeSpan}" Margin="0,4,0,16"/>

                <TextBlock Text="Clock Out Time" Style="{StaticResource LabelText}"/>
                <controls:ModernTimePicker SelectedTime="{Binding CheckOutTimeSpan}" Margin="0,4,0,16"/>

                <TextBlock Text="Notes" Style="{StaticResource LabelText}"/>
                <TextBox Text="{Binding EditingRecord.Notes, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource ModernInput}" Height="80" TextWrapping="Wrap"
                          AcceptsReturn="True" Margin="0,4,0,16"/>

                <!-- Sick Note Upload — visible when Status is Sick / UnpaidSick -->
                <Border Padding="12" CornerRadius="6"
                        Background="#0A4CAF50" BorderBrush="#304CAF50" BorderThickness="1"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasSickNote, Converter={StaticResource VisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="SICK NOTE ATTACHED" Foreground="#4CAF50" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SickNoteFilePath}" Foreground="{StaticResource TextSub}"
                                   FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Button Style="{StaticResource SecondaryButton}" Margin="0,0,0,16"
                        Command="{Binding UploadSickNoteCommand}"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8A5;" Style="{StaticResource SymbolIcon}" FontSize="14" Margin="0,0,8,0"/>
                        <TextBlock Text="UPLOAD SICK NOTE / DOCTOR'S CERT" VerticalAlignment="Center" FontSize="11"/>
                    </StackPanel>
                </Button>

                <!-- Validation Summary -->
                <Border Margin="0,0,0,15" Background="#1AEE4444" BorderBrush="{StaticResource ErrorRed}" 
                        BorderThickness="1" CornerRadius="8" Padding="12"
                        Visibility="{Binding HasErrors, Converter={StaticResource VisibilityConverter}}">
                    <ItemsControl ItemsSource="{Binding ValidationErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorRed}" FontSize="12" Margin="0,2"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CancelButton}" Content="CANCEL"
                            Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="14,8"/>
                    <Button Style="{StaticResource SaveButton}" Content="SAVE RECORD"
                            Command="{Binding SaveCommand}" Padding="14,8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>

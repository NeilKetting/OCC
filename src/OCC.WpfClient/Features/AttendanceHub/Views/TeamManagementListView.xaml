<local:TeamManagementListViewBase
    x:Class="OCC.WpfClient.Features.AttendanceHub.Views.TeamManagementListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:OCC.WpfClient.Features.AttendanceHub.Views"
    xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
    xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
    mc:Ignorable="d"
    d:DesignHeight="800" d:DesignWidth="980"
    d:DataContext="{d:DesignInstance vm:TeamManagementViewModel}"
    IsDrawerOpen="{Binding IsDetailPanelOpen, Mode=TwoWay}"
    OverlayContent="{Binding}"
    DrawerWidth="380">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:TeamManagementViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>  <!-- Panel header -->
                        <RowDefinition Height="Auto"/>  <!-- Team name / desc -->
                        <RowDefinition Height="*"/>     <!-- Members section -->
                        <RowDefinition Height="Auto"/>  <!-- Footer actions -->
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Grid.Row="0" Padding="16,12"
                            BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="EDIT TEAM"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCreating}" Value="True">
                                                <Setter Property="Text" Value="CREATE TEAM"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Style="{StaticResource ToolbarIconButton}" 
                                    Command="{Binding CloseDetailCommand}" ToolTip="Close" Foreground="{StaticResource TextSub}">
                                <TextBlock Text="&#xE8BB;" Style="{StaticResource SymbolIcon}" FontSize="16"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Team Details -->
                    <StackPanel Grid.Row="1" Margin="16,16,16,0">
                        <TextBlock Text="Team Name" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernInput}" Margin="0,4,0,12"/>

                        <TextBlock Text="Description" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding EditDescription, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernInput}" Height="64" TextWrapping="Wrap"
                                 AcceptsReturn="True" Margin="0,4,0,12"/>

                        <Button Style="{StaticResource SaveButton}" Command="{Binding SaveTeamCommand}" Padding="14,8" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="SAVE DETAILS"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Members Section -->
                    <Border Grid.Row="2" Margin="0,16,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Members header -->
                            <Border Grid.Row="0" Padding="16,8"
                                    BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,1">
                                <TextBlock Text="TEAM MEMBERS" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold"/>
                            </Border>

                            <!-- Current Members List -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding TeamMembers}" Margin="12,8">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,3" Padding="12,8" Background="#08FFFFFF" CornerRadius="6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Avatar -->
                                                    <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentBlue}" Margin="0,0,10,0">
                                                        <TextBlock Foreground="White" FontWeight="Bold" FontSize="13"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Text="{Binding Name, Converter={StaticResource UserInitialsConverter}}"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Role}" Foreground="{StaticResource TextSub}" FontSize="11"/>
                                                    </StackPanel>
                                                    <!-- Remove Button -->
                                                    <Button Grid.Column="2" Style="{StaticResource ToolbarIconButton}"
                                                            Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Remove from team"
                                                            Foreground="{StaticResource ErrorRed}">
                                                        <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="13"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Add Member section -->
                            <Border Grid.Row="2" Padding="12,10"
                                    BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0"
                                    Visibility="{Binding IsCreating, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding AvailableEmployees}"
                                              SelectedItem="{Binding SelectedAvailableEmployee}"
                                              Style="{StaticResource ModernComboBox}"
                                              DisplayMemberPath="DisplayName"
                                              Margin="0,0,8,0"/>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                            Command="{Binding AddMemberCommand}" Padding="12,8" ToolTip="Add to team">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Footer -->
                    <Border Grid.Row="3" Padding="16,10"
                            BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource CancelButton}"
                                Command="{Binding DeleteTeamCommand}"
                                CommandParameter="{Binding SelectedTeam}"
                                HorizontalAlignment="Right" Padding="14,8"
                                Visibility="{Binding IsCreating, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource SymbolIcon}" FontSize="13" Margin="0,0,8,0"/>
                                <TextBlock Text="DELETE TEAM"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══════════════════ PAGE HEADER ══════════════════ -->
            <Border Grid.Row="0" Margin="16,12,16,4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="&#xE902;" Style="{StaticResource SymbolIcon}" 
                               Foreground="#34D399" FontSize="36" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="TEAM MANAGEMENT" Style="{StaticResource HeaderText}" FontFamily="{StaticResource MichromaFont}" FontSize="20" Foreground="White"/>
                        <TextBlock Text="Configure teams and assign members." Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Toolbar & Search Line -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="16,6,16,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Create Team Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding AddTeamCommand}" ToolTip="Create a new Team">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Create Team" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search Row -->
                    <Grid Grid.Row="1">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="&#xE721;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" Width="200" ap:WatermarkProperties.Watermark="Search teams..."/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Teams DataGrid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Margin="16,0,16,16" Padding="1" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}"
                          SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#06FFFFFF"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TEAM NAME" Binding="{Binding Name}" Width="Auto"/>
                        <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="Auto"/>
                        <DataGridTemplateColumn Header="MEMBERS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource AccentBlue}" CornerRadius="10"
                                            Padding="10,3" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Members.Count}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <!-- Actions -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ToolbarIconButton}" Margin="5" ToolTip="Open / Edit Team"
                                                Command="{Binding DataContext.OpenTeamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</local:TeamManagementListViewBase>

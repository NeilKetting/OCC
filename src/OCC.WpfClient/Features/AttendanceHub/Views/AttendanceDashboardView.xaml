<local:AttendanceDashboardViewBase x:Class="OCC.WpfClient.Features.AttendanceHub.Views.AttendanceDashboardView"
             IsDrawerOpen="{Binding IsOverlayActive}"
             OverlayContent="{Binding OverlayViewModel}"
             DrawerWidth="420"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OCC.WpfClient.Features.AttendanceHub.Views"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="980"
             d:DataContext="{d:DesignInstance vm:AttendanceDashboardViewModel}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header bar -->
            <RowDefinition Height="Auto"/>  <!-- Stats cards -->
            <RowDefinition Height="Auto"/>  <!-- Filter Toolbar -->
            <RowDefinition Height="*"/>     <!-- Roll-call grid -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ HEADER ══════════════════ -->
        <Border Grid.Row="0" Padding="20,12" Background="#06FFFFFF" 
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="TODAY'S ROLL CALL" Style="{StaticResource HeaderText}"/>
                    <TextBlock Text="{Binding TodayDate}" Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding LoadDashboardDataCommand}"
                            ToolTip="Refresh" Margin="8,0,0,0">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="16" Margin="0,0,8,0"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ STATS CARDS ══════════════════ -->
        <UniformGrid Grid.Row="1" Rows="1" Margin="16,14,16,0">
            <!-- Present -->
            <Border Margin="0,0,8,0" Padding="16,14" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedCardFilter}" Value="Present">
                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByCardCommand}" CommandParameter="Present"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="PRESENT" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PresentCount}" Foreground="#4CAF50" FontSize="32" FontWeight="Black" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding AttendanceRate, StringFormat={}{0}% attendance rate}" Foreground="{StaticResource TextSub}" FontSize="11"/>
                </StackPanel>
            </Border>
            <!-- Absent -->
            <Border Margin="4,0,4,0" Padding="16,14" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedCardFilter}" Value="Absent">
                                <Setter Property="BorderBrush" Value="#F44336"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByCardCommand}" CommandParameter="Absent"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="ABSENT" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding AbsentCount}" Foreground="#F44336" FontSize="32" FontWeight="Black" Margin="0,4,0,2"/>
                    <TextBlock Text="No show / unexcused" Foreground="{StaticResource TextSub}" FontSize="11"/>
                </StackPanel>
            </Border>
            <!-- Late -->
            <Border Margin="4,0,4,0" Padding="16,14" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedCardFilter}" Value="Late">
                                <Setter Property="BorderBrush" Value="#FF9800"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByCardCommand}" CommandParameter="Late"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="LATE ARRIVALS" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding LateCount}" Foreground="#FF9800" FontSize="32" FontWeight="Black" Margin="0,4,0,2"/>
                    <TextBlock Text="After shift start" Foreground="{StaticResource TextSub}" FontSize="11"/>
                </StackPanel>
            </Border>
            <!-- Total -->
            <Border Margin="8,0,0,0" Padding="16,14" Cursor="Hand">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource GlassCard}">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#15FFFFFF"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding SelectedCardFilter}" Value="All">
                                <Setter Property="BorderBrush" Value="{StaticResource AccentBlue}"/>
                                <Setter Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding FilterByCardCommand}" CommandParameter="All"/>
                </Border.InputBindings>
                <StackPanel>
                    <TextBlock Text="TOTAL EMPLOYEES" Foreground="{StaticResource TextSub}" FontSize="10" FontWeight="Bold"/>
                    <TextBlock Text="{Binding TotalExpected}" Foreground="White" FontSize="32" FontWeight="Black" Margin="0,4,0,2"/>
                    <TextBlock Text="Active staff on record" Foreground="{StaticResource TextSub}" FontSize="11"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ══════════════════ FILTER TOOLBAR ══════════════════ -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="15,10" Margin="16,12,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{StaticResource ModernInput}" Height="32" Padding="8,0" BorderThickness="0" Background="Transparent"
                         ap:WatermarkProperties.Watermark="Search employees..."/>

                <Border Grid.Column="2" Width="1" Height="20" Background="{StaticResource GlassBorder}" Margin="15,0" VerticalAlignment="Center"/>

                <!-- Branch Filter -->
                <ComboBox Grid.Column="4" SelectedIndex="{Binding SelectedBranchIndex}" Style="{StaticResource ModernComboBox}" Height="30" VerticalAlignment="Center">
                    <ComboBoxItem Content="All Branches" />
                    <ComboBoxItem Content="Johannesburg" />
                    <ComboBoxItem Content="Cape Town" />
                </ComboBox>

                <!-- Not Present Filter Toggle -->
                <Button Grid.Column="6" Command="{Binding ToggleNotPresentFilterCommand}"
                        ToolTip="Show only employees not yet confirmed present"
                        Height="32" VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowNotPresentOnly}" Value="True">
                                    <Setter Property="Background" Value="#20FF9800"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource OrangeBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="&#xE8F8;" Style="{StaticResource SymbolIcon}" FontSize="14" Margin="0,0,6,0"
                                   Foreground="{StaticResource OrangeBrush}"/>
                        <TextBlock Text="NOT PRESENT" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource OrangeBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══════════════════ ROLL CALL GRID ══════════════════ -->
        <Border Grid.Row="3" Margin="16,12,16,16" Style="{StaticResource GlassCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,10" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
                    <TextBlock Text="EMPLOYEE STATUS" Foreground="{StaticResource AccentBlue}" 
                               FontSize="11" FontWeight="Bold"/>
                </Border>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding TodayRows}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          SelectionMode="Single"
                          RowBackground="Transparent"
                          AlternatingRowBackground="#06FFFFFF"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu Style="{StaticResource ModernContextMenu}">
                                        <!-- Edit (always available) -->
                                        <MenuItem Header="Edit" 
                                                  Command="{Binding PlacementTarget.Tag.EditEmployeeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                  CommandParameter="{Binding}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE70F;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <!-- Mark Absent (if not already absent) -->
                                        <MenuItem Header="Mark Absent" 
                                                  Command="{Binding PlacementTarget.Tag.MarkAbsentEmployeeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding IsAbsent, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xE8F8;" Style="{StaticResource SymbolIcon}" Foreground="#FF9800" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <!-- Clock In / Mark Present (if absent or not clocked) -->
                                        <MenuItem Header="Clock In / Mark Present" 
                                                  Command="{Binding PlacementTarget.Tag.ClockInEmployeeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding IsClocked, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xEA3A;" Style="{StaticResource SymbolIcon}" Foreground="#4CAF50" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <!-- Clock Out (if currently clocked) -->
                                        <MenuItem Header="Clock Out" 
                                                  Command="{Binding PlacementTarget.Tag.ClockOutEmployeeCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" 
                                                  CommandParameter="{Binding}"
                                                  Visibility="{Binding IsClocked, Converter={StaticResource VisibilityConverter}}">
                                            <MenuItem.Icon>
                                                <TextBlock Text="&#xEDA3;" Style="{StaticResource SymbolIcon}" Foreground="#FF5722" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <!-- Employee -->
                        <DataGridTextColumn Header="EMP #" Binding="{Binding EmployeeNumber}" Width="Auto"/>
                        <DataGridTextColumn Header="EMPLOYEE" Binding="{Binding EmployeeName}" Width="Auto"/>
                        <DataGridTextColumn Header="ROLE" Binding="{Binding Role}" Width="Auto"/>
                        <DataGridTextColumn Header="BRANCH" Binding="{Binding Branch}" Width="Auto"/>

                        <!-- Status badge (template column) -->
                        <DataGridTemplateColumn Header="STATUS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" HorizontalAlignment="Center"
                                            Background="{Binding StatusColor}" Opacity="0.9"
                                            Padding="10,3">
                                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="White" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="CLOCK IN" Binding="{Binding CheckInDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="CLOCK OUT" Binding="{Binding CheckOutDisplay}" Width="Auto"/>
                        <DataGridTextColumn Header="HOURS" Binding="{Binding HoursDisplay}" Width="Auto"/>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Mark Absent -->
                                        <Button Style="{StaticResource ToolbarIconButton}"
                                                ToolTip="Mark Absent"
                                                Visibility="{Binding IsAbsent, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"
                                                Command="{Binding DataContext.MarkAbsentEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#FF9800" Margin="5">
                                            <TextBlock Text="&#xE8F8;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                        <!-- Clock In -->
                                        <Button Style="{StaticResource ToolbarIconButton}"
                                                ToolTip="Clock In"
                                                Visibility="{Binding IsClocked, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}"
                                                Command="{Binding DataContext.ClockInEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#4CAF50" Margin="5">
                                            <TextBlock Text="&#xEA3A;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                        <!-- Clock Out -->
                                        <Button Style="{StaticResource ToolbarIconButton}"
                                                ToolTip="Clock Out"
                                                Visibility="{Binding IsClocked, Converter={StaticResource VisibilityConverter}}"
                                                Command="{Binding DataContext.ClockOutEmployeeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Foreground="#FF5722" Margin="5">
                                            <TextBlock Text="&#xEDA3;" Style="{StaticResource SymbolIcon}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Busy overlay -->
                <Border Grid.Row="0" Grid.RowSpan="2" Background="#80000000" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="14" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</local:AttendanceDashboardViewBase>

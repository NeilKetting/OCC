<local:LoansManagementListViewBase x:Class="OCC.WpfClient.Features.AttendanceHub.Views.LoansManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:OCC.WpfClient.Features.AttendanceHub.Views"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.AttendanceHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance vm:LoansManagementViewModel}"
             IsDrawerOpen="{Binding IsAddPanelVisible, Mode=TwoWay}"
             OverlayContent="{Binding}"
             DrawerWidth="340">

    <local:LoansManagementListViewBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <DataTemplate DataType="{x:Type vm:LoansManagementViewModel}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Panel Header -->
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="ADD NEW LOAN" Style="{StaticResource HeaderText}" FontSize="14" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource ToolbarIconButton}"
                                    Command="{Binding CancelAddCommand}">
                                <TextBlock Text="&#xE711;" Style="{StaticResource SymbolButtonIcon}"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Form Fields -->
                    <ScrollViewer Grid.Row="1" Padding="16,12">
                        <StackPanel>
                            <!-- Employee -->
                            <TextBlock Text="EMPLOYEE" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Employees}"
                                      SelectedItem="{Binding SelectedEmployee}"
                                      Style="{StaticResource ModernComboBox}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="0,0,0,14"/>

                            <!-- Principal -->
                            <TextBlock Text="PRINCIPAL AMOUNT (R)" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding PrincipalAmount, StringFormat='F2', UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ModernInput}" TextAlignment="Right" Margin="0,0,0,14"/>

                            <!-- Payment Frequency -->
                            <TextBlock Text="PAYMENT FREQUENCY" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <ComboBox SelectedValue="{Binding SelectedPaymentFrequency, Mode=TwoWay}"
                                      SelectedValuePath="Content"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,0,14">
                                <ComboBoxItem Content="Fortnightly"/>
                                <ComboBoxItem Content="Monthly"/>
                            </ComboBox>

                            <!-- Number of Installments -->
                            <TextBlock Text="NUMBER OF INSTALMENTS" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding NumberOfInstallments, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ModernInput}" TextAlignment="Right" Margin="0,0,0,14"/>

                            <!-- Calculated Installment -->
                            <TextBlock Text="CALCULATED INSTALMENT (R)" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding MonthlyInstallment, StringFormat='F2', Mode=OneWay}"
                                     IsReadOnly="True" Focusable="False"
                                     Style="{StaticResource ModernInput}" TextAlignment="Right" Margin="0,0,0,14"/>

                            <!-- Interest Rate -->
                            <TextBlock Text="INTEREST RATE (%)" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding InterestRate, StringFormat='0.00', UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ModernInput}" TextAlignment="Right" Margin="0,0,0,4"/>
                            <TextBlock Text="Leave 0 for interest-free" Style="{StaticResource LabelText}" 
                                       Opacity="0.5" FontSize="10" Margin="0,0,0,14"/>

                            <!-- Start Date -->
                            <TextBlock Text="START DATE" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <DatePicker SelectedDate="{Binding LoanStartDate}"
                                        Style="{StaticResource ModernDatePicker}" Margin="0,0,0,14"/>

                            <!-- Notes -->
                            <TextBlock Text="NOTES" Style="{StaticResource LabelText}" Margin="0,0,0,6"/>
                            <TextBox Text="{Binding LoanNotes, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernInput}" Height="60"
                                     TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,20"/>

                            <!-- Repayment Summary Card -->
                            <Border Background="#0AFFFFFF" CornerRadius="6" Padding="12" 
                                    BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="REPAYMENT SUMMARY" Style="{StaticResource LabelText}"
                                               Margin="0,0,0,10" FontWeight="SemiBold"/>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Calculated Duration:" Style="{StaticResource LabelText}" Opacity="0.7"/>
                                        <TextBlock Grid.Column="1" Text="{Binding RepaymentDurationText}"
                                                   FontWeight="Bold" Foreground="{StaticResource OrangeBrush}"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Total Repayable:" Style="{StaticResource LabelText}" Opacity="0.7"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalRepayableAmount, StringFormat='R #,##0.00'}"
                                                   FontWeight="Bold" Foreground="{StaticResource OrangeBrush}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Panel Footer Actions -->
                    <Border Grid.Row="2" Padding="16,12" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource GhostButton}"
                                    Command="{Binding CancelAddCommand}" Margin="0,0,8,0"/>
                            <Button Content="SAVE LOAN" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding SaveLoanCommand}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </local:LoansManagementListViewBase.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════ LOANS LIST ══════════════════ -->
        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="16,10" Background="#06FFFFFF"
                BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LOANS HUB" Style="{StaticResource HeaderText}"/>
                    <TextBlock Style="{StaticResource LabelText}" Opacity="0.7" Margin="0,2,0,0">
                        <Run Text="Manage staff loans and repayment schedules"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Command="{Binding LoadDataCommand}" ToolTip="Refresh">
                        <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolButtonIcon}" Foreground="{StaticResource AccentBlue}"/>
                    </Button>
                    <Button Command="{Binding ShowAddPanelCommand}" Style="{StaticResource CreateButton}" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="NEW LOAN"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════ SEARCH & FILTERS TOOLBAR ══════════════════ -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="16,10,16,5">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Search & Core Filters -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- Search Icon -->
                        <ColumnDefinition Width="220" /> <!-- Search TextBox -->
                        <ColumnDefinition Width="Auto" /> <!-- Divider -->
                        <ColumnDefinition Width="Auto" /> <!-- Branch Label -->
                        <ColumnDefinition Width="130" /> <!-- Branch ComboBox -->
                        <ColumnDefinition Width="Auto" /> <!-- Status Label -->
                        <ColumnDefinition Width="130" /> <!-- Status ComboBox -->
                        <ColumnDefinition Width="*" />    <!-- Spacer -->
                        <ColumnDefinition Width="Auto" /> <!-- Buttons -->
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBlock Text="&#xE11A;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" VerticalAlignment="Center" Margin="5,0,5,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ModernInput}" Height="30" Padding="8,0" BorderThickness="0" Background="Transparent"
                             ap:WatermarkProperties.Watermark="Search by Employee..."/>

                    <!-- Divider -->
                    <Border Grid.Column="2" Width="1" Height="20" Background="{StaticResource GlassBorder}" Margin="15,0" VerticalAlignment="Center"/>

                    <!-- Branch -->
                    <TextBlock Grid.Column="3" Text="Branch: " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.8"/>
                    <ComboBox Grid.Column="4" SelectedValue="{Binding BranchFilter, Mode=TwoWay}" SelectedValuePath="Content"
                              Height="30" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="JHB"/>
                        <ComboBoxItem Content="CPT"/>
                    </ComboBox>

                    <!-- Status -->
                    <TextBlock Grid.Column="5" Text="Status: " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="15,0,8,0" Opacity="0.8"/>
                    <ComboBox Grid.Column="6" SelectedValue="{Binding StatusFilter, Mode=TwoWay}" SelectedValuePath="Content"
                              Height="30" Style="{StaticResource ModernComboBox}">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Paid"/>
                    </ComboBox>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding ToggleAdvancedFiltersCommand}" Style="{StaticResource GhostButton}" Height="30" Padding="10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" Style="{StaticResource SymbolButtonIcon}" Margin="0,0,6,0" FontSize="12"/>
                                <TextBlock Text="ADVANCED FILTERS" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ClearFiltersCommand}" Style="{StaticResource GhostButton}" Height="30" Padding="10,0" Margin="8,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE894;" Style="{StaticResource SymbolButtonIcon}" Margin="0,0,6,0" FontSize="12" Foreground="#E81123"/>
                                <TextBlock Text="CLEAR" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PrintFilteredLoansCommand}" Style="{StaticResource ToolbarButton}" Height="30" Margin="8,0,0,0" Foreground="{StaticResource TextMain}">
                            <StackPanel Orientation="Horizontal" Margin="8,0">
                                <TextBlock Text="&#xE749;" Style="{StaticResource SymbolButtonIcon}" Foreground="White" FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="PRINT LIST" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Advanced Range Filters -->
                <Grid Grid.Row="1" Margin="0,10,0,0" Visibility="{Binding IsAdvancedFiltersVisible, Converter={StaticResource BoolToVis}}">
                    <WrapPanel Orientation="Horizontal">
                        <!-- Principal Range -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                            <TextBlock Text="Principal Range:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="95" Opacity="0.8"/>
                            <TextBox Text="{Binding MinPrincipal, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Min R"/>
                            <TextBlock Text=" to " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding MaxPrincipal, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Max R"/>
                        </StackPanel>

                        <!-- Installment Range -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                            <TextBlock Text="Installment Range:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="105" Opacity="0.8"/>
                            <TextBox Text="{Binding MinInstallment, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Min R"/>
                            <TextBlock Text=" to " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding MaxInstallment, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Max R"/>
                        </StackPanel>

                        <!-- Balance Range -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                            <TextBlock Text="Balance Range:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="95" Opacity="0.8"/>
                            <TextBox Text="{Binding MinBalance, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Min R"/>
                            <TextBlock Text=" to " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding MaxBalance, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Max R"/>
                        </StackPanel>

                        <!-- Interest Rate Range -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                            <TextBlock Text="Interest % Range:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="100" Opacity="0.8"/>
                            <TextBox Text="{Binding MinInterestRate, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Min %"/>
                            <TextBlock Text=" to " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBox Text="{Binding MaxInterestRate, UpdateSourceTrigger=LostFocus}" Style="{StaticResource ModernInput}" Width="80" Height="28" ap:WatermarkProperties.Watermark="Max %"/>
                        </StackPanel>

                        <!-- Start Date Range -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                            <TextBlock Text="Start Date Range:" Style="{StaticResource LabelText}" VerticalAlignment="Center" Width="105" Opacity="0.8"/>
                            <DatePicker SelectedDate="{Binding StartDateFrom}" Style="{StaticResource ModernDatePicker}" Width="120" Height="28" Margin="0"/>
                            <TextBlock Text=" to " Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="5,0"/>
                            <DatePicker SelectedDate="{Binding StartDateTo}" Style="{StaticResource ModernDatePicker}" Width="120" Height="28" Margin="0"/>
                        </StackPanel>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Loans DataGrid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding LoansView}"
                  SelectedItem="{Binding SelectedLoan}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  Style="{StaticResource ModernDataGrid}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Employee" Binding="{Binding Employee.DisplayName}" MinWidth="200" Width="*"/>
                <DataGridTextColumn Header="Branch" Binding="{Binding Employee.Branch}" Width="100"/>
                <DataGridTextColumn Header="Principal" Binding="{Binding PrincipalAmount, StringFormat='R #,##0.00'}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Installment" Binding="{Binding MonthlyInstallment, StringFormat='R #,##0.00'}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Balance" Binding="{Binding OutstandingBalance, StringFormat='R #,##0.00'}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Interest %" Binding="{Binding InterestRate, StringFormat='0.00%'}" Width="80">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Center"/></Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Start Date" Binding="{Binding StartDate, StringFormat='dd MMM yyyy'}" Width="110"/>
                <!-- Status badge -->
                <DataGridTemplateColumn Header="Status" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border CornerRadius="4" Padding="8,3" HorizontalAlignment="Center"
                                    Margin="4,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1022C55A"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                <Setter Property="Background" Value="#10808080"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="SemiBold" FontSize="11">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="ACTIVE"/>
                                            <Setter Property="Foreground" Value="#22C55A"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                    <Setter Property="Text" Value="PAID"/>
                                                    <Setter Property="Foreground" Value="#808080"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- Actions -->
                <DataGridTemplateColumn Header="Actions" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Print Loan Schedule"
                                        Command="{Binding DataContext.PrintLoanScheduleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource SymbolButtonIcon}" Foreground="{StaticResource OrangeBrush}"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Print Loan Statement"
                                        Command="{Binding DataContext.PrintLoanStatementCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="4,0,0,0">
                                    <TextBlock Text="&#xE8F2;" Style="{StaticResource SymbolButtonIcon}" Foreground="{StaticResource AccentBlue}"/>
                                </Button>
                                <Button Style="{StaticResource ToolbarIconButton}" ToolTip="Mark as Paid / Terminate"
                                        Command="{Binding DataContext.TerminateLoanCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Margin="4,0,0,0">
                                    <TextBlock Text="&#xE930;" Style="{StaticResource SymbolButtonIcon}" Foreground="#22C55A"/>
                                </Button>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Busy Overlay -->
        <Border Grid.RowSpan="3" Background="#88000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4"
                             Foreground="{StaticResource OrangeBrush}" BorderThickness="0"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" FontSize="13"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</local:LoansManagementListViewBase>

<UserControl x:Class="OCC.WpfClient.Features.TodoHub.Views.TodoHubView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:OCC.WpfClient.Features.TodoHub.Views"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.TodoHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             xmlns:conv="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100"
             d:DataContext="{d:DesignInstance Type=vm:TodoHubViewModel, IsDesignTimeCreatable=False}">
    
    <UserControl.Resources>
        <!-- Converter to check if due date is overdue -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <!-- Strike-through text style for completed to-dos -->
        <Style x:Key="TodoTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TodoNotesStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                    <Setter Property="Opacity" Value="0.6"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30,20,30,30">
        <Border Background="{StaticResource GlassBackground}" 
                BorderBrush="{StaticResource GlassBorder}" 
                BorderThickness="1" 
                CornerRadius="16" 
                ClipToBounds="True">
            
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ==========================================
                     LEFT SIDEBAR: NEW TODO & SETTINGS
                     ========================================== -->
                <Border Grid.Column="0" 
                        Background="#0AFFFFFF" 
                        BorderBrush="{StaticResource GlassBorderUltraLight}" 
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Border Grid.Row="0" Padding="24" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
                            <StackPanel>
                                <TextBlock Text="Personal To-Dos" FontSize="22" FontFamily="{StaticResource MichromaFont}" Foreground="White" />
                                <TextBlock Text="Manage tasks with Outlook calendar sync." Margin="0,6,0,0" Foreground="{StaticResource TextSub}" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Form Content -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="24">
                                <!-- Create Form -->
                                <TextBlock Text="CREATE NEW TO-DO" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,16"/>

                                <TextBlock Text="Task Title" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding NewTitle, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernInput}" 
                                         ap:WatermarkProperties.Watermark="What needs to be done?"
                                         Margin="0,8,0,16"/>

                                <TextBlock Text="Notes" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding NewNotes, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernInput}" 
                                         Height="80" 
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         ap:WatermarkProperties.Watermark="Additional details..."
                                         Margin="0,8,0,16"/>

                                <TextBlock Text="Due Date" Style="{StaticResource FormLabelText}"/>
                                <DatePicker SelectedDate="{Binding NewDueDate}" 
                                            Style="{StaticResource ModernDatePicker}"
                                            Margin="0,8,0,16"/>

                                <CheckBox Content="All Day Task" 
                                          IsChecked="{Binding IsAllDay}" 
                                          Style="{StaticResource ModernCheckBox}" 
                                          Margin="0,0,0,16"/>

                                <StackPanel Visibility="{Binding IsAllDay, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                    <TextBlock Text="Start Time" Style="{StaticResource FormLabelText}"/>
                                    <TextBox Text="{Binding NewTime, UpdateSourceTrigger=PropertyChanged}" 
                                             Style="{StaticResource ModernTimePicker}" 
                                             ap:WatermarkProperties.Watermark="e.g. 08:30"
                                             Margin="0,8,0,20"/>
                                </StackPanel>

                                <Button Content="Add Task" 
                                        Command="{Binding AddTodoCommand}" 
                                        Style="{StaticResource SaveButton}" 
                                        HorizontalAlignment="Stretch" 
                                        Height="36"
                                        IsEnabled="{Binding IsAdding, Converter={StaticResource InverseBooleanConverter}}"/>

                                <Separator Margin="0,24" Background="{StaticResource GlassBorderUltraLight}"/>

                                <!-- Settings -->
                                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextSub}" Margin="0,0,0,16"/>

                                <CheckBox Content="Show Completed Tasks" 
                                          IsChecked="{Binding ShowCompleted}" 
                                          Style="{StaticResource ModernCheckBox}" 
                                          Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding DisableOutlookSync, Converter={StaticResource InverseBooleanConverter}}" 
                                              Style="{StaticResource ModernToggleSwitch}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Sync to Outlook" FontWeight="SemiBold" Foreground="White" FontSize="12"/>
                                        <TextBlock Text="Add new tasks directly to your Outlook calendar." FontSize="11" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Footer -->
                        <Border Grid.Row="2" Padding="24" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                            <Button Content="Back to Dashboard" 
                                    Command="{Binding CloseCommand}" 
                                    Style="{StaticResource CancelButton}" 
                                    HorizontalAlignment="Stretch"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- ==========================================
                     RIGHT CONTENT: TODO LIST
                     ========================================== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header bar -->
                    <Border Grid.Row="0" Padding="24,20" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1" Background="#03FFFFFF">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Tasks List" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Border Background="#1AFF8F00" CornerRadius="10" Padding="8,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FilteredTodos.Count, StringFormat='{}{0} Pending'}" Foreground="{StaticResource OrangeBrush}" FontSize="11" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>

                            <Button HorizontalAlignment="Right"
                                    Command="{Binding LoadTodosCommand}" 
                                    Style="{StaticResource GhostButton}"
                                    Padding="8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Refresh" Margin="6,0,0,0" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- To-Dos Scroll list -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <Grid>
                            <!-- Empty State -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,100,0,0"
                                        Visibility="{Binding FilteredTodos.Count, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                <Border Width="64" Height="64" CornerRadius="32" Background="#0AFFFFFF" HorizontalAlignment="Center">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="No pending to-dos" FontSize="16" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,16,0,4"/>
                                <TextBlock Text="Create a task in the left sidebar to get started." FontSize="13" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- Items List -->
                            <ItemsControl ItemsSource="{Binding FilteredTodos}"
                                          Visibility="{Binding FilteredTodos.Count, Converter={StaticResource VisibilityConverter}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type Dto:PersonalTodoDto}" xmlns:Dto="clr-namespace:OCC.Shared.DTOs;assembly=OCC.Shared">
                                        <Border Margin="0,0,0,12" 
                                                Background="#0AFFFFFF" 
                                                BorderBrush="{StaticResource GlassBorderUltraLight}" 
                                                BorderThickness="1" 
                                                CornerRadius="10" 
                                                Padding="16,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- 1. Checkbox for Complete -->
                                                <CheckBox Grid.Column="0" 
                                                          IsChecked="{Binding IsComplete, Mode=OneWay}"
                                                          Command="{Binding DataContext.ToggleCompleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          CommandParameter="{Binding}"
                                                          Style="{StaticResource ModernCheckBox}"
                                                          VerticalAlignment="Top" 
                                                          Margin="0,2,16,0"/>

                                                <!-- 2. Text Details -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TodoTitleStyle}" />
                                                    <TextBlock Text="{Binding Notes}" Style="{StaticResource TodoNotesStyle}" 
                                                               Visibility="{Binding Notes, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                    
                                                    <!-- Metadata (Due Date, Outlook Sync Status) -->
                                                    <WrapPanel Margin="0,8,0,0">
                                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="12" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding DueDate, Converter={StaticResource TodoDueDateConverter}}" Foreground="{StaticResource TextSub}" FontSize="11" Margin="6,0,16,0" VerticalAlignment="Center"/>

                                                        <StackPanel Orientation="Horizontal" Visibility="{Binding OutlookEventId, Converter={StaticResource StringToVisibilityConverter}}">
                                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="11" Foreground="#0078D4" VerticalAlignment="Center"/>
                                                            <TextBlock Text="Synced to Outlook" Foreground="#5A95D4" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </WrapPanel>
                                                </StackPanel>

                                                <!-- 3. Actions -->
                                                <Button Grid.Column="2" 
                                                        Command="{Binding DataContext.DeleteTodoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}"
                                                        Padding="8"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#EF4444" FontSize="14"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="OCC.WpfClient.Features.Main.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.Main.ViewModels"
             xmlns:views="clr-namespace:OCC.WpfClient.Features.Main.Views"
             xmlns:empViews="clr-namespace:OCC.WpfClient.Features.EmployeeHub.Views"
             xmlns:empVm="clr-namespace:OCC.WpfClient.Features.EmployeeHub.ViewModels"
             xmlns:chatViews="clr-namespace:OCC.WpfClient.Features.ChatHub.Views"
             xmlns:chatVm="clr-namespace:OCC.WpfClient.Features.ChatHub.ViewModels"
             xmlns:shViews="clr-namespace:OCC.WpfClient.Features.SupportHub.Views"
             xmlns:shVm="clr-namespace:OCC.WpfClient.Features.SupportHub.ViewModels"
             xmlns:utils="clr-namespace:OCC.WpfClient.Infrastructure"
             mc:Ignorable="d"
             d:Height="700" d:Width="1024"
             MinWidth="1024" MinHeight="700">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/FeatureTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <utils:BindingProxy x:Key="MainProxy" Data="{Binding}" />

            <Storyboard x:Key="ExpandSidebar" Timeline.DesiredFrameRate="60">
                <DoubleAnimation Storyboard.TargetName="SidebarBorder" 
                                 Storyboard.TargetProperty="Width" 
                                 To="280" Duration="0:0:0.6"
                                 BeginTime="0:0:0.3">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>
            <Storyboard x:Key="CollapseSidebar" Timeline.DesiredFrameRate="60">
                <DoubleAnimation Storyboard.TargetName="SidebarBorder" 
                                 Storyboard.TargetProperty="Width" 
                                 To="72" Duration="0:0:0.8">
                    <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                    </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard>

            <Storyboard x:Key="BusySpinnerAnimation">
                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                 From="0" To="360" Duration="0:0:1"
                                 RepeatBehavior="Forever" />
            </Storyboard>

            <Style x:Key="OverlayCloseButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#40FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SidebarIconStyle" TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
                <Setter Property="Foreground" Value="{Binding IconColor, FallbackValue=White}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Data.UsePlainMenuIcons, Source={StaticResource MainProxy}}" Value="True">
                        <Setter Property="Foreground" Value="White"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ShellRoot">
        <!-- Full Window Background (No row constraints) -->
        <Image Source="/Assets/Images/occ_future_logo.png" Stretch="UniformToFill" />
        <Rectangle Fill="{StaticResource BackgroundDark}" Opacity="0.75" />

        <!-- Dynamic Hub Backdrop -->
        <Rectangle Fill="Black" Opacity="0" IsHitTestVisible="False">
            <Rectangle.Style>
                <Style TargetType="Rectangle">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ActiveHub, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Invert'}" Value="Visible">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.4"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.6"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Rectangle.Style>
        </Rectangle>

        <!-- Top Menu (File, Edit, etc.) -->
        <!-- Floating at the top, matching the MainWindow's height, but not using Panel.ZIndex to avoid blocking window buttons -->
        <Grid VerticalAlignment="Top" Height="32" Background="Transparent">
            <Menu HorizontalAlignment="Left" Background="Transparent" WindowChrome.IsHitTestVisibleInChrome="True">
                <MenuItem Header="File">
                    <MenuItem Header="Exit" Command="{Binding ExitAppCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Edit">
                    <MenuItem Header="Cut"/>
                    <MenuItem Header="Copy"/>
                    <MenuItem Header="Paste"/>
                    <MenuItem Header="Delete"/>
                </MenuItem>
                <MenuItem Header="Hubs">
                    <MenuItem Header="Chat" Command="{Binding NavigateCommand}" CommandParameter="Chat"
                              Visibility="{Binding CanAccessChat, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Project Portfolio" Command="{Binding NavigateCommand}" CommandParameter="Projects"
                              Visibility="{Binding CanAccessProjects, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Employee Hub" Command="{Binding NavigateCommand}" CommandParameter="Team"
                              Visibility="{Binding CanAccessStaff, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Customer Hub" Command="{Binding NavigateCommand}" CommandParameter="Customers"
                              Visibility="{Binding CanAccessCustomers, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <MenuItem Header="Health &amp; Safety" Command="{Binding NavigateCommand}" CommandParameter="HealthSafety"
                              Visibility="{Binding CanAccessHealthSafety, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>

                    <Separator Visibility="{Binding CanAccessProcurement, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <MenuItem Header="Procurement Hub" Visibility="{Binding CanAccessProcurement, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                        <MenuItem Header="Procurement Dashboard" Command="{Binding NavigateCommand}" CommandParameter="Procurement"
                                  Visibility="{Binding CanAccessProcurement, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Inventory Control" Command="{Binding NavigateCommand}" CommandParameter="Inventory"
                                  Visibility="{Binding CanAccessInventory, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Purchase Orders" Command="{Binding NavigateCommand}" CommandParameter="PurchaseOrder"
                                  Visibility="{Binding CanAccessPurchaseOrders, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Suppliers" Command="{Binding NavigateCommand}" CommandParameter="Suppliers"
                                  Visibility="{Binding CanAccessSuppliers, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <Separator Visibility="{Binding CanAccessPartnerHub, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <MenuItem Header="Partner Hub" Visibility="{Binding CanAccessPartnerHub, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                        <MenuItem Header="Performance Hub" Command="{Binding NavigateCommand}" CommandParameter="PerformanceDashboard"
                                  Visibility="{Binding CanAccessPerformanceDashboard, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Sub-Contractors" Command="{Binding NavigateCommand}" CommandParameter="SubContractors"
                                  Visibility="{Binding CanAccessSubContractors, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Snag List" Command="{Binding NavigateCommand}" CommandParameter="SnagList"
                                  Visibility="{Binding CanAccessSnagList, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>

                    <Separator Visibility="{Binding CanAccessAdmin, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <MenuItem Header="Admin" Visibility="{Binding CanAccessAdmin, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                        <MenuItem Header="User Management" Command="{Binding NavigateCommand}" CommandParameter="UserManagement"
                                  Visibility="{Binding CanAccessUserManagement, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Audit Logs" Command="{Binding NavigateCommand}" CommandParameter="AuditLog"
                                  Visibility="{Binding CanAccessAuditLog, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Company Profile" Command="{Binding NavigateCommand}" CommandParameter="CompanyProfile"
                                  Visibility="{Binding CanAccessCompanyProfile, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="System Settings" Command="{Binding NavigateCommand}" CommandParameter="CompanySettings"
                                  Visibility="{Binding CanAccessSettings, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <MenuItem.Icon>
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                            </MenuItem.Icon>
                        </MenuItem>
                    </MenuItem>
                </MenuItem>
                <MenuItem Header="Window">
                    <MenuItem Header="Close All Tabs" Command="{Binding CloseAllTabsCommand}"/>
                    <MenuItem Header="Close Other" Command="{Binding CloseOtherTabsCommand}" CommandParameter="{Binding ActiveHub}"/>
                    <MenuItem Header="Close to the Right" Command="{Binding CloseTabsToRightCommand}" CommandParameter="{Binding ActiveHub}"/>
                </MenuItem>
                <MenuItem Header="Help">
                    <MenuItem Header="Support Hub" Command="{Binding ShowSupportHubCommand}">
                        <MenuItem.Icon>
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14"/>
                        </MenuItem.Icon>
                    </MenuItem>
                    <Separator Background="{StaticResource GlassBorderUltraLight}"/>
                    <MenuItem Header="Check for Updates" Command="{Binding CheckForUpdatesCommand}"/>
                    <MenuItem Header="Release Notes"/>
                    <MenuItem Header="About" Command="{Binding ShowAboutCommand}"/>
                </MenuItem>
            </Menu>
        </Grid>

        <!-- Main Shell (Displaced by the menu/title bar height) -->
        <Grid Margin="0,32,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="72" Style="{StaticResource ModernSidebar}" 
                    Background="Transparent" 
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    RenderOptions.EdgeMode="Aliased"
                    MouseLeftButtonDown="OnSidebarClick"
                    MouseEnter="OnSidebarMouseEnter"
                    MouseLeave="OnSidebarMouseLeave">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <!-- Logo/Brand -->
                        <RowDefinition Height="Auto" />
                        <!-- Workspace hubs -->
                        <RowDefinition Height="*" />
                        <!-- Nav Items -->
                        <RowDefinition Height="Auto" />
                        <!-- User Profile -->
                    </Grid.RowDefinitions>

                    <!-- Branding & Search Container (Optimized height and spacing) -->
                    <Grid Grid.Row="0" Grid.RowSpan="2" Height="150" VerticalAlignment="Top">
                        <StackPanel VerticalAlignment="Top">
                            <!-- Logo -->
                            <Grid Margin="0,0,0,0">
                                <!-- Expanded State Brand (Original Image) -->
                                <Border Margin="15,10,15,5" Height="60"
                                        Visibility="{Binding IsSidebarMinimized, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                    <Image Source="/Assets/Images/occ_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <!-- Minimized State Brand Icon (Original Image) -->
                                <Border Margin="15,10,15,5" Height="60"
                                        Visibility="{Binding IsSidebarMinimized, Converter={StaticResource VisibilityConverter}}">
                                    <Image Source="/Assets/Images/occ_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>

                            <!-- Futuristic Search Box -->
                            <Border Margin="15,5" 
                                    BorderBrush="#00FF88" BorderThickness="1" CornerRadius="6"
                                    Background="#0800FF88"
                                    Visibility="{Binding IsSidebarMinimized, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1500FF88"/>
                                                <Setter Property="BorderBrush" Value="#00FFAA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid Height="36">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search Icon -->
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="#00FF88" FontSize="14" Opacity="0.8" HorizontalAlignment="Center"/>

                                    <!-- Search Input -->
                                    <TextBox x:Name="SearchTextBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" 
                                             Text="{Binding FeatureSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             VerticalContentAlignment="Center" CaretBrush="#00FF88" FontSize="13" Padding="0,0,10,0" />

                                    <!-- Placeholder Text -->
                                    <TextBlock Grid.Column="1" Text="Search..." Foreground="#00FF88" Opacity="0.5" 
                                               VerticalAlignment="Center" IsHitTestVisible="False" Margin="3,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Hidden"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Navigation -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredNavigationItems}" Margin="0,10">
                            <!-- Removed the flat GroupStyle grouping, as we are now hierarchical -->
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- PARENT NODE TEMPLATE (Only visible if IsParent = True) -->
                                        <ToggleButton Style="{StaticResource SidebarParentItemStyle}"
                                                      IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                                      Visibility="{Binding IsParent, Converter={StaticResource VisibilityConverter}}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding IconCode}" Style="{StaticResource SidebarIconStyle}" FontSize="18"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>

                                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="15" Margin="0,0,0,0"
                                                           Visibility="{Binding DataContext.IsSidebarMinimized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}"/>

                                                <!-- Expand/Collapse Chevron -->
                                                <TextBlock Grid.Column="2" Text="" FontSize="8"
                                                           Foreground="White" Opacity="1" VerticalAlignment="Center" Margin="5,0,15,0"
                                                           RenderTransformOrigin="0.5,0.5"
                                                           Visibility="{Binding DataContext.IsSidebarMinimized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
                                                            <Setter Property="RenderTransform">
                                                                <Setter.Value>
                                                                    <RotateTransform Angle="0" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="RenderTransform">
                                                                        <Setter.Value>
                                                                            <RotateTransform Angle="180" />
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ToggleButton>

                                        <!-- SINGLE NODE TEMPLATE (Only visible if IsParent = False) -->
                                        <RadioButton Style="{StaticResource SidebarNavItem}" 
                                                     IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                     GroupName="PrimaryNav"
                                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"
                                                     ToolTip="{Binding Label}"
                                                     Visibility="{Binding IsParent, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                            <Grid HorizontalAlignment="Stretch">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="52" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Grid.Column="0" Width="40" Height="40" HorizontalAlignment="Center">
                                                    <Ellipse Fill="{DynamicResource AccentBlue}" Opacity="0" Margin="-2" x:Name="ActiveIndicator">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect BlurRadius="10" Color="{StaticResource AccentBlueColor}" ShadowDepth="0" Opacity="1"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding IconCode}" Style="{StaticResource SidebarIconStyle}" FontSize="18"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Grid>

                                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" FontSize="15" Margin="0,0,0,0"
                                                           Visibility="{Binding DataContext.IsSidebarMinimized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}"/>
                                            </Grid>
                                        </RadioButton>

                                        <!-- CHILD ITEMS CONTAINER (Visible if IsExpanded = True and Sidebar is open) -->
                                        <Border Visibility="{Binding DataContext.IsSidebarMinimized, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                            <ItemsControl ItemsSource="{Binding Children}" Margin="0,0,0,5">
                                                <ItemsControl.Style>
                                                    <Style TargetType="ItemsControl">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ItemsControl.Style>
                                                <!-- Slide down animation wrapper -->
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <!-- CHILD NODE TEMPLATE -->
                                                        <RadioButton Style="{StaticResource SidebarChildItemStyle}" 
                                                                     IsChecked="{Binding IsActive, Mode=TwoWay}"
                                                                     GroupName="PrimaryNav"
                                                                     Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                     CommandParameter="{Binding}"
                                                                     ToolTip="{Binding Label}">
                                                            <Grid HorizontalAlignment="Stretch">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="15" />
                                                                    <!-- Spacing for trace -->
                                                                    <ColumnDefinition Width="20" />
                                                                    <!-- Icon -->
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Grid Grid.Column="1" Width="16" Height="16" HorizontalAlignment="Center">
                                                                    <TextBlock Text="{Binding IconCode}" Style="{StaticResource SidebarIconStyle}" FontSize="16" FontWeight="Bold"
                                                                               VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                               Opacity="1"/>
                                                                </Grid>
                                                                <TextBlock Grid.Column="2" Text="{Binding Label}" VerticalAlignment="Center" 
                                                                           FontSize="13" Margin="10,0,0,0" Opacity="1"/>
                                                            </Grid>
                                                        </RadioButton>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- User Profile -->
                    <Border Grid.Row="3" Background="{DynamicResource GlassBackgroundVibrant}" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0" Padding="5,15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- NK Circle -->
                            <Border Grid.Column="0" x:Name="ProfileCircle" Width="42" Height="42" 
                                    HorizontalAlignment="Center" CornerRadius="21" Background="{StaticResource AccentBlue}"
                                    Cursor="Hand" MouseLeftButtonDown="OnProfileCircleClick" RenderOptions.BitmapScalingMode="HighQuality">
                                <TextBlock Text="{Binding UserInitials}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="14" IsHitTestVisible="False"/>
                            </Border>

                            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0"
                                          Visibility="{Binding IsSidebarMinimized, Converter={StaticResource VisibilityConverter}, ConverterParameter='Invert'}">
                                <TextBlock Text="{Binding UserName}" Foreground="White" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding UserEmail}" Foreground="{StaticResource TextSub}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Top Bar (Title + Nav icons) -->
                    <RowDefinition Height="*" />
                    <!-- Main Content -->
                    <RowDefinition Height="32" />
                    <!-- Status Bar -->
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0" Height="70" Padding="10,0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- Workspace Tabs -->
                        <ListBox x:Name="TabsListBox" ItemsSource="{Binding OpenHubs}" SelectedItem="{Binding ActiveHub}" 
                                 Background="Transparent" BorderThickness="0" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VerticalAlignment="Bottom" Margin="0,0,0,0" Padding="0,0,0,10"
                                 PreviewMouseWheel="TabsListBox_PreviewMouseWheel">
                            <ListBox.Resources>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ScrollViewer">
                                                <Grid>
                                                    <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"/>
                                                    <!-- You would place your custom ScrollBars here -->
                                                    <ScrollBar x:Name="PART_HorizontalScrollBar" 
                                                               Orientation="Horizontal"
                                                               VerticalAlignment="Bottom"                                                               
                                                               Value="{TemplateBinding HorizontalOffset}"
                                                               Maximum="{TemplateBinding ScrollableWidth}"
                                                               ViewportSize="{TemplateBinding ViewportWidth}"
                                                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                               Margin="0,55,0,0">
                                                        <ScrollBar.Style>
                                                            <Style TargetType="ScrollBar">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ScrollBar">
                                                                            <Grid Background="Transparent">
                                                                                <!-- This is your track background -->
                                                                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                                                    <Track.Thumb>
                                                                                        <Thumb>
                                                                                            <Thumb.Template>
                                                                                                <ControlTemplate TargetType="Thumb">
                                                                                                    <!-- This is the actual draggable bar color -->
                                                                                                    <Border Background="{StaticResource WorkspaceScrollViewer}" 
                                                                                                            CornerRadius="4" 
                                                                                                            Height="6" 
                                                                                                            VerticalAlignment="Center"/>
                                                                                                </ControlTemplate>
                                                                                            </Thumb.Template>
                                                                                        </Thumb>
                                                                                    </Track.Thumb>
                                                                                </Track>
                                                                            </Grid>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ScrollBar.Style>
                                                    </ScrollBar>
                                                </Grid>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.Resources>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="TabBorder" Height="40" MinWidth="120" Margin="0,0,4,0" 
                                                        Background="#66000000" BorderBrush="#20FFFFFF" BorderThickness="1,1,1,0" CornerRadius="8,8,0,0">
                                                    <Grid Margin="15,0,10,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Text="{Binding Title}" Foreground="White" Opacity="0.5" x:Name="TabText"
                                                                   FontFamily="{StaticResource MichromaFont}" VerticalAlignment="Center" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,0,15,0"/>

                                                        <Button Grid.Column="1" Command="{Binding DataContext.CloseHubCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Width="20" Height="20" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" x:Name="CloseButton">
                                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="8" Opacity="0.3" x:Name="CloseIcon"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Button.Style>
                                                                <Style TargetType="Button">
                                                                    <Setter Property="Template">
                                                                        <Setter.Value>
                                                                            <ControlTemplate TargetType="Button">
                                                                                <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                                </Border>
                                                                            </ControlTemplate>
                                                                        </Setter.Value>
                                                                    </Setter>
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="#40FF3b30"/>
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#1500FF88"/>
                                                        <Setter TargetName="TabBorder" Property="BorderBrush" Value="#00FF88"/>
                                                        <Setter TargetName="TabBorder" Property="BorderThickness" Value="1,1,1,2"/>
                                                        <Setter TargetName="TabText" Property="Opacity" Value="1.0"/>
                                                        <Setter TargetName="TabText" Property="Foreground" Value="#00FF88"/>
                                                    </Trigger>
                                                    <Trigger SourceName="CloseButton" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="CloseIcon" Property="Opacity" Value="1.0" />
                                                        <Setter TargetName="CloseIcon" Property="Foreground" Value="#FF3b30" />
                                                    </Trigger>
                                                    <MultiTrigger>
                                                        <MultiTrigger.Conditions>
                                                            <Condition Property="IsMouseOver" Value="True"/>
                                                            <Condition Property="IsSelected" Value="False"/>
                                                        </MultiTrigger.Conditions>
                                                        <Setter TargetName="TabBorder" Property="Background" Value="#15FFFFFF"/>
                                                        <Setter TargetName="TabText" Property="Opacity" Value="0.8"/>
                                                    </MultiTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>


                <!-- Active Content -->
                <ContentControl Grid.Row="1" Content="{Binding ActiveHub}" Margin="0"/>

                <!-- Status Bar (Complete Parity) -->
                <Border Grid.Row="2" Background="#1A000000" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0" Padding="15,0"
                        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType" UseLayoutRounding="True" SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Section (Activity) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,20,0">
                                <TextBlock Text="" FontSize="14" Margin="0,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
                                            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUserInactive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryGold}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding UserActivityStatus}" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUserInactive}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource SecondaryGold}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>

                            <Border Width="2" Height="12" Background="{StaticResource GlassBorder}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                        </StackPanel>

                        <!-- Database -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="" FontSize="14" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorRed}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDbConnected}" Value="True">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="DATABASE: " Foreground="{StaticResource TextSub}" FontSize="10" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding DatabaseName}" Foreground="{StaticResource AccentBlue}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Width="2" Height="12" Background="{StaticResource GlassBorder}" VerticalAlignment="Center" Margin="15,0"/>
                            <TextBlock Text="ENVIRONMENT: " Foreground="{StaticResource TextSub}" FontSize="10" VerticalAlignment="Center" Opacity="0.6" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding EnvironmentName}" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border Width="2" Height="12" Background="{StaticResource GlassBorder}" VerticalAlignment="Center" Margin="15,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <!-- Busy Spinner (Moved from Col 0) -->
                            <TextBlock Text="" Foreground="{StaticResource SecondaryGold}" FontSize="14" Margin="0,0,10,0" 
                                       VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                                       Visibility="{Binding IsAppBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock.RenderTransform>
                                    <RotateTransform x:Name="BusySpinnerTransform" Angle="0" />
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SymbolIcon}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAppBusy}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard Storyboard="{StaticResource BusySpinnerAnimation}" />
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Ellipse Width="8" Height="8" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#3B82F6"/>
                                        <!-- Blue Default -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAppBusy}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SecondaryGold}"/>
                                                <!-- Orange when busy -->
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsAppBusy}" Value="False"/>
                                                    <Condition Binding="{Binding StatusMessage}" Value="Ready"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Fill" Value="#10B981"/>
                                                <!-- Green when Ready -->
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Action Text Logic -->
                            <Grid VerticalAlignment="Center">
                                <!-- Busy Message -->
                                <TextBlock Text="{Binding BusyMessage}" Foreground="White" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold"
                                           Visibility="{Binding IsAppBusy, Converter={StaticResource VisibilityConverter}}"/>

                                <!-- Status Message (Ready, Saved, etc.) -->
                                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsAppBusy}" Value="False"/>
                                                        <Condition Binding="{Binding IsImportProgressVisible}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Import Progress Overlay -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0"
                                            Visibility="{Binding IsImportProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Border Width="120" Height="8" Background="#3300FF88" CornerRadius="4" Margin="0,0,10,0">
                                        <ProgressBar Value="{Binding ImportProgress}" Maximum="100" Background="Transparent" BorderThickness="0" Foreground="#00FF88"
                                                     Template="{StaticResource ModernProgressBarTemplate}"/>
                                    </Border>
                                    <TextBlock Text="{Binding ImportProgressText}" Foreground="#00FF88" FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Right Section -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <!-- Bug Report -->
                            <Button Command="{Binding ShowReportBugCommand}" Margin="0,0,15,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="#25FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{DynamicResource SecondaryGold}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Report Bug" Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="2" Height="12" Background="{StaticResource GlassBorder}" VerticalAlignment="Center" Margin="0,0,15,0"/>

                            <!-- Online Users -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Cursor="Hand" 
                                        Background="Transparent" MouseLeftButtonDown="OnOnlineStatusClick">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{DynamicResource AccentBlue}" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Online: " Foreground="{StaticResource TextSub}" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding OnlineCount}" Foreground="White" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Toast Notifications Overlay (Bottom Right) -->
        <ItemsControl ItemsSource="{Binding Toasts}" 
                      Style="{StaticResource ToastContainerStyle}"
                      Margin="0,0,20,50" 
                      Panel.ZIndex="200"/>

        <Border x:Name="UserListOverlay" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                Margin="0,0,20,50" Width="220"
                Background="{StaticResource BackgroundDark}" 
                BorderBrush="{StaticResource GlassBorder}" 
                BorderThickness="1" CornerRadius="8"
                Panel.ZIndex="250"
                Visibility="{Binding IsUserListVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                MouseLeave="OnOverlayMouseLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsUserListVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Margin="15,12">
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="Active Users" FontWeight="Bold" Foreground="White" FontSize="13"/>
                    <Button HorizontalAlignment="Right" Command="{Binding ToggleUserListCommand}" Style="{StaticResource OverlayCloseButtonStyle}" Width="24" Height="24">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>
                <ItemsControl ItemsSource="{Binding ConnectedUsers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="8" Height="8" Fill="{Binding StatusColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="{StaticResource TextMain}" VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Grid.Column="2" Text="{Binding TimeOnline}" Foreground="{StaticResource TextSub}" VerticalAlignment="Center" FontSize="10" Margin="15,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border x:Name="ProfileMenuOverlay" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                Margin="15,0,0,80" Width="180"
                Background="{StaticResource BackgroundDark}" 
                BorderBrush="{StaticResource GlassBorder}" 
                BorderThickness="1" CornerRadius="8"
                Panel.ZIndex="250"
                Visibility="{Binding IsProfileMenuVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                MouseLeave="OnOverlayMouseLeave">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Opacity" Value="1"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsProfileMenuVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel Margin="5">
                <Button Style="{StaticResource ModernMenuButton}" Command="{Binding ShowProfileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Profile"/>
                    </StackPanel>
                </Button>
                <Border Height="1" Background="{StaticResource GlassBorderUltraLight}" Margin="10,2"/>
                <Button Style="{StaticResource ModernMenuButton}" Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Log out" FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Support Hub Modal Overlay -->
        <Grid x:Name="SupportHubOverlay" Panel.ZIndex="1000">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentReportBug}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentReportBug, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Invert'}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop -->
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseHubCommand}" CommandParameter="{Binding CurrentReportBug}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal Content (Host for SupportHubView) -->
            <ContentControl Content="{Binding CurrentReportBug}" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- Profile Modal Overlay -->
        <Grid x:Name="ProfileOverlay" Panel.ZIndex="1100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CurrentProfile}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CurrentProfile, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Invert'}" Value="Visible">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <!-- Backdrop -->
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseProfileCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal Content (Host for ProfileView) -->
            <ContentControl Content="{Binding CurrentProfile}" 
                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>

        <!-- About Modal Overlay -->
        <Grid x:Name="AboutOverlay" Panel.ZIndex="1200" Visibility="{Binding IsAboutVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <!-- Backdrop -->
            <Border Background="#80000000">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseAboutCommand}"/>
                </Border.InputBindings>
            </Border>

            <!-- Modal Content -->
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="480" Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <StackPanel Margin="25">
                    <Grid Margin="0,0,0,15">
                        <TextBlock Text="About" FontFamily="{StaticResource MichromaFont}" FontSize="18" Foreground="White" FontWeight="SemiBold"/>
                        <Button HorizontalAlignment="Right" Command="{Binding CloseAboutCommand}" Style="{StaticResource OverlayCloseButtonStyle}" Width="28" Height="28">
                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <TextBlock Text="OCC ERP" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                        <TextBlock Text="Version: " Foreground="{StaticResource TextSub}" FontSize="13"/>
                        <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource AccentBlue}" FontSize="13" FontWeight="SemiBold"/>
                    </StackPanel>

                    <TextBlock Text="License" Foreground="White" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                    <TextBlock Foreground="{StaticResource TextSub}" FontSize="12" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,10">
                        <Run Text="This computer program is protected by copyright law and international treaties. Unauthorized reproduction or distribution of this program, or any portion of it, may result in severe civil and criminal penalties, and will be prosecuted to the maximum extent possible under the law." />
                        <LineBreak/>
                        <LineBreak/>
                        <Run Text="© 2026 Orange Circle Construction. All rights reserved." />
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>


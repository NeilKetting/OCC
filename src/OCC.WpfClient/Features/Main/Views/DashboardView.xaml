<UserControl x:Class="OCC.WpfClient.Features.Main.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.Main.ViewModels"
             xmlns:views="clr-namespace:OCC.WpfClient.Features.Main.Views"
             xmlns:converters="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <converters:UserInitialsConverter x:Key="UserInitialsConverter"/>
        <converters:UserColorConverter x:Key="UserColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <!-- View mappings for widgets -->
        <DataTemplate DataType="{x:Type vm:BirthdayWidgetViewModel}">
            <views:BirthdayWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AlertsWidgetViewModel}">
            <views:AlertsWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TasksWidgetViewModel}">
            <views:TasksWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TodosWidgetViewModel}">
            <views:TodosWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UsersWidgetViewModel}">
            <views:UsersWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductivityWidgetViewModel}">
            <views:ProductivityWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarWidgetViewModel}">
            <views:CalendarWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ChatsWidgetViewModel}">
            <views:ChatsWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SupportWidgetViewModel}">
            <views:SupportWidgetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:QuickActionsWidgetViewModel}">
            <views:QuickActionsWidgetView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="15,10,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header Row -->
                <RowDefinition Height="*" />    <!-- Scrollable Grid Area -->
                <RowDefinition Height="Auto" /> <!-- Drawer / Edit Mode Area -->
            </Grid.RowDefinitions>

            <!-- Row 0: Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="28" FontWeight="SemiBold">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}, {1}">
                                <Binding Path="Greeting" />
                                <Binding Path="UserName" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <TextBlock Text="{Binding CurrentDate}" Style="{StaticResource FormLabelText}"/>
                </StackPanel>

                <!-- Actions Right Side -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding CustomizeLayoutCommand}" 
                            Margin="0,0,10,0" Height="32">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                <Setter Property="Content" Value="Customize Dashboard"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                        <Setter Property="Content" Value="Save Layout"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" 
                            Width="100" Height="32" Style="{StaticResource CreateIconButton}"/>
                </StackPanel>
            </Grid>

            <!-- Row 1: Scrollable Widget Container -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="itemsControl" ItemsSource="{Binding ActiveWidgets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                            </Grid>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Grid.Row" Value="{Binding Row}" />
                            <Setter Property="Grid.Column" Value="{Binding Column}" />
                            <Setter Property="Grid.ColumnSpan" Value="{Binding ColumnSpan}" />
                            <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:WidgetViewModelBase}">
                            <Grid Margin="6">
                                <!-- Outer styling for each widget -->
                                <Border Style="{StaticResource GlassCard}" Padding="15">
                                    <ContentPresenter Content="{Binding}" />
                                </Border>

                                <!-- Edit Overlay -->
                                <Border Background="#B0111827" CornerRadius="12" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1.5"
                                        Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        MouseLeftButtonDown="OnWidgetMouseDown"
                                        MouseMove="OnWidgetMouseMove"
                                        MouseLeftButtonUp="OnWidgetMouseUp"
                                        Cursor="SizeAll">
                                    <Grid>
                                        <!-- Widget Title and Hide controls -->
                                        <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="13" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="15,10,0,0" Opacity="0.9"/>

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10">
                                            <!-- Delete/Hide Button -->
                                            <Button Command="{Binding RemoveCommand}" ToolTip="Hide Widget" Style="{StaticResource IconButton}" Height="28" Width="28">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="13" Foreground="#EF4444"/>
                                            </Button>
                                        </StackPanel>

                                        <!-- Centered Helper Text and Icon -->
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="24" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                            <TextBlock Text="Drag to Move" Foreground="White" FontSize="12" Opacity="0.6" HorizontalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Drag Resize Thumb at Bottom-Right corner -->
                                        <Thumb Width="20" Height="20" Cursor="SizeNWSE" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                               DragDelta="OnResizeThumbDragDelta" DragCompleted="OnResizeThumbDragCompleted" Margin="0,0,5,5">
                                            <Thumb.Template>
                                                <ControlTemplate>
                                                    <TextBlock Text="◢" Foreground="White" Opacity="0.7" FontSize="14" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="SizeNWSE"/>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Row 2: Widget Library (Drawer) -->
            <Border Grid.Row="2" Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource GlassCard}" CornerRadius="12" Margin="0,15,0,0" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Widget Library" Foreground="White" FontSize="15" FontWeight="SemiBold" Margin="0,0,15,0"/>
                        <TextBlock Text="Click to add widgets back to dashboard" Foreground="{StaticResource TextSub}" FontSize="11" Margin="0,2,20,0"/>
                    </StackPanel>

                    <ItemsControl Grid.Column="1" ItemsSource="{Binding AvailableWidgets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:WidgetViewModelBase}">
                                <Button Content="{Binding Title, StringFormat={}+ {0}}" 
                                        Command="{Binding DataContext.AddWidgetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                        CommandParameter="{Binding}" 
                                        Margin="0,0,8,8" Height="28" Padding="10,0"
                                        Style="{StaticResource PrimaryButton}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Grid.Column="3" Content="Reset Layout" Command="{Binding ResetLayoutCommand}" Height="28" Padding="12,0" Style="{StaticResource CreateIconButton}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

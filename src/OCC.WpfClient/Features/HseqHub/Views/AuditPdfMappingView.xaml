<UserControl x:Class="OCC.WpfClient.Features.HseqHub.Views.AuditPdfMappingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="600"
             d:DataContext="{d:DesignInstance vm:AuditPdfMappingViewModel}">
             
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <infra:BindingProxy x:Key="Proxy" Data="{Binding}" xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="20" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Section -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Map PDF Audit Sections" FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding PdfFileName, StringFormat='Source PDF: {0}'}" FontSize="12" Foreground="{StaticResource AccentBlue}" FontWeight="SemiBold" Margin="0,0,0,10"/>
            
            <Border Style="{StaticResource GlassCard}" Padding="15" Margin="0,5,0,0">
                <TextBlock Text="We parsed the following tables from your uploaded audit document. Match each PDF section name to our standard HSEQ category. Any standard categories that are not matched will be automatically set to 0 possible score and excluded from calculations." 
                           Foreground="{StaticResource TextSub}" FontSize="11.5" TextWrapping="Wrap" LineHeight="18"/>
            </Border>
        </StackPanel>

        <!-- Mapping List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10" Padding="15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>

                                <!-- PDF Row Title -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding PdfCategoryName}" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" FontSize="12.5"/>
                                    <TextBlock Text="PDF SECTION" FontSize="9" Foreground="{StaticResource TextSub}" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Parsed Score -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding AchievedScore}" FontWeight="Bold" Foreground="{StaticResource SuccessGreen}" FontSize="13"/>
                                        <TextBlock Text=" / " Foreground="{StaticResource TextSub}" FontSize="13"/>
                                        <TextBlock Text="{Binding PossibleScore}" FontWeight="Bold" Foreground="White" FontSize="13"/>
                                    </StackPanel>
                                    <TextBlock Text="PARSED SCORE" FontSize="9" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>

                                <!-- Mapping Dropdown -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <ComboBox ItemsSource="{Binding Data.StandardCategories, Source={StaticResource Proxy}}" 
                                              SelectedItem="{Binding MappedCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ModernComboBox}" 
                                              Height="32"/>
                                    <TextBlock Text="MAPS TO REPORT FIELD" FontSize="9" Foreground="{StaticResource TextSub}" Margin="5,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Actions Section -->
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <Button Style="{StaticResource SaveButton}" Command="{Binding ConfirmMappingCommand}" Content="CONFIRM MAPPING" Margin="0,0,0,10"/>
            <Button Style="{StaticResource CancelButton}" Command="{Binding CloseCommand}" Content="CANCEL"/>
        </StackPanel>
    </Grid>
</UserControl>

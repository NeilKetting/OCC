<infra:BaseListView x:Class="OCC.WpfClient.Features.HseqHub.Views.DocumentsView"
               IsDrawerOpen="{Binding ShowUploadForm}"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">

    <UserControl.Resources>
        <!-- Drawer Animations -->
        <Storyboard x:Key="OpenDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="600" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="600" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <!-- Main Content Wrapper -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAttach}" Width="24" Height="24" Fill="{StaticResource PrimaryTeal}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Document Control" Style="{StaticResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Policies, Templates, and Registers" Style="{StaticResource LabelText}" Opacity="0.7"/>
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource ActionButtonPrimary}" Command="{Binding ToggleUploadFormCommand}" Content="+ UPLOAD NEW" VerticalAlignment="Center"/>
            </Grid>

            <!-- Document Grid -->
            <ScrollViewer Grid.Row="1" Padding="24,0,24,24" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Documents}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Width="240" Margin="0,0,16,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Border CornerRadius="8" Background="#1A3B82F6" Width="45" Height="45" HorizontalAlignment="Left">
                                            <Path Data="{StaticResource IconAttach}" Fill="{StaticResource PrimaryTeal}" Width="22" Height="22" Stretch="Uniform"/>
                                        </Border>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource IconButtonSmall}" 
                                                Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconDelete}" Fill="{StaticResource ErrorRed}" Width="12" Height="12" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>

                                    <TextBlock Text="{Binding Title}" Foreground="White" FontWeight="Bold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,0,0,5"/>
                                    <TextBlock Text="{Binding Category}" FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,0,0,15"/>

                                    <Border BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
                                        <Grid>
                                            <TextBlock Text="{Binding UploadDate, StringFormat='d MMM yyyy'}" FontSize="10" Foreground="{StaticResource TextSub}" VerticalAlignment="Center"/>
                                            <Button HorizontalAlignment="Right" Style="{StaticResource GhostButton}" Padding="10,4"
                                                    Command="{Binding DataContext.DownloadDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryTeal}"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Loading Overlay -->
            <Border Grid.RowSpan="2" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Background="#80000000">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                    <TextBlock Text="Loading Documents..." Foreground="White"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DRAWER OVERLAY -->
        <Grid x:Name="DrawerOverlay" Visibility="Collapsed">
            <Border x:Name="Dimmer" Background="#80000000" Opacity="0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleUploadFormCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border x:Name="DrawerContent" HorizontalAlignment="Right" Width="550" 
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource GlassBorderMedium}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="600"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Animations handled by BaseListView -->
                    </Style>
                </Border.Style>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <TextBlock Text="Upload Document" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Publish new policies or site templates." FontSize="14" Foreground="{StaticResource TextSub}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="DOCUMENT TITLE" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding NewDocTitle}" Style="{StaticResource ModernInput}" Margin="0,0,0,20"/>

                            <TextBlock Text="CATEGORY" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding NewDocCategory}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20"/>

                            <TextBlock Text="RELATED PROJECT (Optional)" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding AvailableProjects}" SelectedItem="{Binding SelectedProject}" DisplayMemberPath="Name" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20"/>

                            <TextBlock Text="SELECT FILE" Style="{StaticResource FormLabelText}"/>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding SelectedFilePath}" IsReadOnly="True" Style="{StaticResource ModernInput}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource ActionButtonSecondary}" Content="BROWSE" Command="{Binding PickFileCommand}" Height="40"/>
                            </Grid>
                            <TextBlock Text="{Binding SelectedFileName}" FontSize="12" Foreground="{StaticResource TextSub}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,0">
                        <Button Style="{StaticResource ActionButtonPrimary}" Command="{Binding UploadCommand}" Content="UPLOAD DOCUMENT" Height="45" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource ActionButtonSecondary}" Command="{Binding ToggleUploadFormCommand}" Content="CANCEL" Height="45"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</infra:BaseListView>

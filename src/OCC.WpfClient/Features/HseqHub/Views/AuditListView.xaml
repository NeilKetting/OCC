<infra:BaseListView x:Class="OCC.WpfClient.Features.HseqHub.Views.AuditListView"
               IsDrawerOpen="{Binding IsEditorOpen}"
               IsDrawer2Open="{Binding IsDeviationsOpen}"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
              xmlns:dto="clr-namespace:OCC.Shared.DTOs;assembly=OCC.Shared"
              xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
              xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
              mc:Ignorable="d" 
              d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <!-- Drawer Animations -->
        <Storyboard x:Key="OpenDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="700" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="700" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <!-- Main Content Wrapper -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header -->
            <Grid Grid.Row="0" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconList}" Width="24" Height="24" Fill="{StaticResource PrimaryTeal}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Audits &amp; Inspections" Style="{StaticResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Track compliance and deviations across sites" Style="{StaticResource LabelText}" Opacity="0.7"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButtonPrimary}" Command="{Binding CreateNewAuditCommand}" Content="+ NEW AUDIT" VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 1: Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="15,0,20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextSub}" Width="14" Height="14" Margin="5,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" ap:WatermarkProperties.Watermark="Search audits..."/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource ToolbarButton}" Command="{Binding LoadAuditsCommand}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClock}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="REFRESH" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPrint}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="PRINT" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Row 2: Data Table -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0" Margin="15,0,20,20" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Audits}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Reference" Binding="{Binding AuditNumber}" Width="Auto"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="Auto"/>
                        <DataGridTextColumn Header="Site / Project" Binding="{Binding SiteName}" Width="*"/>
                        <DataGridTemplateColumn Header="Score" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" Background="{Binding ScoreColor}" Margin="5">
                                        <TextBlock Text="{Binding ComplianceScore, StringFormat='{}{0:P0}'}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.EditAuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Edit Audit">
                                            <Path Data="{StaticResource IconEdit}" Width="14" Height="14" Fill="{StaticResource TextSub}" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.OpenDeviationsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="View Deviations">
                                            <Path Data="{StaticResource IconWarning}" Width="14" Height="14" Fill="{StaticResource AlertOrange}" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.DeleteAuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Delete Audit">
                                            <Path Data="{StaticResource IconDelete}" Width="14" Height="14" Fill="{StaticResource ErrorRed}" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- DRAWER OVERLAY -->
        <Grid x:Name="DrawerOverlay" Grid.RowSpan="3" Visibility="Collapsed">

            <Border x:Name="Dimmer" Background="#80000000" Opacity="0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseEditorCommand}"/>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding CloseDeviationsCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border x:Name="DrawerContent" HorizontalAlignment="Right" Width="700" 
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource GlassBorderMedium}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="700"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Animations handled by BaseListView -->
                    </Style>
                </Border.Style>

                <!-- DRAWER CONTENT SWITCHER -->
                <Grid>
                    <!-- AUDIT EDITOR -->
                    <Grid Margin="30" Visibility="{Binding IsEditorOpen, Converter={StaticResource VisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,0,30">
                            <TextBlock Text="{Binding Editor.Title}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Capture compliance and site observations." FontSize="14" Foreground="{StaticResource TextSub}"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="AUDIT NO" Style="{StaticResource FormLabelText}"/>
                                        <TextBox Text="{Binding Editor.CurrentAudit.AuditNumber}" Style="{StaticResource ModernInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="DATE" Style="{StaticResource FormLabelText}"/>
                                        <DatePicker SelectedDate="{Binding Editor.CurrentAudit.Date}" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="SITE NAME" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding Editor.CurrentAudit.SiteName}" Style="{StaticResource ModernInput}" Margin="0,0,0,20"/>

                                <TextBlock Text="SCOPE OF WORKS" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding Editor.CurrentAudit.ScopeOfWorks}" Style="{StaticResource ModernInput}" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="SITE MANAGER" Style="{StaticResource FormLabelText}"/>
                                        <TextBox Text="{Binding Editor.CurrentAudit.SiteManager}" Style="{StaticResource ModernInput}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="HSEQ CONSULTANT" Style="{StaticResource FormLabelText}"/>
                                        <TextBox Text="{Binding Editor.CurrentAudit.HseqConsultant}" Style="{StaticResource ModernInput}"/>
                                    </StackPanel>
                                </Grid>

                                <Border BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,10,0,20">
                                    <Grid>
                                        <TextBlock Text="Findings &amp; Observations" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource ActionButtonSecondary}" Command="{Binding Editor.AddFindingCommand}" Content="+ ADD FINDING" Height="35"/>
                                    </Grid>
                                </Border>

                                <ItemsControl ItemsSource="{Binding Editor.Findings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="20">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,15">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="REGULATION REFERENCE" Style="{StaticResource FormLabelText}"/>
                                                            <TextBox Text="{Binding RegulationReference}" Style="{StaticResource ModernInput}"/>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Style="{StaticResource IconButtonSmall}" VerticalAlignment="Top" Margin="15,0,0,0"
                                                                Command="{Binding DataContext.Editor.DeleteFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Model}">
                                                            <Path Data="{StaticResource IconDelete}" Fill="{StaticResource ErrorRed}" Width="14" Height="14" Stretch="Uniform"/>
                                                        </Button>
                                                    </Grid>
                                                    <TextBlock Text="FINDING DESCRIPTION" Style="{StaticResource FormLabelText}"/>
                                                    <TextBox Text="{Binding Description}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="EFFICIENCY RATINGS" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,20,0,15"/>
                                <ItemsControl ItemsSource="{Binding Editor.CurrentAudit.Sections}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10" Padding="15">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="100"/>
                                                        <ColumnDefinition Width="100"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,15,0"/>
                                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                        <TextBlock Text="ACTUAL" Style="{StaticResource FormLabelText}" FontSize="9"/>
                                                        <TextBox Text="{Binding ActualScore}" Style="{StaticResource ModernInput}" HorizontalContentAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="POSSIBLE" Style="{StaticResource FormLabelText}" FontSize="9"/>
                                                        <TextBox Text="{Binding PossibleScore}" Style="{StaticResource ModernInput}" HorizontalContentAlignment="Center"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,0">
                            <Button Style="{StaticResource ActionButtonPrimary}" Command="{Binding Editor.SaveCommand}" Content="SAVE AUDIT REPORT" Height="45" Margin="0,0,0,10"/>
                            <Button Style="{StaticResource ActionButtonSecondary}" Command="{Binding CloseEditorCommand}" Content="CANCEL" Height="45"/>
                        </StackPanel>
                    </Grid>

                    <!-- DEVIATIONS ACTION SHEET -->
                    <Grid Margin="30" Visibility="{Binding IsDeviationsOpen, Converter={StaticResource VisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,30">
                            <StackPanel>
                                <TextBlock Text="Deviation Action Sheet" FontSize="24" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="{Binding Deviations.SelectedAudit.AuditNumber, StringFormat='Audit Ref: {0}'}" FontSize="14" Foreground="{StaticResource TextSub}"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ActionButtonPrimary}" Command="{Binding Deviations.AddDeviationCommand}" Content="+ ADD ITEM" Height="35"/>
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                            <ItemsControl ItemsSource="{Binding Deviations.Deviations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="REGULATION REFERENCE" Style="{StaticResource FormLabelText}"/>
                                                        <TextBox Text="{Binding RegulationReference}" Style="{StaticResource ModernInput}"/>
                                                    </StackPanel>
                                                    <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="6" Padding="12,6" VerticalAlignment="Top" Margin="20,0,0,0">
                                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="FINDING / OBSERVATION" Style="{StaticResource FormLabelText}"/>
                                                <TextBox Text="{Binding Description}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,15"/>

                                                <TextBlock Text="CORRECTIVE ACTION" Style="{StaticResource FormLabelText}"/>
                                                <TextBox Text="{Binding CorrectiveAction}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,20"/>

                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="20"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="TARGET DATE" Style="{StaticResource FormLabelText}"/>
                                                        <DatePicker SelectedDate="{Binding TargetDate}" Style="{StaticResource ModernDatePicker}"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="STATUS" Style="{StaticResource FormLabelText}"/>
                                                        <ComboBox SelectedItem="{Binding Status}" Style="{StaticResource ModernComboBox}">
                                                            <ComboBoxItem Content="Open"/>
                                                            <ComboBoxItem Content="Rectified"/>
                                                            <ComboBoxItem Content="Closed"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </Grid>

                                                <Button Style="{StaticResource ActionButtonSecondary}" Content="UPDATE ITEM" HorizontalAlignment="Right" Height="35"
                                                        Command="{Binding DataContext.Deviations.SaveDeviationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Row="2" Style="{StaticResource ActionButtonSecondary}" Command="{Binding CloseDeviationsCommand}" Content="CLOSE SHEET" Height="45" Margin="0,20,0,0"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Background="#80000000" Panel.ZIndex="1000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</infra:BaseListView>

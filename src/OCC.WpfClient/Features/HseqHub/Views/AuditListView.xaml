<infra:ListViewBase x:Class="OCC.WpfClient.Features.HseqHub.Views.AuditListView"
                IsDrawerOpen="{Binding IsOverlayActive}"
                OverlayContent="{Binding ActiveOverlay}"
                DrawerWidth="700"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
               xmlns:views="clr-namespace:OCC.WpfClient.Features.HseqHub.Views"
               xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
               xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
               mc:Ignorable="d" 
               d:DesignHeight="800" d:DesignWidth="1200"
               d:DataContext="{d:DesignInstance vm:AuditListViewModel}">

    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <DataTemplate DataType="{x:Type vm:AuditDetailViewModel}">
            <views:AuditDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeviationDetailViewModel}">
            <views:DeviationDetailView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Text="&#xEA18;" Style="{StaticResource SymbolIcon}" FontSize="36" Foreground="#00FFFF" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Grid.Row="0" Text="Safety Audits" Style="{StaticResource HeaderText}" />
                    <TextBlock Grid.Column="1" Grid.Row="1" Text="Site compliance monitoring and efficiency ratings" Style="{StaticResource LabelText}"/>
                </Grid>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Button Style="{StaticResource IconButton}" Command="{Binding CreateNewAuditCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="" Style="{StaticResource SymbolButtonIcon}" />
                            <TextBlock Text="New Audit" Style="{StaticResource ButtonTextStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="15,0,20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" ap:WatermarkProperties.Watermark="Search audits..."/>
                    <Border Grid.Column="2" Width="1" Height="20" Background="{StaticResource GlassBorder}" Margin="15,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="PRINT" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Data Table -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0" Margin="15,0,20,20" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='dd MMM yyyy'}" Width="Auto"/>
                        <DataGridTextColumn Header="Audit #" Binding="{Binding AuditNumber}" Width="Auto" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Site Name" Binding="{Binding SiteName}" Width="Auto"/>
                        <DataGridTemplateColumn Header="Score" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" Background="{Binding ActualScore, Converter={StaticResource AuditScoreColorConverter}}" Margin="5">
                                        <TextBlock Text="{Binding ActualScore, StringFormat='{}{0}%'}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenDeviationsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" ToolTip="Deviation Sheet">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource PrimaryTeal}" FontSize="12" Margin="0,0,5,0"/>
                                                <TextBlock Text="DEVIATIONS" FontSize="10" Foreground="{StaticResource PrimaryTeal}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.EditAuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.DeleteAuditCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</infra:ListViewBase>

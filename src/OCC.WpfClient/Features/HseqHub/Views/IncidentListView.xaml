<infra:BaseListView x:Class="OCC.WpfClient.Features.HseqHub.Views.IncidentListView"
               IsDrawerOpen="{Binding Editor.IsOpen}"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
              xmlns:dto="clr-namespace:OCC.Shared.DTOs;assembly=OCC.Shared"
              xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
              xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
              mc:Ignorable="d" 
              d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <!-- Drawer Animations -->
        <Storyboard x:Key="OpenDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="600" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="600" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <!-- Main Content Wrapper -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconAlert}" Width="24" Height="24" Fill="{StaticResource AlertOrange}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Incidents" Style="{StaticResource HeaderText}"/>
                    </StackPanel>
                    <TextBlock Text="Report and track health and safety incidents" Style="{StaticResource LabelText}" Opacity="0.7"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButtonPrimary}" Command="{Binding ToggleAddCommand}" Content="+ REPORT INCIDENT" VerticalAlignment="Center"/>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="15,0,20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextSub}" Width="14" Height="14" Margin="5,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" ap:WatermarkProperties.Watermark="Search incidents..."/>

                    <Border Grid.Column="2" Width="1" Height="20" Background="{StaticResource GlassBorder}" Margin="15,0" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPrint}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="PRINT" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Data Table -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0" Margin="15,0,20,20" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectedItem="{Binding SelectedItem}" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='d MMM yyyy'}" Width="Auto"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type, Converter={StaticResource FriendlyEnumConverter}}" Width="*"/>
                        <DataGridTemplateColumn Header="Severity" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" Background="{Binding Severity, Converter={StaticResource SeverityColorConverter}}" Margin="5">
                                        <TextBlock Text="{Binding Severity, Converter={StaticResource FriendlyEnumConverter}}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.EditIncidentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconEdit}" Width="14" Height="14" Fill="{StaticResource TextSub}" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.DeleteIncidentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconDelete}" Width="14" Height="14" Fill="{StaticResource ErrorRed}" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- DRAWER OVERLAY -->
        <Grid x:Name="DrawerOverlay" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="Dimmer" Background="#80000000" Opacity="0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleAddCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border x:Name="DrawerContent" HorizontalAlignment="Right" Width="550" 
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource GlassBorderMedium}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="600"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Animations handled by BaseListView -->
                    </Style>
                </Border.Style>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <TextBlock Text="Incident Report" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Capture details of site health &amp; safety events." FontSize="14" Foreground="{StaticResource TextSub}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="INCIDENT DATE" Style="{StaticResource FormLabelText}"/>
                            <DatePicker SelectedDate="{Binding Editor.NewIncident.Date}" Style="{StaticResource ModernDatePicker}" Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="INCIDENT TYPE" Style="{StaticResource FormLabelText}"/>
                                    <ComboBox ItemsSource="{Binding Editor.IncidentTypes}" SelectedItem="{Binding Editor.NewIncident.Type}" Style="{StaticResource ModernComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource FriendlyEnumConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="SEVERITY" Style="{StaticResource FormLabelText}"/>
                                    <ComboBox ItemsSource="{Binding Editor.Severities}" SelectedItem="{Binding Editor.NewIncident.Severity}" Style="{StaticResource ModernComboBox}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource FriendlyEnumConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="LOCATION" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Editor.NewIncident.Location}" Style="{StaticResource ModernInput}" Margin="0,0,0,20"/>

                            <TextBlock Text="DESCRIPTION" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Editor.NewIncident.Description}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="100" Margin="0,0,0,20"/>

                            <TextBlock Text="IMMEDIATE ACTION TAKEN" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Editor.NewIncident.ActionTaken}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,0">
                        <Button Style="{StaticResource ActionButtonPrimary}" Command="{Binding Editor.SaveIncidentCommand}" Content="SAVE REPORT" Height="45" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource ActionButtonSecondary}" Command="{Binding ToggleAddCommand}" Content="CANCEL" Height="45"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                <TextBlock Text="Loading Incidents..." Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</infra:BaseListView>

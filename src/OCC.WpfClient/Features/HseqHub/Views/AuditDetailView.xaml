<UserControl x:Class="OCC.WpfClient.Features.HseqHub.Views.AuditDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance vm:AuditDetailViewModel}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,30">
            <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Foreground="White"/>
            <TextBlock Text="Capture compliance and site observations." FontSize="14" Foreground="{StaticResource TextSub}"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="AUDIT NO" Style="{StaticResource FormLabelText}"/>
                        <TextBox Text="{Binding CurrentAudit.AuditNumber}" Style="{StaticResource ModernInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="DATE" Style="{StaticResource FormLabelText}"/>
                        <DatePicker SelectedDate="{Binding CurrentAudit.Date}" Style="{StaticResource ModernDatePicker}"/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="SITE NAME" Style="{StaticResource FormLabelText}"/>
                <TextBox Text="{Binding CurrentAudit.SiteName}" Style="{StaticResource ModernInput}" IsReadOnly="{Binding IsSiteNameReadOnly}" Margin="0,0,0,20"/>

                <TextBlock Text="SCOPE OF WORKS" Style="{StaticResource FormLabelText}"/>
                <TextBox Text="{Binding CurrentAudit.ScopeOfWorks}" Style="{StaticResource ModernInput}" Margin="0,0,0,20"/>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SITE MANAGER" Style="{StaticResource FormLabelText}"/>
                        <TextBox Text="{Binding CurrentAudit.SiteManager}" Style="{StaticResource ModernInput}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="HSEQ CONSULTANT" Style="{StaticResource FormLabelText}"/>
                        <TextBox Text="{Binding CurrentAudit.HseqConsultant}" Style="{StaticResource ModernInput}"/>
                    </StackPanel>
                </Grid>

                <Border BorderBrush="{StaticResource GlassBorderLight}" BorderThickness="0,1,0,0" Padding="0,20,0,0" Margin="0,10,0,20">
                    <Grid>
                        <TextBlock Text="Findings &amp; Observations" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ActionButtonSecondary}" Command="{Binding AddFindingCommand}" Content="+ ADD FINDING" Height="35"/>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Findings}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,15" Padding="20">
                                <StackPanel>
                                    <Grid Margin="0,0,0,15">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="REGULATION REFERENCE" Style="{StaticResource FormLabelText}"/>
                                            <TextBox Text="{Binding RegulationReference}" Style="{StaticResource ModernInput}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource IconButtonSmall}" VerticalAlignment="Top" Margin="15,0,0,0"
                                                Command="{Binding DataContext.DeleteFindingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                        </Button>
                                    </Grid>
                                    <TextBlock Text="FINDING DESCRIPTION" Style="{StaticResource FormLabelText}"/>
                                    <TextBox Text="{Binding Description}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="80"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="EFFICIENCY RATINGS" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,20,0,15"/>
                <ItemsControl ItemsSource="{Binding CurrentAudit.Sections}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GlassCard}" Margin="0,0,0,10" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,15,0"/>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="ACTUAL" Style="{StaticResource FormLabelText}" FontSize="9"/>
                                        <TextBox Text="{Binding ActualScore}" Style="{StaticResource ModernInput}" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="POSSIBLE" Style="{StaticResource FormLabelText}" FontSize="9"/>
                                        <TextBox Text="{Binding PossibleScore}" Style="{StaticResource ModernInput}" HorizontalContentAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,0">
            <Button Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}" Content="SAVE AUDIT REPORT" Margin="0,0,0,10"/>
            <Button Style="{StaticResource CancelButton}" Command="{Binding CloseCommand}" Content="CANCEL"/>
        </StackPanel>
    </Grid>
</UserControl>

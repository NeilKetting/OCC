<infra:ListViewBase x:Class="OCC.WpfClient.Features.HseqHub.Views.TrainingListView"
                IsDrawerOpen="{Binding IsOverlayActive}"
                OverlayContent="{Binding ActiveOverlay}"
                DrawerWidth="550"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
               xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
               xmlns:views="clr-namespace:OCC.WpfClient.Features.HseqHub.Views"
               xmlns:dialogs="clr-namespace:OCC.WpfClient.Features.HseqHub.Dialogs"
               xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
               xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
               mc:Ignorable="d" 
               d:DesignHeight="800" d:DesignWidth="1200"
               d:DataContext="{d:DesignInstance vm:TrainingListViewModel}">

    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />

        <DataTemplate DataType="{x:Type vm:TrainingDetailViewModel}">
            <dialogs:TrainingDetailView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <!-- Main View Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="15">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource PrimaryTeal}" FontSize="24" Margin="0,0,12,0"/>
                        <TextBlock Text="Training Matrix" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Create and track training and certificates" Style="{StaticResource LabelText}" Opacity="0.7"/>
                </StackPanel>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="15,0,20,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ══════════════════ QUICKBOOKS TOOLBAR ══════════════════ -->
                    <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Refresh Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding LoadDataCommand}" ToolTip="Refresh Data">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Refresh" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Add Training Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding AddTrainingCommand}" ToolTip="Add Training">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE710;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Add Training" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                            <!-- Print Button -->
                            <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding PrintCommand}" ToolTip="Print Matrix">
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                    <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SecondaryGold}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Print" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Search & Filters Row -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" ap:WatermarkProperties.Watermark="Search training..." VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                            <TextBlock Text="CATEGORY" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryTeal}" Margin="0,0,10,0" Opacity="0.8"/>
                            <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" Style="{StaticResource ToolbarComboBox}" Width="150" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                            <TextBlock Text="EXPIRY WARNING" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryTeal}" Margin="0,0,10,0" Opacity="0.8"/>
                            <TextBox Text="{Binding ExpiryWarningDays}" Style="{StaticResource ToolbarTextBox}" Width="60" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="{StaticResource GlassBorder}" VerticalAlignment="Center"/>
                            <TextBlock Text="DAYS" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource TextSub}" Margin="8,0,0,0" Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Command="{Binding FilterExpiringCommand}" Style="{StaticResource ToolbarToggleButton}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="14" Margin="0,0,8,0" Opacity="0.8"/>
                                    <TextBlock Text="SHOW EXPIRING" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0" Margin="15,0,20,20" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Employee" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Border CornerRadius="12" Width="24" Height="24" Background="{StaticResource PrimaryTeal}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding EmployeeName[0]}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding EmployeeName}" VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Skill / Role" Binding="{Binding Role}" Width="*"/>
                        <DataGridTemplateColumn Header="Expiry Date" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" Background="{Binding Summary.DateCompleted, Converter={StaticResource ExpiryColorConverter}}" Margin="5">
                                        <TextBlock Text="{Binding ValidUntil, StringFormat='dd MMM yyyy'}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ToolbarIconButton}" Margin="5" Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Margin="5" Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                <TextBlock Text="Loading Training..." Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</infra:ListViewBase>

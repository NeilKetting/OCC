<infra:BaseListView x:Class="OCC.WpfClient.Features.HseqHub.Views.TrainingListView"
               IsDrawerOpen="{Binding Editor.IsOpen}"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
              xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
              xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
              xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
              xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
              mc:Ignorable="d" 
              d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <infra:BindingProxy x:Key="Proxy" Data="{Binding}" />
        
        <!-- Drawer Animations -->
        <Storyboard x:Key="OpenDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="600" To="0" Duration="0:0:0.6">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>
        <Storyboard x:Key="CloseDrawer">
            <DoubleAnimation Storyboard.TargetName="DrawerContent"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             To="600" Duration="0:0:0.4">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="Dimmer"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <!-- Main View Content -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconTeam}" Width="24" Height="24" Fill="{StaticResource PrimaryTeal}" Stretch="Uniform" Margin="0,0,12,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Training Matrix" Style="{StaticResource HeaderText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Create and track training and certificates" Style="{StaticResource LabelText}" Opacity="0.7"/>
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource ActionButtonPrimary}" Command="{Binding ToggleAddCommand}" Content="+ ADD TRAINING" VerticalAlignment="Center"/>
            </Grid>

            <!-- Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="15,0,20,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Path Grid.Column="0" Data="{StaticResource IconSearch}" Fill="{StaticResource TextSub}" Width="14" Height="14" Margin="5,0,10,0" VerticalAlignment="Center" Stretch="Uniform"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolbarTextBox}" ap:WatermarkProperties.Watermark="Search training..."/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                        <TextBlock Text="CATEGORY" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryTeal}" Margin="0,0,10,0" Opacity="0.8"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding CategoryFilter}" Style="{StaticResource ToolbarComboBox}" Width="150"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="10,0">
                        <TextBlock Text="EXPIRY WARNING" VerticalAlignment="Center" FontSize="10" FontWeight="Bold" Foreground="{StaticResource PrimaryTeal}" Margin="0,0,10,0" Opacity="0.8"/>
                        <TextBox Text="{Binding ExpiryWarningDays}" Style="{StaticResource ToolbarTextBox}" Width="60" Background="#1AFFFFFF" BorderThickness="1" BorderBrush="{StaticResource GlassBorder}"/>
                        <TextBlock Text="DAYS" VerticalAlignment="Center" FontSize="9" Foreground="{StaticResource TextSub}" Margin="8,0,0,0" Opacity="0.6"/>
                    </StackPanel>

                    <StackPanel Grid.Column="5" Orientation="Horizontal">
                        <ToggleButton Command="{Binding FilterExpiringCommand}" Style="{StaticResource ToolbarToggleButton}" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconClock}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="SHOW EXPIRING" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </ToggleButton>
                        <Button Command="{Binding PrintCommand}" Style="{StaticResource ToolbarButton}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPrint}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" Opacity="0.8"/>
                                <TextBlock Text="PRINT" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Grid -->
            <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0" Margin="15,0,20,20" CornerRadius="0">
                <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Employee" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="5">
                                        <Border CornerRadius="12" Width="24" Height="24" Background="{StaticResource PrimaryTeal}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding EmployeeName[0]}" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                        <TextBlock Text="{Binding EmployeeName}" VerticalAlignment="Center" Foreground="White"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Skill / Role" Binding="{Binding Role}" Width="*"/>
                        <DataGridTemplateColumn Header="Expiry Date" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="4" Padding="8,2" Background="{Binding Summary.DateCompleted, Converter={StaticResource ExpiryColorConverter}}" Margin="5">
                                        <TextBlock Text="{Binding ValidUntil, StringFormat='dd MMM yyyy'}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.EditRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconEdit}" Width="14" Height="14" Fill="{StaticResource TextSub}" Stretch="Uniform"/>
                                        </Button>
                                        <Button Style="{StaticResource ToolbarIconButton}" Command="{Binding DataContext.DeleteRecordCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconDelete}" Width="14" Height="14" Fill="{StaticResource ErrorRed}" Stretch="Uniform"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- DRAWER OVERLAY -->
        <Grid x:Name="DrawerOverlay" Grid.RowSpan="3" Visibility="Collapsed">
            <Border x:Name="Dimmer" Background="#80000000" Opacity="0">
                <Border.InputBindings>
                    <MouseBinding MouseAction="LeftClick" Command="{Binding ToggleAddCommand}"/>
                </Border.InputBindings>
            </Border>

            <Border x:Name="DrawerContent" HorizontalAlignment="Right" Width="550" 
                    Background="{StaticResource CardBackground}" BorderBrush="{StaticResource GlassBorderMedium}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform X="600"/>
                </Border.RenderTransform>
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Animations handled by BaseListView -->
                    </Style>
                </Border.Style>

                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,30">
                        <TextBlock Text="Training Record" FontSize="24" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Update employee skills and certifications." FontSize="14" Foreground="{StaticResource TextSub}"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
                        <StackPanel>
                            <TextBlock Text="EMPLOYEE" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding Editor.Employees}" SelectedItem="{Binding Editor.SelectedEmployee}" DisplayMemberPath="DisplayName" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20"/>

                            <TextBlock Text="SKILL / ROLE" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Editor.NewRecord.Role}" Style="{StaticResource ModernInput}" Margin="0,0,0,20"/>

                            <TextBlock Text="CERTIFICATE TYPE" Style="{StaticResource FormLabelText}"/>
                            <ComboBox ItemsSource="{Binding Editor.CertificateTypes}" SelectedItem="{Binding Editor.NewRecord.CertificateType}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,20">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource FriendlyEnumConverter}}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="ISSUE DATE" Style="{StaticResource FormLabelText}"/>
                                    <DatePicker SelectedDate="{Binding Editor.NewRecord.DateCompleted}" Style="{StaticResource ModernDatePicker}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="EXPIRY DATE" Style="{StaticResource FormLabelText}"/>
                                    <DatePicker SelectedDate="{Binding Editor.NewRecord.ValidUntil}" Style="{StaticResource ModernDatePicker}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="TRAINER / PROVIDER" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Editor.NewRecord.Trainer}" Style="{StaticResource ModernInput}" Margin="0,0,0,20"/>

                            <TextBlock Text="CERTIFICATE DOCUMENT" Style="{StaticResource FormLabelText}"/>
                            <Button Command="{Binding Editor.UploadCertificateCommand}" Style="{StaticResource SecondaryButton}" Content="Select File" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>
                            <TextBlock Text="{Binding Editor.CertificateFileName}" Style="{StaticResource LabelText}" Opacity="0.7" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,20,0,0">
                        <Button Style="{StaticResource ActionButtonPrimary}" Command="{Binding Editor.SaveTrainingCommand}" Content="SAVE RECORD" Height="45" Margin="0,0,0,10"/>
                        <Button Style="{StaticResource ActionButtonSecondary}" Command="{Binding ToggleAddCommand}" Content="CANCEL" Height="45"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                <TextBlock Text="Loading Training..." Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</infra:BaseListView>

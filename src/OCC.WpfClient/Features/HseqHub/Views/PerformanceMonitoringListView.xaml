<infra:ListViewBase x:Class="OCC.WpfClient.Features.HseqHub.Views.PerformanceMonitoringListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="15">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource PrimaryTeal}" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBlock Text="Performance Monitoring" Style="{StaticResource HeaderText}"/>
            </StackPanel>
                <TextBlock Text="Safe work hours and incident frequency tracking" Style="{StaticResource LabelText}" Opacity="0.7"/>
        </StackPanel>

        <!-- Toolbar (Redesigned as QuickBooks Toolbar Card) -->
        <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="15,10" Margin="15,0,20,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ══════════════════ QUICKBOOKS TOOLBAR ══════════════════ -->
                <Border Grid.Row="0" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Refresh Button -->
                        <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding LoadDataCommand}" ToolTip="Refresh Data">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource AccentBlue}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Refresh" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="32" Background="#20FFFFFF" VerticalAlignment="Center" Margin="8,0"/>

                        <!-- Print Button -->
                        <Button Style="{StaticResource QuickBooksToolbarButtonStyle}" Command="{Binding PrintCommand}" ToolTip="Print Report">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE749;" Style="{StaticResource SymbolIcon}" FontSize="18" Foreground="{StaticResource SecondaryGold}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <TextBlock Text="Print" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Search Row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="180" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBlock Grid.Column="0" Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource TextSub}" FontSize="14" Margin="5,0,10,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource ToolbarTextBox}"
                             ap:WatermarkProperties.Watermark="Search records..." VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Data Table -->
        <Border Grid.Row="2" Style="{StaticResource GlassCard}" Padding="0" Margin="15,0,20,20" CornerRadius="0">
            <DataGrid ItemsSource="{Binding SafeHours}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Month" Binding="{Binding Month, StringFormat='MMMM yyyy'}" Width="Auto"/>
                    <DataGridTextColumn Header="Safe Hours" Binding="{Binding SafeWorkHours}" Width="Auto"/>
                    <DataGridTextColumn Header="Incidents" Binding="{Binding IncidentReported}" Width="Auto"/>
                    <DataGridTextColumn Header="Near Misses" Binding="{Binding NearMisses}" Width="Auto"/>
                    <DataGridTextColumn Header="Root Cause" Binding="{Binding RootCause}" Width="Auto"/>
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                    <DataGridTextColumn Header="Reported By" Binding="{Binding ReportedBy}" Width="Auto"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Loading Overlay -->
        <Border Grid.RowSpan="3" Visibility="{Binding IsBusy, Converter={StaticResource VisibilityConverter}}" Background="#80000000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,0,0,16"/>
                <TextBlock Text="Loading Performance Data..." Foreground="White"/>
            </StackPanel>
        </Border>
    </Grid>
</infra:ListViewBase>

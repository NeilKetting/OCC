<UserControl x:Class="OCC.WpfClient.Features.HseqHub.Views.DeviationDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.HseqHub.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="700"
             d:DataContext="{d:DesignInstance vm:DeviationDetailViewModel}">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel>
                <TextBlock Text="Deviation Action Sheet" FontSize="24" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="{Binding SelectedAudit.AuditNumber, StringFormat='Audit Ref: {0}'}" FontSize="14" Foreground="{StaticResource TextSub}"/>
            </StackPanel>
            <Button HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource ActionButtonPrimary}" Command="{Binding AddDeviationCommand}" Content="+ ADD ITEM" Height="35"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,20,0">
            <ItemsControl ItemsSource="{Binding Deviations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource GlassCard}" Margin="0,0,0,20" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="REGULATION REFERENCE" Style="{StaticResource FormLabelText}"/>
                                        <TextBox Text="{Binding RegulationReference}" Style="{StaticResource ModernInput}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{Binding StatusColor}" CornerRadius="6" Padding="12,6" VerticalAlignment="Top" Margin="20,0,0,0">
                                        <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </Grid>

                                <TextBlock Text="FINDING / OBSERVATION" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding Description}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,15"/>

                                <TextBlock Text="CORRECTIVE ACTION" Style="{StaticResource FormLabelText}"/>
                                <TextBox Text="{Binding CorrectiveAction}" Style="{StaticResource ModernInput}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60" Margin="0,0,0,20"/>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="TARGET DATE" Style="{StaticResource FormLabelText}"/>
                                        <DatePicker SelectedDate="{Binding TargetDate}" Style="{StaticResource ModernDatePicker}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="STATUS" Style="{StaticResource FormLabelText}"/>
                                        <ComboBox SelectedItem="{Binding Status}" Style="{StaticResource ModernComboBox}">
                                            <ComboBoxItem Content="Open"/>
                                            <ComboBoxItem Content="Rectified"/>
                                            <ComboBoxItem Content="Closed"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <Grid>
                                    <Button Style="{StaticResource ActionButtonSecondary}" Content="UPDATE ITEM" HorizontalAlignment="Right" Height="35"
                                            Command="{Binding DataContext.SaveDeviationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconButtonSmall}" HorizontalAlignment="Left"
                                            Command="{Binding DataContext.DeleteDeviationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="14"/>
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
             <Button Style="{StaticResource ActionButtonPrimary}" Command="{Binding GenerateCloseOutReportCommand}" Content="GENERATE PDF REPORT" Height="45" HorizontalAlignment="Left" Width="200"/>
             <Button Style="{StaticResource CancelButton}" Command="{Binding CloseCommand}" Content="CLOSE SHEET" Height="45" Margin="20,0,0,0" Width="200"/>
        </StackPanel>
    </Grid>
</UserControl>

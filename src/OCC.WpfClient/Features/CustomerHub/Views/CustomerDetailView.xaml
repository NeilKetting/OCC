<UserControl x:Class="OCC.WpfClient.Features.CustomerHub.Views.CustomerDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:OCC.WpfClient.Features.CustomerHub.ViewModels"
             xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
             xmlns:infra="clr-namespace:OCC.WpfClient.Infrastructure.Converters"
             xmlns:utils="clr-namespace:OCC.WpfClient.Infrastructure"
             xmlns:views="clr-namespace:OCC.WpfClient.Features.CustomerHub.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:CustomerDetailViewModel}">

    <UserControl.Resources>
        <infra:VisibilityConverter x:Key="VisibilityConverter" />
        <utils:BindingProxy x:Key="BindingProxy" Data="{Binding}" />

        <DataTemplate DataType="{x:Type vm:CustomerDetailViewModel}">
            <views:CustomerDetailView />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundDark}">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="*"/>    <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Margin="0,0,0,20">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource HeaderText}" FontSize="20"/>
                        <TextBlock Text="Manage clients and key contacts" Style="{StaticResource LabelText}" Opacity="0.7"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Top" 
                            Style="{StaticResource WindowCloseButton}" Command="{Binding CancelCommand}"/>
                </Grid>
            </Border>

            <!-- Scrollable Content -->
            
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-5,0" Padding="0,0,0,0">
                <StackPanel Margin="0,0,20,0">
                    <!-- Section: Customer Info -->
                    <StackPanel Margin="0,0,0,25">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="&#xE946;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource AccentBlue}" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="Customer Information" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource AccentBlue}"/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Customer Name" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Enter customer name..."/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Header Display" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Header, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Optional UI header..."/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email Address" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="primary@email.com"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Phone Number" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="+1 234 567 890"/>
                        </StackPanel>
                        
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Billing Address" Style="{StaticResource FormLabelText}"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" MinHeight="80" Height="Auto" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" ap:WatermarkProperties.Watermark="Full address..."/>
                        </StackPanel>

                        <!-- Customer Logo Upload & Preview -->
                        <StackPanel Margin="0,10,0,12">
                            <TextBlock Text="Customer Logo" Style="{StaticResource FormLabelText}"/>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Logo preview container -->
                                <Border Grid.Column="0" Width="100" Height="100" CornerRadius="8" 
                                        BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" 
                                        Background="#0AFFFFFF" Margin="0,0,15,0" ClipToBounds="True">
                                    <Grid>
                                        <!-- Placeholder when no logo is set -->
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" 
                                                    Visibility="{Binding LogoUrl, Converter={StaticResource VisibilityConverter}, ConverterParameter=Invert}">
                                            <TextBlock Text="" Style="{StaticResource SymbolIcon}" FontSize="24" Foreground="{StaticResource TextSub}" Opacity="0.5" HorizontalAlignment="Center"/>
                                            <TextBlock Text="No Logo" FontSize="10" Foreground="{StaticResource TextSub}" Opacity="0.5" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        
                                        <!-- Image preview when logo is set -->
                                        <Image Source="{Binding FullLogoUrl}" Stretch="Uniform" 
                                               Visibility="{Binding LogoUrl, Converter={StaticResource VisibilityConverter}}"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>
                                
                                <!-- Action Buttons & Instructions -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Command="{Binding UploadLogoCommand}" Style="{StaticResource CreateButton}" 
                                                Content="UPLOAD LOGO" Margin="0,0,8,0"/>
                                        <Button Command="{Binding RemoveLogoCommand}"
                                                Style="{StaticResource CancelButton}"
                                                Content="REMOVE LOGO"
                                                Visibility="{Binding LogoUrl, Converter={StaticResource VisibilityConverter}}"/>
                                    </StackPanel>
                                    <TextBlock Text="Supports PNG, JPG, or JPEG. This logo will display on the generated project status report header." 
                                               FontSize="11" Foreground="{StaticResource TextSub}" TextWrapping="Wrap" Opacity="0.7" LineHeight="15"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- Section: Key Contacts -->
                    <StackPanel Margin="0,0,0,25">
                        <Grid Margin="0,0,0,15">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SuccessGreen}" FontSize="18" Margin="0,0,10,0"/>
                                <TextBlock Text="Key Contacts" Style="{StaticResource SectionHeaderText}" Foreground="{StaticResource SuccessGreen}"/>
                            </StackPanel>
                            
                            <Button HorizontalAlignment="Right" Style="{StaticResource ActionButtonSecondary}" Height="28" Padding="12,0" Command="{Binding AddContactCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="White" FontSize="10" Margin="0,0,6,0"/>
                                    <TextBlock Text="Add Contact" FontSize="11"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <ItemsControl x:Name="ContactsItemsControl" ItemsSource="{Binding Contacts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#10FFFFFF" CornerRadius="8" Padding="15" Margin="0,0,0,12" BorderBrush="#20FFFFFF" BorderThickness="1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            
                                            <Button Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" 
                                                    Style="{StaticResource ToolbarIconButton}" Margin="0,-10,-10,0"
                                                    Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                                <TextBlock Text="" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource ErrorRed}" FontSize="12"/>
                                            </Button>

                                            <StackPanel Grid.Row="1">
                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Name" Style="{StaticResource FormLabelText}" />
                                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Contact name..." />
                                                </StackPanel>

                                                <StackPanel Margin="0,0,0,12">
                                                    <TextBlock Text="Email" Style="{StaticResource FormLabelText}" />
                                                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Email address..." />
                                                </StackPanel>

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="Phone" Style="{StaticResource FormLabelText}" />
                                                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Phone..." />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="Department" Style="{StaticResource FormLabelText}" />
                                                        <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernInput}" ap:WatermarkProperties.Watermark="Dept..." />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <!-- Validation Summary -->
                    <Border Margin="0,0,0,15" Background="#1AEE4444" BorderBrush="{StaticResource ErrorRed}" 
                            BorderThickness="1" CornerRadius="8" Padding="12"
                            Visibility="{Binding HasErrors, Converter={StaticResource VisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding ValidationErrors}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource ErrorRed}" FontSize="12" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Grid>
                        <Button HorizontalAlignment="Left" Style="{StaticResource PrintButton}" Command="{Binding PrintCommand}" />


                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancel" Style="{StaticResource CancelButton}" Command="{Binding CancelCommand}" Width="100" Height="40" Margin="0,0,10,0"/>
                            <Button Content="Save Customer" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Busy Overlay -->
        <Border Background="#CC000000" CornerRadius="12" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{StaticResource AccentBlue}" Background="#20FFFFFF"/>
                <TextBlock Text="{Binding BusyText}" Foreground="White" Margin="0,15,0,0" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>


<Window x:Class="OCC.WpfClient.Dialogs.BankExportDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bank Export" MinHeight="340" Width="550" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False">
    <Border Background="{StaticResource CardBackground}" CornerRadius="10" 
            BorderBrush="{StaticResource GlassBorder}" BorderThickness="1" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.5" />
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                <TextBlock Text="&#xE15C;" Style="{StaticResource SymbolIcon}" Foreground="{StaticResource SecondaryGold}" FontSize="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Export Bank File" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
            
            <!-- Summary Info -->
            <Border Grid.Row="1" Background="#0AFFFFFF" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="TOTAL EMPLOYEES" Style="{StaticResource LabelText}" Opacity="0.6" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTotalPayments" Text="0" Foreground="White" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="TOTAL NET PAY" Style="{StaticResource LabelText}" Opacity="0.6" Margin="0,0,0,4"/>
                        <TextBlock x:Name="TxtTotalAmount" Text="R 0.00" Foreground="{StaticResource OrangeBrush}" FontSize="16" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Inputs -->
            <StackPanel Grid.Row="2" Margin="0,0,0,16">
                <!-- Action Date -->
                <StackPanel Margin="0,0,0,12">
                    <TextBlock Text="PAYMENT ACTION DATE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <DatePicker x:Name="DpActionDate" Style="{StaticResource ModernDatePicker}" HorizontalAlignment="Stretch"/>
                </StackPanel>

                <!-- Bank Format -->
                <StackPanel>
                    <TextBlock Text="BANK EXPORT FORMAT" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CbFormat" Style="{StaticResource ModernComboBox}" HorizontalAlignment="Stretch"/>
                </StackPanel>
            </StackPanel>
            
            <!-- Footer Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Padding="15,5" Height="35" Margin="0,0,10,0" Click="BtnCancel_Click" BorderBrush="{StaticResource ErrorRed}"/>
                <Button x:Name="BtnExport" Content="Export" Style="{StaticResource ActionButtonSecondary}" Padding="25,5" Height="35" Click="BtnExport_Click" BorderBrush="{StaticResource SuccessGreen}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

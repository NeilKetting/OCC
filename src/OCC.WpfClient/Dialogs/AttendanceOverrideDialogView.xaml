<Window x:Class="OCC.WpfClient.Dialogs.AttendanceOverrideDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ap="clr-namespace:OCC.WpfClient.Infrastructure.AttachedProperties"
        mc:Ignorable="d"
        Title="Override Attendance Record" Height="640" Width="620"
        WindowStartupLocation="CenterOwner" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/OCC-ERP;component/Styles/Common.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundDark}" BorderBrush="{StaticResource SecondaryGold}" BorderThickness="1.5" CornerRadius="12" Padding="20,20,30,20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Summary Card -->
                <RowDefinition Height="*"/>    <!-- Override Form Fields -->
                <RowDefinition Height="Auto"/> <!-- Reason Section -->
                <RowDefinition Height="Auto"/> <!-- Live Preview -->
                <RowDefinition Height="Auto"/> <!-- Action Buttons -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#xE70F;" Style="{StaticResource SymbolIcon}" 
                           Foreground="{StaticResource SecondaryGold}" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="OVERRIDE ATTENDANCE RECORD" Style="{StaticResource HeaderText}" FontFamily="{StaticResource MichromaFont}" FontSize="15" Foreground="White"/>
                    <TextBlock Style="{StaticResource LabelText}" Opacity="0.7" FontSize="11" Text="Directly adjust clock times, status, worked hours, or site for this record." Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Click="Cancel_Click" Style="{StaticResource ToolbarIconButton}" ToolTip="Close" Width="30" Height="30" VerticalAlignment="Top">
                    <TextBlock Text="&#xE8BB;" Style="{StaticResource SymbolIcon}" FontSize="14" Foreground="White"/>
                </Button>
            </Grid>

            <!-- 2. Employee Info Card -->
            <Border Grid.Row="1" Style="{StaticResource GlassCard}" Padding="16,12" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="EMPLOYEE" Style="{StaticResource LabelText}" FontSize="10" Opacity="0.6"/>
                        <TextBlock x:Name="EmpNameText" Text="JOHN DOE" FontWeight="Bold" Foreground="White" FontSize="13" Margin="0,2,0,0"/>
                        <TextBlock x:Name="EmpNumberText" Text="BAS-1002" Style="{StaticResource LabelText}" FontSize="10" Foreground="{StaticResource SecondaryGold}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="DATE &amp; BRANCH" Style="{StaticResource LabelText}" FontSize="10" Opacity="0.6"/>
                        <TextBlock x:Name="RecordDateText" Text="2026/08/10" FontWeight="SemiBold" Foreground="White" FontSize="12" Margin="0,2,0,0"/>
                        <TextBlock x:Name="EmpBranchText" Text="Johannesburg" Style="{StaticResource LabelText}" FontSize="10"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                        <TextBlock Text="RECORD HOURS" Style="{StaticResource LabelText}" FontSize="10" Opacity="0.6" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="CurrentHoursText" Text="9.50 hrs" FontWeight="Bold" Foreground="{StaticResource SecondaryGold}" FontSize="14" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Form Fields (Scrollable) -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="0,0,15,0">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="ATTENDANCE &amp; HOURS OVERRIDES" Style="{StaticResource LabelText}" Foreground="{StaticResource AccentBlue}" FontWeight="Bold" Margin="0,0,0,8"/>
                    
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <!-- Status Selection -->
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="ATTENDANCE STATUS" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="StatusInput" Style="{StaticResource ModernComboBox}" SelectionChanged="FieldValue_SelectionChanged">
                                <ComboBoxItem Content="Present"/>
                                <ComboBoxItem Content="Late"/>
                                <ComboBoxItem Content="Leave Early"/>
                                <ComboBoxItem Content="Absent"/>
                                <ComboBoxItem Content="Sick"/>
                                <ComboBoxItem Content="Leave Authorized"/>
                                <ComboBoxItem Content="Unpaid Sick"/>
                                <ComboBoxItem Content="Unpaid Leave"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Project / Site Assignment -->
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="PROJECT / SITE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ProjectSiteInput" Style="{StaticResource ModernInput}" TextChanged="FieldValue_TextChanged"/>
                        </StackPanel>

                        <!-- Clock In Time -->
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="CLOCK IN TIME (HH:mm)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClockInInput" Style="{StaticResource ModernInput}" TextChanged="FieldValue_TextChanged"/>
                        </StackPanel>

                        <!-- Clock Out Time -->
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="CLOCK OUT TIME (HH:mm)" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClockOutInput" Style="{StaticResource ModernInput}" TextChanged="FieldValue_TextChanged"/>
                        </StackPanel>

                        <!-- Total Hours Worked Override -->
                        <StackPanel Margin="0,0,8,8">
                            <TextBlock Text="WORKED HOURS OVERRIDE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="HoursWorkedInput" Style="{StaticResource ModernInput}" TextChanged="FieldValue_TextChanged"/>
                        </StackPanel>

                        <!-- Paid Leave Hours Override -->
                        <StackPanel Margin="8,0,0,8">
                            <TextBlock Text="PAID LEAVE HOURS OVERRIDE" Style="{StaticResource LabelText}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PaidLeaveHoursInput" Style="{StaticResource ModernInput}" TextChanged="FieldValue_TextChanged"/>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- 4. Mandatory Reason -->
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="REASON FOR OVERRIDE" Style="{StaticResource LabelText}" FontWeight="Bold"/>
                    <TextBlock Text=" *" Foreground="#EF4444" FontWeight="Bold"/>
                    <TextBlock Text=" (Appended to record notes)" Style="{StaticResource LabelText}" Opacity="0.6" Margin="4,0,0,0"/>
                </StackPanel>
                <TextBox x:Name="ReasonInput" Style="{StaticResource ModernInput}" Height="54" TextWrapping="Wrap" AcceptsReturn="True"
                         ap:WatermarkProperties.Watermark="Enter justification for override (e.g., Deducted 1h lunch for public holiday / manual supervisor time correction)..."/>
                <TextBlock x:Name="ValidationErrorText" Text="Reason is required to apply attendance record override." Foreground="#EF4444" FontSize="11" Margin="0,4,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 5. Live Net Pay / Hours Preview -->
            <Border Grid.Row="4" Background="#10FFFFFF" BorderBrush="{StaticResource GlassBorderUltraLight}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ORIGINAL HOURS: " Style="{StaticResource LabelText}" Opacity="0.7" FontSize="11"/>
                        <TextBlock x:Name="OriginalHoursText" Text="9.50" FontWeight="Bold" Foreground="White" FontSize="12"/>
                        <TextBlock Text="  ➔  " Foreground="{StaticResource SecondaryGold}" FontSize="12" Margin="6,0"/>
                        <TextBlock Text="NEW WORKED HOURS: " Style="{StaticResource LabelText}" Opacity="0.7" FontSize="11"/>
                        <TextBlock x:Name="NewHoursPreviewText" Text="8.50" FontWeight="Bold" Foreground="{StaticResource SecondaryGold}" FontSize="13"/>
                        <TextBlock x:Name="HoursDiffText" Text=" (-1.00h)" FontWeight="Bold" FontSize="12" Margin="6,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 6. Action Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Click="Cancel_Click" Content="CANCEL" Style="{StaticResource SecondaryButton}" Width="100" Margin="0,0,10,0"/>
                <Button Click="ApplyOverride_Click" Content="APPLY OVERRIDE" Style="{StaticResource PrimaryButton}" Width="140"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

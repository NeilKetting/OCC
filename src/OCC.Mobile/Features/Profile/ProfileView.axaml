<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OCC.Mobile.Features.Profile"
             x:DataType="vm:ProfileViewModel"
             x:Class="OCC.Mobile.Features.Profile.ProfileView">

    <UserControl.Styles>
        <Style Selector="Button.list-item-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.list-item-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#0AFFFFFF"/>
        </Style>
        <Style Selector="Button.list-item-btn:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#15FFFFFF"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer Background="#080E1A">
        <StackPanel Spacing="16" Margin="20">
            
            <!-- Header Section -->
            <Grid ColumnDefinitions="*, Auto" Margin="0,10,0,0">
                <TextBlock Text="My Profile" 
                           Foreground="White" 
                           FontSize="24" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
                
                <Border Grid.Column="1" 
                        Background="#10B9811A" 
                        BorderBrush="#10B98133" 
                        BorderThickness="1" 
                        CornerRadius="16" 
                        Padding="12,6"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="#10B981" VerticalAlignment="Center"/>
                        <TextBlock Text="Online" Foreground="#10B981" FontSize="11" FontWeight="Bold" FontFamily="monospace" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hero Profile Card -->
            <Border CornerRadius="20" BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True" Padding="24">
                <Border.Background>
                    <RadialGradientBrush Center="50%,0%" RadiusX="0.8" RadiusY="0.8">
                        <GradientStop Color="#1D2333" Offset="0" />
                        <GradientStop Color="#0F131F" Offset="1" />
                    </RadialGradientBrush>
                </Border.Background>
                
                <StackPanel Spacing="16" HorizontalAlignment="Stretch">
                    <!-- Avatar Area -->
                    <Grid Width="96" Height="96" HorizontalAlignment="Center">
                        <!-- Gradient Ring -->
                        <Border CornerRadius="48" Padding="3">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#22D3EE" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            
                            <!-- Avatar Inner Fallback -->
                            <Border CornerRadius="45" Background="#0F131F">
                                <TextBlock Text="{Binding Initials}" 
                                           FontSize="28" 
                                           FontWeight="Bold" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center">
                                    <TextBlock.Foreground>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Color="#6366F1" Offset="0"/>
                                            <GradientStop Color="#22D3EE" Offset="1"/>
                                        </LinearGradientBrush>
                                    </TextBlock.Foreground>
                                </TextBlock>
                            </Border>
                        </Border>
                        
                        <!-- Online Status Badge Indicator -->
                        <Border Width="16" Height="16" 
                                CornerRadius="8" 
                                Background="#10B981" 
                                BorderBrush="#0F131F" 
                                BorderThickness="2" 
                                VerticalAlignment="Bottom" 
                                HorizontalAlignment="Right" 
                                Margin="0,0,4,4"/>
                    </Grid>

                    <!-- User Name & Email -->
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding CurrentUser.DisplayName}" 
                                   FontSize="20" 
                                   FontWeight="Bold" 
                                   Foreground="White" 
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentUser.Email}" 
                                   FontSize="13" 
                                   Foreground="#94A3B8" 
                                   FontFamily="monospace" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Role & Location Chips -->
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <!-- Role Badge -->
                        <Border Background="{StaticResource ButtonBrush}" BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Fill="#6366F1" 
                                      Data="M10,2H14A2,2 0 0,1 16,4V6H20A2,2 0 0,1 22,8V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V8A2,2 0 0,1 4,6H8V4A2,2 0 0,1 10,2M14,6V4H10V6H14M4,8V19H20V8H4Z" 
                                      Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentUser.UserRole}" Foreground="#6366F1" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Location Badge -->
                        <Border Background="{StaticResource ButtonBrush}" BorderBrush="{StaticResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Fill="#22D3EE" 
                                      Data="M12,2A7,7 0 0,0 5,9C5,14.25 12,22 12,22C12,22 19,14.25 19,9A7,7 0 0,0 12,2M12,11.5A2.5,2.5 0 0,1 9.5,9A2.5,2.5 0 0,1 12,6.5A2.5,2.5 0 0,1 14.5,9A2.5,2.5 0 0,1 12,11.5Z" 
                                      Stretch="Uniform" Width="11" Height="11" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LocationDisplay}" Foreground="#22D3EE" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Stats Row -->
            <Grid ColumnDefinitions="*, *, *">
                <!-- Stat Tile: Done Today -->
                <Border Grid.Column="0" Margin="0,0,4,0" CornerRadius="16" Background="#0F131F" BorderBrush="#1E293B" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding DoneTodayCount}" FontSize="24" FontWeight="Bold" Foreground="#10B981" HorizontalAlignment="Center" FontFamily="monospace"/>
                        <TextBlock Text="DONE TODAY" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Stat Tile: Projects -->
                <Border Grid.Column="1" Margin="4,0,4,0" CornerRadius="16" Background="#0F131F" BorderBrush="#1E293B" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ProjectsCount}" FontSize="24" FontWeight="Bold" Foreground="#6366F1" HorizontalAlignment="Center" FontFamily="monospace"/>
                        <TextBlock Text="PROJECTS" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Stat Tile: Tasks Total -->
                <Border Grid.Column="2" Margin="4,0,0,0" CornerRadius="16" Background="#0F131F" BorderBrush="#1E293B" BorderThickness="1" Padding="12">
                    <StackPanel Spacing="4" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding TasksTotalCount}" FontSize="24" FontWeight="Bold" Foreground="#22D3EE" HorizontalAlignment="Center" FontFamily="monospace"/>
                        <TextBlock Text="TASKS TOTAL" FontSize="9" FontWeight="Bold" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Account Details Card -->
            <StackPanel Spacing="6">
                <TextBlock Text="ACCOUNT" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="4,10,0,0"/>
                
                <Border CornerRadius="16" Background="#0F131F" BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True">
                    <StackPanel>
                        <!-- Full Name Info Row -->
                        <Border Padding="16,12">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#6366F1" 
                                          Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" 
                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="FULL NAME" FontSize="9" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CurrentUser.DisplayName}" FontSize="14" Foreground="White" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#1E293B" Margin="16,0"/>

                        <!-- Email Info Row -->
                        <Border Padding="16,12">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#6366F1" 
                                          Data="M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4M20,8L12,13L4,8V6L12,11L20,6V8Z" 
                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="EMAIL ADDRESS" FontSize="9" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CurrentUser.Email}" FontSize="14" Foreground="White" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Height="1" Background="#1E293B" Margin="16,0"/>

                        <!-- Role Info Row -->
                        <Border Padding="16,12">
                            <Grid ColumnDefinitions="Auto, *">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#6366F1" 
                                          Data="M10,2H14A2,2 0 0,1 16,4V6H20A2,2 0 0,1 22,8V19A2,2 0 0,1 20,21H4A2,2 0 0,1 2,19V8A2,2 0 0,1 4,6H8V4A2,2 0 0,1 10,2M14,6V4H10V6H14M4,8V19H20V8H4Z" 
                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ACCOUNT ROLE" FontSize="9" Foreground="#94A3B8" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding CurrentUser.UserRole}" FontSize="14" Foreground="#6366F1" FontWeight="Bold" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- App Settings Card -->
            <StackPanel Spacing="6">
                <TextBlock Text="SETTINGS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="4,10,0,0"/>
                
                <Border CornerRadius="16" Background="#0F131F" BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True">
                    <StackPanel>
                        <!-- Notifications Row -->
                        <Button Classes="list-item-btn">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#6366F1" 
                                          Data="M12,2A3,3 0 0,0 9,5V5.68C6.67,6.4 5,8.5 5,11V17L3,19V20H21V19L19,17V11C19,8.5 17.33,6.4 15,5.68V5A3,3 0 0,0 12,2M11,21A2,2 0 0,0 13,21M19,17H5V11C5,7.13 8.13,4 12,4C15.87,4 19,7.13 19,11V17Z" 
                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Notifications" FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="Task reminders and alerts" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Path Grid.Column="2" Fill="#94A3B8" Opacity="0.4"
                                      Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Border Height="1" Background="#1E293B" Margin="16,0"/>

                        <!-- Security Row -->
                        <Button Classes="list-item-btn">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#22D3EE" 
                                          Data="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,5A3,3 0 0,1 15,8A3,3 0 0,1 12,11A3,3 0 0,1 9,8A3,3 0 0,1 12,5M17.13,17C15.92,18.85 14.11,20.24 12,20.92C9.89,20.24 8.08,18.85 6.87,17C6.53,16.5 6.24,16 6,15.47C6,13.47 10,12.33 12,12.33C14,12.33 18,13.47 18,15.47C17.76,16 17.47,16.5 17.13,17Z" 
                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Security" FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="Password and authentication" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Path Grid.Column="2" Fill="#94A3B8" Opacity="0.4"
                                      Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>

                        <Border Height="1" Background="#1E293B" Margin="16,0"/>

                        <!-- Support Row -->
                        <Button Classes="list-item-btn">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="#64748B" 
                                          Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,16.5A1.25,1.25 0 1,1 13.25,15.25A1.25,1.25 0 0,1 12,16.5M13,13.25V14H11V12H12A1.5,1.5 0 0,0 13.5,10.5A1.5,1.5 0 0,0 12,9A1.5,1.5 0 0,0 10.5,10.5H8.5A3.5,3.5 0 0,1 12,7A3.5,3.5 0 0,1 15.5,10.5A3.5,3.5 0 0,1 13,13.25Z" 
                                          Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Help &amp; Support" FontSize="14" Foreground="White" FontWeight="SemiBold"/>
                                    <TextBlock Text="FAQs and contact support" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Path Grid.Column="2" Fill="#94A3B8" Opacity="0.4"
                                      Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                      Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- App section (Updates and Info) -->
            <StackPanel Spacing="6">
                <TextBlock Text="APP" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="4,10,0,0"/>
                
                <Border CornerRadius="16" Background="#0F131F" BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True">
                    <!-- Check for Updates Row -->
                    <Button Classes="list-item-btn" Command="{Binding CheckForUpdatesCommand}">
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" VerticalAlignment="Center">
                                <Path Fill="#10B981" 
                                      Data="M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12C18,14.24 16.77,16.19 14.95,17.24L16.41,18.7C18.62,17.2 20,14.76 20,12A8,8 0 0,0 12,4M12,18A6,6 0 0,1 6,12C6,9.76 7.23,7.81 9.05,6.76L7.59,5.3C5.38,6.8 4,9.24 4,12A8,8 0 0,0 12,20V23L16,19L12,15V18Z" 
                                      Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Check for Updates" FontSize="14" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AppVersion, FallbackValue=1.0.20, StringFormat='{}Version {0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="2" Fill="#94A3B8" Opacity="0.4"
                                  Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                                  Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                </Border>
            </StackPanel>

            <!-- Log Out Card -->
            <Border CornerRadius="16" Background="#0F131F" BorderBrush="#1E293B" BorderThickness="1" ClipToBounds="True" Margin="0,10,0,0">
                <Button Classes="list-item-btn" Command="{Binding LogoutCommand}">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Border Width="36" Height="36" CornerRadius="8" Background="{StaticResource ButtonBrush}" Margin="0,0,16,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Fill="#EF4444" 
                                  Data="M14,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H14A2,2 0 0,0 16,19V16H14V19H5V5H14V8H16V5C16,3.89 15.1,3 14,3M19,16V13H10V11H19V8L24,12L19,16Z" 
                                  Stretch="Uniform" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Log Out" FontSize="14" Foreground="#EF4444" FontWeight="Bold" VerticalAlignment="Center"/>
                        <Path Grid.Column="2" Fill="#EF4444" Opacity="0.4"
                              Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" 
                              Stretch="Uniform" Width="16" Height="16" VerticalAlignment="Center"/>
                    </Grid>
                </Button>
            </Border>

            <!-- Version Footer -->
            <TextBlock Text="{Binding AppVersion, StringFormat='{}OCC Mobile v{0} · Orange Circle Construction'}" 
                       FontSize="11" 
                       Foreground="#94A3B8" 
                       Opacity="0.4" 
                       FontFamily="monospace" 
                       HorizontalAlignment="Center" 
                       Margin="0,10,0,10"/>
            
        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OCC.Mobile.Features.Tasks"
             xmlns:models="clr-namespace:OCC.Shared.Models;assembly=OCC.Shared"
             x:DataType="vm:RedesignTasksViewModel"
             x:Class="OCC.Mobile.Features.Tasks.RedesignTasksView">

    <Grid RowDefinitions="Auto, Auto, *" Background="#070D1C">
        <!-- Header -->
        <Border Grid.Row="0" Background="#070D1C" Padding="20">
            <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                <!-- Back Button -->
                <Button Grid.Column="0" Command="{Binding GoBackCommand}" Classes="Nav">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Fill="#E4E8FF" Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z" Stretch="Uniform" Height="15"/>
                        <TextBlock Text="Back" Foreground="#E4E8FF" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Screen Title -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Text="{Binding Title}" Foreground="#E4E8FF" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="{Binding CompletedTasksCount, StringFormat='{}{0} of '}" Foreground="#6B77A4" FontSize="11" FontWeight="Medium">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} of {1} complete">
                                <Binding Path="CompletedTasksCount"/>
                                <Binding Path="TotalTasksCount"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <!-- Progress Pill -->
                <Border Grid.Column="2" Background="#0D1528" BorderBrush="#246366F1" BorderThickness="1" CornerRadius="20" Padding="12,6" Margin="0,0,15,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Grid Width="60" Height="6" Background="#111929" ClipToBounds="True">
                            <!-- Inverted container or custom rounded border for progress track -->
                            <Border CornerRadius="3" Background="#1AFFFFFF">
                                <ProgressBar Value="{Binding OverallProgressPercentage}" Minimum="0" Maximum="100" Height="6" Background="Transparent" Foreground="#22D3EE"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{Binding OverallProgressPercentage, StringFormat='{}{0:0}%'}" Foreground="#E4E8FF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- Refresh Button -->
                <Button Grid.Column="3" Command="{Binding LoadDataCommand}" Classes="Nav">
                    <Path Fill="#E4E8FF" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Stretch="Uniform" Width="20" Height="20"/>
                </Button>
            </Grid>
        </Border>

        <!-- Search & Filters -->
        <Border Grid.Row="1" Background="#070D1C" Padding="20,0,20,20">
            <StackPanel Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBox Text="{Binding SearchText}" PlaceholderText="Search tasks..." Height="42" Background="#99131D35" BorderBrush="#246366F1" BorderThickness="1" CornerRadius="12" Foreground="#E4E8FF">
                        <TextBox.InnerLeftContent>
                            <Path Fill="#6B77A4" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L19.71,19L18.29,20.41L13.01,15.14C11.87,16.11 10.39,16.7 8.5,16.7C4.91,16.7 2,13.79 2,10.2C2,6.61 4.91,3.7 8.5,3.7C8.84,3.7 9.17,3.73 9.5,3.7M8.5,5.7C6,5.7 4,7.7 4,10.2C4,12.7 6,14.7 8.5,14.7C11,14.7 13,12.7 13,10.2C13,7.7 11,5.7 8.5,5.7Z" Width="18" Height="18" Margin="10,0,0,0"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <Button Grid.Column="1" Command="{Binding ToggleFiltersCommand}" Margin="10,0,0,0" Width="42" Height="42" CornerRadius="12" Background="#99131D35" BorderBrush="#246366F1" BorderThickness="1">
                        <Path Fill="#6B77A4" Data="M3,6H21V8H3V6M7,11H17V13H7V11M10,16H14V18H10V16Z" Stretch="Uniform" Width="18" Height="18"/>
                    </Button>
                </Grid>

                <!-- Filter Chips slide down -->
                <Grid IsVisible="{Binding ShowFilters}" ColumnDefinitions="*, Auto" Margin="0,5,0,0">
                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox IsChecked="{Binding ShowOverdueOnly}" Content="Overdue" Classes="chip"/>
                            <CheckBox IsChecked="{Binding ShowDueTodayOnly}" Content="Today" Classes="chip"/>
                            <CheckBox IsChecked="{Binding ShowDueThisWeekOnly}" Content="This Week" Classes="chip"/>
                            <CheckBox IsChecked="{Binding ShowOnHoldOnly}" Content="On Hold" Classes="chip"/>
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Button Content="Expand All" Command="{Binding ExpandAllCommand}" Background="Transparent" Foreground="#6366F1" FontSize="12" FontWeight="SemiBold"/>
                        <Button Content="Collapse All" Command="{Binding CollapseAllCommand}" Background="Transparent" Foreground="#6366F1" FontSize="12" FontWeight="SemiBold"/>
                        <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Background="Transparent" Foreground="#FF8F00" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Main Body List of Projects -->
        <ScrollViewer Grid.Row="2" Background="#070D1C">
            <ItemsControl ItemsSource="{Binding ProjectGroups}" Margin="20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProjectGroupViewModel">
                        <StackPanel Spacing="10" Margin="0,0,0,20">
                            
                            <!-- Project Header Row -->
                            <Button HorizontalAlignment="Stretch" Padding="15" CornerRadius="16" Background="#99131D35" BorderBrush="#246366F1" BorderThickness="1" Command="{Binding ToggleExpandCommand}">
                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                    <!-- Chevron Rotate Animation -->
                                    <Path Grid.Column="0" Fill="#6B77A4" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform" Margin="5,0,15,0"
                                          Data="{Binding IsExpanded, Converter={StaticResource BoolToPathDataConverter}, ConverterParameter='M7,10L12,15L17,10H7Z|M10,17L15,12L10,7V17Z'}"/>

                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="{Binding Title}" Foreground="#E4E8FF" FontSize="16" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Border Background="{Binding Status, Converter={StaticResource StatusToColorConverter}, ConverterParameter='Bg'}"
                                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToColorConverter}, ConverterParameter='Border'}"
                                                    BorderThickness="1" CornerRadius="10" Padding="8,2">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Ellipse Width="6" Height="6" Fill="{Binding Status, Converter={StaticResource StatusToColorConverter}}" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" FontSize="10" FontWeight="Bold"/>
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding CompletedTasks, StringFormat='{}{0}/'}" Foreground="#6B77A4" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}/{1} tasks">
                                                        <Binding Path="CompletedTasks"/>
                                                        <Binding Path="TotalTasks"/>
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Mini Radial Progress Arc -->
                                    <Grid Grid.Column="2" Width="64" Height="64" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Ellipse Width="56" Height="56" Stroke="#10FFFFFF" StrokeThickness="4.5"/>
                                        <Arc Width="56" Height="56" StrokeThickness="4.5" StartAngle="-90" SweepAngle="{Binding ProgressAngle}" StrokeJoin="Round" StrokeLineCap="Round">
                                            <Arc.Stroke>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Offset="0" Color="#6366F1"/>
                                                    <GradientStop Offset="1" Color="#22D3EE"/>
                                                </LinearGradientBrush>
                                            </Arc.Stroke>
                                        </Arc>
                                        <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0:0}%'}" Foreground="White" FontSize="13" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Consolas"/>
                                    </Grid>

                                    <Path Grid.Column="3" Fill="#6B77A4" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Stretch="Uniform" Width="20" Height="20" VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <!-- Sections Under Project (Connected with vertical visual line) -->
                            <Border IsVisible="{Binding IsExpanded}" BorderBrush="#336366F1" BorderThickness="1.5,0,0,0" Margin="24,5,0,10" Padding="12,0,0,0">
                                <ItemsControl ItemsSource="{Binding Sections}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SectionBlockViewModel">
                                        <StackPanel Spacing="8" Margin="0,0,0,15">
                                            
                                            <!-- Section Header Row -->
                                            <Button HorizontalAlignment="Stretch" Background="Transparent" Padding="5" Command="{Binding ToggleExpandCommand}">
                                                <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                                    <Path Grid.Column="0" Fill="#64748B" Width="10" Height="10" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform" Margin="0,0,10,0"
                                                          Data="{Binding IsExpanded, Converter={StaticResource BoolToPathDataConverter}, ConverterParameter='M7,10L12,15L17,10H7Z|M10,17L15,12L10,7V17Z'}"/>

                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="#6B77A4" FontSize="11" FontWeight="ExtraBold" LetterSpacing="1" VerticalAlignment="Center"/>
                                                    
                                                    <TextBlock Grid.Column="2" Text="{Binding TotalTasks, StringFormat='{}{0} tasks'}" Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                    
                                                    <Border Grid.Column="3" Background="{Binding Status, Converter={StaticResource StatusToColorConverter}, ConverterParameter='Bg'}"
                                                            BorderBrush="{Binding Status, Converter={StaticResource StatusToColorConverter}, ConverterParameter='Border'}"
                                                            BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Status}" Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}" FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                </Grid>
                                            </Button>

                                            <!-- Tasks Under Section Grouped inside a single Card Container -->
                                            <Border IsVisible="{Binding IsExpanded}" Margin="12,4,12,12" Background="#0D1528" BorderBrush="#246366F1" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                                <ItemsControl ItemsSource="{Binding Tasks}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:RedesignTaskRowViewModel">
                                                            <StackPanel>
                                                                
                                                                <!-- Individual Task Summary Row Button -->
                                                                <Button Classes="task-row-btn" Command="{Binding ToggleExpandCommand}" HorizontalAlignment="Stretch">
                                                                    <Grid ColumnDefinitions="Auto, *, Auto">
                                                                        <!-- Left Accent Line matching status color -->
                                                                        <Border Grid.Column="0" Background="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}}" Width="3.5" CornerRadius="1.75" VerticalAlignment="Stretch" Margin="0,0,12,0"/>

                                                                        <StackPanel Grid.Column="1" Spacing="6">
                                                                            <TextBlock Text="{Binding Task.Name}" Foreground="#E4E8FF" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                                            
                                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                                <!-- Status Badge Pill -->
                                                                                <Border Background="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}, ConverterParameter='Bg'}"
                                                                                        BorderBrush="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}, ConverterParameter='Border'}"
                                                                                        BorderThickness="1" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                                        <Ellipse Width="6" Height="6" Fill="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}}" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                                <TextBlock Text="{Binding Task.FinishDate, StringFormat='Due {0:MMM dd}'}" Foreground="#6B77A4" FontSize="11" FontWeight="Medium" VerticalAlignment="Center"/>
                                                                            </StackPanel>

                                                                            <Grid ColumnDefinitions="*, Auto" Margin="0,2,0,0">
                                                                                <Border CornerRadius="3" ClipToBounds="True" Height="6" Background="#111929" BorderBrush="#1A6366F1" BorderThickness="1">
                                                                                    <ProgressBar Value="{Binding EditProgress}" Minimum="0" Maximum="100" Height="4" Background="Transparent" Foreground="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}}"/>
                                                                                </Border>
                                                                                <TextBlock Grid.Column="1" Text="{Binding EditProgress, StringFormat='{}{0}%'}" Foreground="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}}" FontSize="10" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" FontFamily="Consolas"/>
                                                                            </Grid>
                                                                        </StackPanel>

                                                                        <Path Grid.Column="2" Fill="#6B77A4" Margin="10,0,5,0" Width="14" Height="14" VerticalAlignment="Center" HorizontalAlignment="Center" Stretch="Uniform"
                                                                              Data="{Binding IsExpanded, Converter={StaticResource BoolToPathDataConverter}, ConverterParameter='M7,10L12,15L17,10H7Z|M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z'}"/>
                                                                    </Grid>
                                                                </Button>

                                                                 <!-- Inline Detail Panel (Slide/Fade In) -->
                                                                 <Border x:Name="DetailPanel" IsVisible="{Binding IsExpanded}" Margin="16,0,16,12" BorderBrush="#406366F1" BorderThickness="1" CornerRadius="12" Padding="16">
                                                                     <Border.Background>
                                                                         <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                                                                             <GradientStop Offset="0" Color="#0D6366F1"/>
                                                                             <GradientStop Offset="1" Color="#006366F1"/>
                                                                         </LinearGradientBrush>
                                                                     </Border.Background>
                                                                     <StackPanel Spacing="16">
                                                                         
                                                                         <!-- Context Header -->
                                                                         <StackPanel Spacing="3">
                                                                             <TextBlock Text="UPDATE TASK" Foreground="#6366F1" FontSize="10" FontWeight="ExtraBold" LetterSpacing="1"/>
                                                                             <TextBlock Text="{Binding Task.Name}" Foreground="#E4E8FF" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                                                             <TextBlock Text="{Binding ProjectTitle, StringFormat='Site: {0}'}" Foreground="#6B77A4" FontSize="11" FontWeight="Medium" FontFamily="Consolas"/>
                                                                         </StackPanel>

                                                                         <Separator Height="1" Background="#1DFFFFFF"/>

                                                                         <!-- Status selector -->
                                                                         <StackPanel Spacing="8">
                                                                             <TextBlock Text="STATUS" Foreground="#6B77A4" FontSize="10" FontWeight="ExtraBold" LetterSpacing="0.5"/>
                                                                             <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
                                                                                 <!-- RadioButton Chips styled dynamically -->
                                                                                 <RadioButton Classes="status-chip" Content="Not Started" GroupName="{Binding Task.Id, StringFormat='status_{0}'}" IsChecked="{Binding EditStatus, Converter={StaticResource EqualityConverter}, ConverterParameter='Not Started', Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Not Started" Margin="0,0,6,6"/>
                                                                                 <RadioButton Classes="status-chip" Content="Started" GroupName="{Binding Task.Id, StringFormat='status_{0}'}" IsChecked="{Binding EditStatus, Converter={StaticResource EqualityConverter}, ConverterParameter='Started', Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Started" Margin="0,0,6,6"/>
                                                                                 <RadioButton Classes="status-chip" Content="Halfway" GroupName="{Binding Task.Id, StringFormat='status_{0}'}" IsChecked="{Binding EditStatus, Converter={StaticResource EqualityConverter}, ConverterParameter='Halfway', Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Halfway" Margin="0,0,6,6"/>
                                                                                 <RadioButton Classes="status-chip" Content="Almost Done" GroupName="{Binding Task.Id, StringFormat='status_{0}'}" IsChecked="{Binding EditStatus, Converter={StaticResource EqualityConverter}, ConverterParameter='Almost Done', Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Almost Done" Margin="0,0,6,6"/>
                                                                                 <RadioButton Classes="status-chip" Content="Completed" GroupName="{Binding Task.Id, StringFormat='status_{0}'}" IsChecked="{Binding EditStatus, Converter={StaticResource EqualityConverter}, ConverterParameter='Completed', Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="Completed" Margin="0,0,6,6"/>
                                                                                 <RadioButton Classes="status-chip" Content="On Hold" IsVisible="{Binding IsOnHoldVisible}" GroupName="{Binding Task.Id, StringFormat='status_{0}'}" IsChecked="{Binding EditStatus, Converter={StaticResource EqualityConverter}, ConverterParameter='On Hold', Mode=OneWay}" Command="{Binding SetStatusCommand}" CommandParameter="On Hold" Margin="0,0,6,6"/>
                                                                             </WrapPanel>
                                                                         </StackPanel>

                                                                         <!-- Hold Reason (visible only when status is "On Hold") -->
                                                                         <StackPanel Spacing="8" IsVisible="{Binding EditStatus, Converter={StaticResource EqualityConverter}, ConverterParameter='On Hold'}">
                                                                             <TextBlock Text="REASON FOR HOLD" Foreground="#EF4444" FontSize="10" FontWeight="ExtraBold" LetterSpacing="0.5"/>
                                                                             <TextBox Text="{Binding EditHoldReason}" PlaceholderText="Explain why this task is on hold..." Height="42" Padding="12" CornerRadius="10" FontSize="13" Background="#111929" BorderBrush="#EF4444" Foreground="#E4E8FF"/>
                                                                         </StackPanel>

                                                                         <!-- Progress Indicator -->
                                                                         <StackPanel Spacing="8">
                                                                             <Grid ColumnDefinitions="*, Auto">
                                                                                 <TextBlock Grid.Column="0" Text="PROGRESS" Foreground="#6B77A4" FontSize="10" FontWeight="ExtraBold" LetterSpacing="0.5"/>
                                                                                 <TextBlock Grid.Column="1" Text="{Binding EditProgress, StringFormat='{}{0}%'}" Foreground="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}}" FontSize="13" FontWeight="Bold" FontFamily="Consolas"/>
                                                                             </Grid>
                                                                             
                                                                             <Border Height="6" Background="#111929" BorderBrush="#246366F1" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                                                                                 <ProgressBar Value="{Binding EditProgress}" Minimum="0" Maximum="100" Height="4" Background="Transparent" Foreground="{Binding DisplayStatus, Converter={StaticResource StatusToColorConverter}}"/>
                                                                             </Border>
                                                                         </StackPanel>

                                                                         <!-- Photo attachments -->
                                                                         <StackPanel Spacing="8">
                                                                             <TextBlock Text="PHOTOS (optional)" Foreground="#6B77A4" FontSize="10" FontWeight="ExtraBold" LetterSpacing="0.5"/>
                                                                             
                                                                             <!-- List of attached photos with their descriptions -->
                                                                             <ItemsControl ItemsSource="{Binding AttachedPhotos}">
                                                                                 <ItemsControl.ItemTemplate>
                                                                                     <DataTemplate x:DataType="vm:AttachedPhotoViewModel">
                                                                                         <Border Background="#0D1528" BorderBrush="#246366F1" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                                                                             <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto">
                                                                                                 <!-- Header Row with Filename and Remove button -->
                                                                                                 <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                                     <TextBlock Text="📸" FontSize="16" VerticalAlignment="Center"/>
                                                                                                     <TextBlock Text="{Binding FileName}" Foreground="#E4E8FF" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                                                                 </StackPanel>
                                                                                                 
                                                                                                 <Button Grid.Row="0" Grid.Column="1" Command="{Binding #DetailPanel.((vm:RedesignTaskRowViewModel)DataContext).RemovePhotoCommand}" CommandParameter="{Binding}" Background="Transparent" Padding="0" VerticalAlignment="Center">
                                                                                                     <Path Fill="#EF4444" Data="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z" Stretch="Uniform" Width="14" Height="14"/>
                                                                                                 </Button>
                                                                                                 
                                                                                                 <!-- Photo-specific description textbox -->
                                                                                                 <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Description}" PlaceholderText="Describe this photo (belongs to this photo)..." FontSize="12" Margin="0,8,0,0" Padding="10,8" CornerRadius="8" Background="#111929" BorderBrush="#1A6366F1" Foreground="#E4E8FF"/>
                                                                                             </Grid>
                                                                                         </Border>
                                                                                     </DataTemplate>
                                                                                 </ItemsControl.ItemTemplate>
                                                                             </ItemsControl>

                                                                             <!-- Upload picker button -->
                                                                             <Button Command="{Binding AttachPhotoCommand}" CommandParameter="{Binding $self}" HorizontalAlignment="Stretch" Padding="12" CornerRadius="10" Background="Transparent" BorderBrush="#246366F1" BorderThickness="1">
                                                                                 <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                                                                     <!-- Camera Icon -->
                                                                                     <Path Fill="#6B77A4" Data="M4,4H7L9,2H15L17,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M12,7A5,5 0 0,0 7,12A5,5 0 0,0 12,17A5,5 0 0,0 17,12A5,5 0 0,0 12,7M12,9A3,3 0 0,1 15,12A3,3 0 0,1 12,15A3,3 0 0,1 9,12A3,3 0 0,1 12,9Z" Stretch="Uniform" Width="16" Height="16"/>
                                                                                     <TextBlock Text="Attach a photo" Foreground="#6B77A4" FontSize="13" FontWeight="SemiBold"/>
                                                                                 </StackPanel>
                                                                             </Button>
                                                                         </StackPanel>

                                                                         <!-- Comment -->
                                                                         <StackPanel Spacing="8">
                                                                             <TextBlock Text="COMMENT (optional)" Foreground="#6B77A4" FontSize="10" FontWeight="ExtraBold" LetterSpacing="0.5"/>
                                                                             <TextBox Text="{Binding EditComment}" PlaceholderText="Add a comment..." AcceptsReturn="True" Height="70" Padding="12" CornerRadius="10" FontSize="13" Background="#111929" BorderBrush="#246366F1" Foreground="#E4E8FF"/>
                                                                         </StackPanel>

                                                                         <!-- Save button -->
                                                                         <Button Command="{Binding SaveUpdateCommand}" HorizontalAlignment="Stretch" Height="44" CornerRadius="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                                                 Background="{Binding IsSaved, Converter={StaticResource BoolToBrushConverter}, ConverterParameter='#10B981|#6366F1'}"
                                                                                 Foreground="White">
                                                                             <Grid>
                                                                                 <!-- Progress bar loading state -->
                                                                                 <StackPanel IsVisible="{Binding IsSaving}" Orientation="Horizontal" Spacing="8">
                                                                                     <ProgressBar IsIndeterminate="True" Width="20" Height="2" Foreground="White"/>
                                                                                     <TextBlock Text="Saving Update..." Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                                                 </StackPanel>
                                                                                 
                                                                                 <!-- Saved State -->
                                                                                 <StackPanel IsVisible="{Binding IsSaved}" Orientation="Horizontal" Spacing="8">
                                                                                     <Path Fill="White" Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Stretch="Uniform" Width="16" Height="16"/>
                                                                                     <TextBlock Text="Saved Successfully" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                                                 </StackPanel>

                                                                                 <!-- Standard State -->
                                                                                 <StackPanel IsVisible="{Binding ShowStandardSaveState}" Orientation="Horizontal" Spacing="8">
                                                                                     <Path Fill="White" Data="M2,21L23,12L2,3V10L17,12L2,14V21Z" Stretch="Uniform" Width="14" Height="14"/>
                                                                                     <TextBlock Text="Save Update" Foreground="White" FontSize="14" FontWeight="Bold"/>
                                                                                 </StackPanel>
                                                                             </Grid>
                                                                         </Button>
                                                                     </StackPanel>
                                                                 </Border>
                                                            <!-- Bottom separator line between task rows -->
                                                            <Border Height="1" Background="#246366F1" IsVisible="{Binding !IsLast}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Loading Overlay (Busy indicator) -->
        <Border Grid.Row="2" Background="#AA000000" IsVisible="{Binding IsBusy}" IsHitTestVisible="True">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="{DynamicResource BrandOrangeBrush}" Background="#334155"/>
                <TextBlock Text="Syncing Tasks..." Foreground="White" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

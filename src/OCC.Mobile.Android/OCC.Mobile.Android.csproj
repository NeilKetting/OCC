<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <ApplicationId>OrangeCircleConstruction.Mobile.Fresh</ApplicationId>
    <ApplicationVersion>18</ApplicationVersion>
    <ApplicationDisplayVersion>1.0.18</ApplicationDisplayVersion>
    <Version>1.0.18</Version>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <!-- Modern AOT and runtime settings -->
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <!-- Shared Signing Keystore - Guarantees identical APK signature across Desktop, Laptop, and CI/CD -->
    <AndroidKeyStore>true</AndroidKeyStore>
    <AndroidSigningKeyStore>occ_mobile.keystore</AndroidSigningKeyStore>
    <AndroidSigningStorePass>OrangeCircle2026!</AndroidSigningStorePass>
    <AndroidSigningKeyAlias>occ_mobile</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>OrangeCircle2026!</AndroidSigningKeyPass>
  </PropertyGroup>

  <!-- Stable Build Settings (Reverted from Optimizations) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidUseSharedRuntime>false</AndroidUseSharedRuntime>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidLinkMode>None</AndroidLinkMode>
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>
    <AndroidEnableFastDeployment>false</AndroidEnableFastDeployment>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" VersionOverride="12.0.1" />
    <PackageReference Include="Xamarin.Google.Android.Material" />
    <PackageReference Include="SkiaSharp.NativeAssets.Android" />
    <PackageReference Include="Xamarin.Firebase.Messaging" />
  </ItemGroup>

  <ItemGroup>
    <GoogleServicesJson Include="google-services.json" />
  </ItemGroup>


  <ItemGroup>
    <ProjectReference Include="..\OCC.Mobile\OCC.Mobile.csproj" />
  </ItemGroup>
</Project>

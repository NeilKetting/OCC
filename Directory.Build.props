<Project>
  <PropertyGroup>
    <!-- Resolve MSB4019 by preventing the SDK from failing on missing iOS workloads 
         when building projects that don't target iOS/Android explicitly. -->
    <ImportWorkloads Condition="'$(TargetFramework)' != 'net9.0-android' AND '$(TargetFramework)' != 'net9.0-ios' AND '$(TargetFramework)' != 'net10.0-android' AND '$(TargetFramework)' != 'net10.0-ios'">false</ImportWorkloads>

    <AndroidSdkDirectory Condition="'$(AndroidSdkDirectory)' == ''">C:\Users\Neil\AppData\Local\Android\Sdk</AndroidSdkDirectory>
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == ''">C:\Program Files\Java\jdk-21</JavaSdkDirectory>
    <SkipWorkloadIntegrityCheck>true</SkipWorkloadIntegrityCheck>
    <NoWarn>$(NoWarn);NU1901;NU1902;NU1903;NU1904;CS8618;XA0141</NoWarn>
  </PropertyGroup>
</Project>
